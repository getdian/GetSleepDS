# 复制为 .env 后填写。不要把 .env 提交到仓库。

# ===== 数据库（compose 必填）=====
# 建议只用字母数字，密码里的特殊字符会破坏 DATABASE_URL
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=sleep
POSTGRES_USER=sleep

# ===== 微信小程序（生产必填）=====
WX_APPID=wx378b0a7437d60998
WX_SECRET=
# 一次性订阅消息模板 ID（结束入睡提醒）；模板字段需为 thing1/time2
# WX_REMINDER_TEMPLATE_ID=

# ===== 可选 =====
PORT=3000
# 宿主机端口映射（给 1Panel 反向代理使用，默认 3000；多站点如遇冲突可指定为 3004 等）
HOST_PORT=3000
UNLOCK_TTL_HOURS=24
# 流量主开通后填激励视频广告位 ID；留空则客户端直接解锁
AD_UNIT_ID=

# 本地开发：无 PostgreSQL 时用内存库（重启即丢）
# DB_MODE=memory
# 本地开发：跳过微信 code2session（生产会被服务端强制拒绝）
# ALLOW_DEV_LOGIN=1
# 直连已有数据库时用
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/sleep

# ===== 后台管理（/admin）=====
# 不设置时会生成临时密码并打印在启动日志里；生产必须显式设置
ADMIN_PASSWORD=
# 可选：会话签名密钥，不设置则用密码本身
# ADMIN_SECRET=

# 可选：COS 凭证加密密钥。不设置则用 ADMIN_PASSWORD/ADMIN_SECRET 派生；
# 后台密码若每次启动随机生成，COS 凭证将无法跨重启保存。
# CONFIG_SECRET=

# 可选：公网域名（启用 docker compose --profile https 时由 Caddy 申请证书）
DOMAIN=

# ===== 限流（可选）=====
# 1Panel/Nginx/Caddy 反代后必须设为 1，否则所有用户会共用代理 IP 的额度
TRUST_PROXY=1
# RATE_UNLOCK_IP=60
# RATE_UNLOCK_OPENID=5
# RATE_SUMMARY_IP=30
