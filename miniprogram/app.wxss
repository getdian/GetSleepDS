/* ============================================================
   睡点 · 新中式暗夜诗意 × 沉浸式玻璃拟态
   全项目只允许通过 Token 引用颜色，不在页面里写裸色值
   ============================================================ */

page {
  /* 睡眠暗夜色盘 */
  --bg-cosmic: #080B14;
  --bg-night-primary: #0C101D;
  --bg-night-surface: #141B2D;
  --bg-aurora-1: #18223C;
  --bg-aurora-2: #0C101D;
  --bg-aurora-3: #080B14;

  /* 琉璃毛玻璃 */
  --glass-card-bg: rgba(20, 27, 45, 0.65);
  --glass-card-active: rgba(28, 38, 62, 0.85);
  --glass-tint: rgba(99, 102, 241, 0.08);

  /* 月影描边 */
  --border-moon-subtle: rgba(255, 255, 255, 0.08);
  --border-moon-light: rgba(255, 255, 255, 0.16);
  --border-glow: rgba(129, 140, 248, 0.35);

  /* 主色与点缀 */
  --color-primary: #818CF8;
  --color-primary-dark: #4F46E5;
  --color-accent-moon: #FDE68A;
  --color-calm-teal: #2DD4BF;
  --color-danger-soft: #F87171;

  /* 文字阶度 */
  --text-moon-pure: #F8FAFC;
  --text-primary: #E2E8F0;
  --text-secondary: #94A3B8;
  --text-muted: #64748B;

  /* 圆角 */
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --radius-pill: 999rpx;

  /* 间距 */
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;

  /* 动效 */
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-gentle: cubic-bezier(0.4, 0, 0.2, 1);
  --glass-blur: blur(24rpx) saturate(160%);
  --shadow-moon: 0 16rpx 48rpx rgba(0, 0, 0, 0.45);

  /* 字体 */
  --font-cn-serif: "Songti SC", "SimSun", "Source Han Serif CN", "STSong", serif;
  --font-sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "MiSans", sans-serif;

  /* 热力图分级 */
  --heat-0: rgba(255, 255, 255, 0.045);
  --heat-1: #1E1B4B;
  --heat-2: #3730A3;
  --heat-3: #4F46E5;
  --heat-4: #6366F1;
  --heat-5: #A5B4FC;

  /* 时间轮边缘渐隐 */
  --wheel-fade: rgba(8, 11, 20, 0.88);
  --scrim: rgba(8, 11, 20, 0.86);

  background-color: var(--bg-cosmic);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 100%;
}

view,
text,
scroll-view,
input,
button,
picker,
picker-view {
  box-sizing: border-box;
}

/* 页面骨架：氛围背景固定，内容在其上 */
.page {
  position: relative;
  z-index: 1;
  padding: 32rpx 32rpx 200rpx;
}

/* 玻璃卡片 */
.sleep-glass-card {
  position: relative;
  overflow: hidden;
  background-color: var(--bg-night-surface);
  background: var(--glass-card-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--border-moon-subtle);
  border-radius: var(--radius-xl);
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.26);
  transition: transform 0.3s var(--ease-spring), border-color 0.3s ease, background 0.3s ease;
}

.is-tappable:active {
  transform: scale(0.985);
  background: var(--glass-card-active);
  border-color: var(--border-moon-light);
}

/* 主按钮 */
/* 主行动按钮：主题靛蓝胶囊（与全站主色一致） */
.btn-lunar-capsule {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  height: 92rpx;
  padding: 0 40rpx;
  border: none;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, #7178E8 0%, #5357DA 100%);
  color: var(--text-moon-pure);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 20rpx rgba(79, 70, 229, 0.18);
  transition: transform 0.25s var(--ease-spring), opacity 0.2s ease;
}

.capsule-ico {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(248, 250, 252, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1;
}

.btn-lunar-capsule:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-moon-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 32rpx;
  border: 1rpx solid var(--border-moon-subtle);
  border-radius: var(--radius-pill);
  background: var(--glass-tint);
  color: var(--text-secondary);
  font-size: 26rpx;
}

.btn-moon-ghost:active {
  transform: scale(0.97);
  border-color: var(--border-glow);
  color: var(--text-primary);
}

/* 文字 */
.font-poetic {
  font-family: var(--font-cn-serif);
  letter-spacing: 6rpx;
  color: var(--text-moon-pure);
}

.eyebrow {
  display: block;
  font-size: 18rpx;
  letter-spacing: 5rpx;
  color: var(--text-muted);
  text-transform: uppercase;
}

.title-xl {
  display: block;
  font-family: var(--font-sans);
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.24;
  color: var(--text-moon-pure);
}

.sub {
  display: block;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.muted {
  color: var(--text-muted);
}

.divider {
  height: 1rpx;
  background: var(--border-moon-subtle);
}

/* 动效 */
.fade-in {
  animation: fadeIn 0.6s var(--ease-gentle) both;
}

.fade-up {
  animation: fadeUp 0.6s var(--ease-gentle) both;
}

.flip-in {
  animation: flipIn 0.55s var(--ease-spring) both;
  transform-origin: center;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes flipIn {
  from { opacity: 0; transform: perspective(900rpx) rotateY(-72deg); }
  to { opacity: 1; transform: perspective(900rpx) rotateY(0); }
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
