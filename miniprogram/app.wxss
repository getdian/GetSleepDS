/* ============================================================
   睡点 · 新中式暗夜诗意 × 沉浸式玻璃拟态
   全局色板只在这里维护；首页/时间轮可在各自 WXSS 顶部定义局部 token，
   新增颜色优先复用 token，历史裸色值逐步收敛。
   ============================================================ */

page {
  /* 睡眠暗夜色盘 */
  --bg-cosmic: #080B14;
  --bg-night-surface: #141B2D;

  /* 琉璃毛玻璃 */
  /* 不支持 backdrop-filter 时，0.8 的半透明底仍能保证可读 */
  --glass-card-bg: rgba(20, 27, 45, 0.8);
  --glass-card-active: rgba(28, 38, 62, 0.9);
  --glass-tint: rgba(99, 102, 241, 0.08);

  /* 月影描边 */
  --border-moon-subtle: rgba(255, 255, 255, 0.08);
  --border-moon-light: rgba(255, 255, 255, 0.16);
  --border-glow: rgba(129, 140, 248, 0.35);

  /* 主色与点缀 */
  --color-primary: #818CF8;
  --color-primary-soft: #A7A4FF;
  --color-accent-moon: #FDE68A;
  --color-calm-teal: #2DD4BF;

  /* 危险/不可逆操作（删除单段、撤销确认），低饱和红，不做大面积底色 */
  --color-danger: #F87171;

  /* 文字阶度 */
  --text-moon-pure: #F8FAFC;
  --text-primary: #E2E8F0;
  --text-secondary: #94A3B8;
  --text-muted: #7C8799;

  /* 表面色：悬浮 tabBar 比页面底色略亮一档，单独出声，避免各处裸写 */
  --color-tabbar-surface: #0A0E1A;

  /* Hero 背景压暗：计算器页与 hero-backdrop 组件共用同一份，避免两套数值漂移 */
  --hero-scrim: linear-gradient(
    180deg,
    rgba(8, 11, 20, 0.58) 0%,
    rgba(8, 13, 29, 0.55) 36%,
    rgba(8, 13, 29, 0.86) 76%,
    #080B14 100%
  );

  /* 层级表：唯一来源，值越大越靠前；使用处一律带 fallback */
  --z-hero: 0;
  --z-page: 1;
  --z-topbar: 30;
  --z-fab: 40;
  --z-collapse-mask: 85;
  --z-tabbar: 90;
  --z-player: 100;
  --z-player-host: 120;
  --z-dim: 150;
  --z-sheet-mask: 180;
  /* 添加到「我的小程序」气泡：高于播放条与顶栏，低于弹层遮罩（抽屉打开时压住它） */
  --z-add-tip: 130;
  --z-sheet: 200;
  --z-unlock: 300;
  /* 跨页播放器：高于底部播放器/页面内容，低于抽屉遮罩与解锁面板 */
  --z-overlay: 160;

  /* 主操作按钮：计算器 / 入睡页 / 结束面板 / 解锁面板共用一套（亮底深字） */
  --btn-primary-bg: linear-gradient(135deg, #8E98FF 0%, #707DEB 100%);
  --btn-primary-fg: #141B45;
  --btn-primary-shadow: 0 14rpx 36rpx rgba(118, 131, 251, 0.35);

  /* 圆角 */
  --radius-md: 24rpx;
  --radius-xl: 48rpx;
  --radius-pill: 999rpx;

  /* 动效 */
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-gentle: cubic-bezier(0.4, 0, 0.2, 1);
  --glass-blur: blur(24rpx) saturate(160%);
  --shadow-moon: 0 16rpx 48rpx rgba(0, 0, 0, 0.45);
  /* 时间轮边缘渐隐已由行内 opacity 完成，不再保留死 token */

  /* 字体 */
  --font-cn-serif: "Songti SC", "SimSun", "Source Han Serif CN", "STSong", serif;
  --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;

  /* 热力图分级 */
  /* 低强度也要能和空白天区分：相邻层级保持可见的亮度差 */
  --heat-0: rgba(255, 255, 255, 0.055);
  --heat-1: #5A57C8;
  --heat-2: #6C68E8;
  --heat-3: #8A90FF;
  --heat-4: #B4BEFF;
  --heat-5: #E0E7FF;

  --scrim: rgba(8, 11, 20, 0.86);

  background-color: var(--bg-cosmic);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 100%;
}

view,
text,
scroll-view,
input,
button,
picker,
picker-view {
  box-sizing: border-box;
}

/* 页面骨架：氛围背景固定，内容在其上 */
.page {
  position: relative;
  z-index: var(--z-page, 1);
  /* 底部为常驻悬浮音符/播放条预留适度呼吸空间 */
  padding: 32rpx 32rpx 140rpx;
}

/* 玻璃卡片 */
.sleep-glass-card {
  position: relative;
  overflow: hidden;
  background: var(--glass-card-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--border-moon-subtle);
  border-radius: var(--radius-xl);
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.26);
  transition: transform 0.3s var(--ease-spring), border-color 0.3s ease, background 0.3s ease;
}

/* 文字 */
.font-poetic {
  font-family: var(--font-cn-serif);
  letter-spacing: 6rpx;
  color: var(--text-moon-pure);
}

.eyebrow {
  display: block;
  font-size: 18rpx;
  letter-spacing: 5rpx;
  color: var(--text-muted);
  text-transform: uppercase;
}

.title-xl {
  display: block;
  font-family: var(--font-sans);
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.24;
  color: var(--text-moon-pure);
}

.sub {
  display: block;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.muted {
  color: var(--text-muted);
}

.divider {
  height: 1rpx;
  background: var(--border-moon-subtle);
}

/* 动效 */
.fade-up {
  animation: fadeUp 0.6s var(--ease-gentle) both;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
