/**
 * 底部弹层面板（sleep-sheet）：入睡页「结束/补记/编辑」与统计页「补记」共用。
 *
 * 类名沿用 end-* 前缀（历史命名），页面通过 @import 引入：
 *   @import "../../styles/sheet.wxss";
 * 页面 wxss 仍需把 @import 放在首位（CSS 规则要求，且微信同此约束）。
 *
 * 改这里的任何一个值（圆角/热区/文案容器）会同时作用于两个页面的补记面板——
 * 这正是把它抽出来的目的，别再往页面 wxss 里复制一份。
 */

/* 遮罩：页面在 wxml 上还需 catchtouchmove="noop" 阻止穿透滚动 */
.end-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: var(--z-sheet-mask, 180);
  display: flex;
  align-items: flex-end;
  background: rgba(4, 7, 15, 0.62);
  -webkit-backdrop-filter: blur(8rpx);
  backdrop-filter: blur(8rpx);
}

.end-sheet {
  width: 100%;
  padding: 30rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  /* 底部弹层统一参数：36rpx 圆角 / 0.98 深底 / 0.62 + blur 8 遮罩 */
  border-radius: 36rpx 36rpx 0 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(16, 22, 40, 0.98);
  box-shadow: 0 -18rpx 60rpx rgba(0, 0, 0, 0.45);
}

.end-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.end-title {
  display: block;
  font-size: 32rpx;
  color: var(--text-primary);
}

.end-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

.end-close {
  position: relative;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.55);
  transition: opacity 0.14s ease, transform 0.14s ease;
}

.end-close:active,
.end-close--tap {
  opacity: 0.45;
  transform: scale(0.92);
}

/* 视觉 56rpx，命中区补到 80rpx */
.end-close::after {
  content: "";
  position: absolute;
  left: -12rpx;
  right: -12rpx;
  top: -12rpx;
  bottom: -12rpx;
}

.end-date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  transition: opacity 0.14s ease, background 0.14s ease;
}

.end-date-row:active,
.end-date-row--tap {
  opacity: 0.72;
  background: rgba(255, 255, 255, 0.08);
}

.end-date-k {
  flex: none;
  font-size: 19rpx;
  color: var(--text-muted);
}

.end-date-v {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-primary);
}

.end-date-arrow {
  font-size: 28rpx;
  color: var(--text-muted);
}

.end-times {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 22rpx;
}

.end-times picker {
  flex: 1;
  min-width: 0;
}

.end-time-item {
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  text-align: center;
  transition: opacity 0.14s ease, background 0.14s ease;
}

.end-time-item:active,
.end-time-item--tap {
  opacity: 0.72;
  background: rgba(255, 255, 255, 0.08);
}

.end-time-k {
  display: block;
  font-size: 19rpx;
  color: var(--text-muted);
}

.end-time-v {
  display: block;
  margin-top: 2rpx;
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  color: var(--text-primary);
}

.end-arrow {
  flex: none;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.34);
}

.end-summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx 8rpx;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--color-primary-soft);
}

.end-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.end-error {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #fca5a5;
}

.end-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.end-btn {
  flex: 1;
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  transition: opacity 0.14s ease, transform 0.14s ease;
}

.end-btn:active,
.end-btn--tap {
  opacity: 0.76;
  transform: scale(0.97);
}

.end-btn.ghost {
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: var(--text-secondary);
}

.end-btn.primary {
  background: var(--btn-primary-bg);
  color: var(--btn-primary-fg);
  font-weight: 600;
}

.end-btn.primary:active,
.end-btn.primary.end-btn--tap {
  opacity: 0.85;
  transform: scale(0.97);
}

.end-btn.primary.is-disabled {
  opacity: 0.38;
}
