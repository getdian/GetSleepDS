/* 添加到「我的小程序」引导气泡：
   宽度由内容撑开（fixed + flex 默认 shrink-to-fit），右缘与胶囊对齐；
   不铺遮罩、不抢焦点——它是提示不是拦截，6 秒自动收起。 */

.add-tip {
  position: fixed;
  z-index: var(--z-add-tip, 130);
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 22rpx 20rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(20, 27, 45, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.42);
  transition: opacity 0.24s ease, transform 0.24s ease;
}

/* 收起：先淡出上移 240ms 再卸载节点，避免生硬闪没 */
.add-tip.is-out {
  opacity: 0;
  transform: translateY(-8rpx);
}

.add-tip--tap {
  transform: scale(0.98);
}

/* 指向胶囊的小三角：旋转 45° 的方块，露出左/上两条描边对齐卡片边框。
   深色卡片压在深色页面上，纯色块会看不见，所以描边比卡片本体亮一档。 */
.add-tip-arrow {
  position: absolute;
  top: -11rpx;
  width: 22rpx;
  height: 22rpx;
  background: rgba(20, 27, 45, 0.96);
  border-left: 1rpx solid rgba(255, 255, 255, 0.24);
  border-top: 1rpx solid rgba(255, 255, 255, 0.24);
  transform: rotate(45deg);
}

.add-tip-close {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #cbd5e1;
  background: rgba(255, 255, 255, 0.12);
}

.add-tip-close--tap {
  opacity: 0.6;
}

/* 文案列：显式列方向 + 不伸缩。
   卡片靠 right 定位、宽度由内容撑开；若这里写 flex:1/min-width:0，
   容器算出的首选宽度会塌成 0，标题与副标会叠在一起。 */
.add-tip-main {
  flex: none;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.add-tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-moon-pure, #f8fafc);
  white-space: nowrap;
}

.add-tip-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--text-secondary, #94a3b8);
  white-space: nowrap;
}

.add-tip-btn {
  flex: none;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: var(--btn-primary-bg, #8e98ff);
  color: var(--btn-primary-fg, #141b45);
  font-size: 25rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(118, 131, 251, 0.3);
}
