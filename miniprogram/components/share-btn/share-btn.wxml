<view wx:if="{{variant === 'icon'}}" class="share-icon">
  <view class="share-glyph">
    <view class="sg-dot sg-a"></view>
    <view class="sg-dot sg-b"></view>
    <view class="sg-dot sg-c"></view>
    <view class="sg-bar sg-ab"></view>
    <view class="sg-bar sg-cb"></view>
  </view>
  <text class="share-icon-label">{{text}}</text>
  <button class="share-icon-hit" open-type="share" hover-class="share-btn--active"></button>
</view>
<button wx:else class="share-btn share-btn--{{variant}}" open-type="share" hover-class="share-btn--active">
  {{text}}
</button>
