.share-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 1;
  border: 1rpx solid var(--border-moon-subtle);
  border-radius: var(--radius-pill);
  background: var(--glass-tint);
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: normal;
}

.share-btn::after {
  border: none;
}

.share-btn--link {
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 20rpx;
  border: none;
  background: transparent;
  color: var(--color-primary);
  font-size: 24rpx;
}

/* 图标 + 文字形态：无底无边框，只留 glyph 与“分享”，button 作为透明热区铺满。
   button 自带 width:100% 等默认样式，直接约束 button 宽高在该基础库上不可靠。 */
.share-icon {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 64rpx;
  /* 图标与文案之间留出呼吸，热区仍由绝对定位的 button 铺满 */
  padding: 0 8rpx;
  color: var(--text-secondary);
}

.share-icon-label {
  font-size: 23rpx;
  line-height: 1;
  letter-spacing: 1rpx;
  color: var(--text-secondary);
}

.share-icon-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
}

.share-icon-hit::after {
  border: none;
}

.share-glyph {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  color: var(--text-secondary);
}

.sg-dot {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

/* 左中一点 + 右上/右下两点，两条连线从左侧点发散（对齐系统分享图标） */
.sg-a {
  left: 2rpx;
  top: 12rpx;
}

.sg-b {
  right: 2rpx;
  top: 2rpx;
}

.sg-c {
  right: 2rpx;
  bottom: 2rpx;
}

.sg-bar {
  position: absolute;
  width: 22rpx;
  height: 2rpx;
  background: currentColor;
  transform-origin: 0 50%;
}

/* 起点为左侧点中心 (6,16)，角度 ±27° 指向右侧两点中心 (26,6)/(26,26) */
.sg-ab {
  left: 5rpx;
  top: 15rpx;
  transform: rotate(-27deg);
}

.sg-cb {
  left: 5rpx;
  top: 16rpx;
  transform: rotate(27deg);
}

.share-btn--active {
  opacity: 0.65;
}
