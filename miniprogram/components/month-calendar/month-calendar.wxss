.mc {
  width: 100%;
}

.mc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.mc-title {
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--text-secondary);
  font-variant-numeric: tabular-nums;
}

.mc-nav {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mc-nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 32rpx;
  line-height: 1;
  color: var(--text-secondary);
}

.mc-nav-btn.is-off {
  opacity: 0.24;
}

.mc-nav-btn:active {
  background: rgba(255, 255, 255, 0.06);
}

.mc-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.mc-week-cell {
  text-align: center;
  font-size: 18rpx;
  color: var(--text-muted);
}

.mc-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  grid-auto-rows: 88rpx;
  gap: 6rpx;
}

.mc-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.045);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.mc-cell:active {
  transform: scale(0.96);
}

.mc-cell.is-pad {
  background: transparent;
}

.mc-num {
  position: absolute;
  left: 8rpx;
  top: 6rpx;
  font-size: 17rpx;
  line-height: 1;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}

.mc-dur {
  font-size: 21rpx;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  margin-top: 8rpx;
}

/* 4 档：短睡不再和长睡同色；亮档改用深字保证对比 */
.lv-1 {
  background: #3F3C9E;
}

.lv-1 .mc-num,
.lv-1 .mc-dur {
  color: #EDEEFF;
}

.lv-2 {
  background: #5B57D6;
}

.lv-2 .mc-num,
.lv-2 .mc-dur {
  color: #F8FAFC;
}

.lv-3 {
  background: #B4BEFF;
}

.lv-3 .mc-num,
.lv-3 .mc-dur {
  color: #1E1B4B;
}

.lv-4 {
  background: #E0E7FF;
}

.lv-4 .mc-num,
.lv-4 .mc-dur {
  color: #1E1B4B;
}

/* 今天就画内描边，避免和选中态的外描边互相覆盖 */
.mc-cell.is-today {
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.52);
}

.mc-cell.is-selected {
  box-shadow: 0 0 0 3rpx #FDE68A;
  z-index: 1;
}

.mc-cell.is-future {
  background: rgba(148, 163, 184, 0.04);
  border: 1rpx dashed rgba(148, 163, 184, 0.26);
  opacity: 0.55;
}

.mc-cell.is-future .mc-num {
  color: rgba(124, 135, 153, 0.7);
}

/* 进行中的一段：保留当天已有颜色，用内描边 + 亮点提示“还没结束” */
.mc-cell.is-partial {
  box-shadow: inset 0 0 0 2rpx var(--border-glow);
}

.mc-partial-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-primary);
}
