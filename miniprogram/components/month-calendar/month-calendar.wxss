.mc {
  width: 100%;
}

.mc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.mc-title {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--text-secondary);
  font-variant-numeric: tabular-nums;
}

.mc-nav {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.mc-nav-btn {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 28rpx;
  line-height: 1;
  color: var(--text-secondary);
}

/* 只上下外扩：左右相邻按钮间距仅 6rpx，横向扩会互相抢点击 */
.mc-nav-btn::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -16rpx;
  bottom: -16rpx;
}

.mc-nav-btn.is-off {
  /* 0.24 在深底上约 1.5:1，禁用态也需可辨识 */
  opacity: 0.45;
}

.mc-nav-btn:active {
  background: rgba(255, 255, 255, 0.06);
}

/* 星期行与格子共用同一套列网格，保证列对齐。
   横向间距收密（4rpx）、纵向留给行呼吸（16rpx）。

   兼容性：不用 CSS Grid / flex gap——老安卓 X5（Chromium 53）没有 Grid，
   iOS 14.5 以下没有 flex gap。这里用「固定宽容器 + space-between」还原同一组间距：
   7×92 + 6×4 = 668rpx，列距由 space-between 均分，行距用 margin-bottom。 */
.mc-week {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 668rpx;
  margin: 0 auto 18rpx;
}

.mc-week-cell {
  width: 92rpx;
  text-align: center;
  font-size: 16rpx;
  color: var(--text-muted);
}

/* 92×76rpx 扁格：7 列铺满 668rpx，列间距 4rpx 收密、行间距 16rpx 放大 */
.mc-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 668rpx;
  margin: 0 auto;
}

.mc-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 76rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.045);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

/* 格内两行（日号 + 时长/补记）：用相邻兄弟 margin 代替 flex gap，老内核同样有 2rpx 呼吸 */
.mc-cell > text + text {
  margin-top: 2rpx;
}

.mc-cell:active {
  transform: scale(0.96);
}

.mc-cell.is-pad {
  background: transparent;
}

.mc-num {
  position: absolute;
  left: 6rpx;
  top: 5rpx;
  font-size: 16rpx;
  line-height: 1;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}

.mc-dur {
  font-size: 19rpx;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  margin-top: 6rpx;
}

/* 空格子：写「补记」，点击直接弹页内补记面板（不再跳入睡页 / 不落到下方详情卡） */
.mc-add {
  margin-top: 2rpx;
  /* 空格只给一个轻量 + 号：整月 20+ 个「补记」会让日历像一堆按钮，
     真实补记入口在格子详情卡与统计页空态里都有说明。 */
  font-size: 24rpx;
  line-height: 1;
  color: rgba(148, 163, 184, 0.55);
}

/* 4 档：同一品牌紫由弱到强（越久越醒目）。
   全部用实色而非半透明——空格子本身是 rgba(255,255,255,.045)，
   半透明紫在深底上会被空格吃掉对比（实测 0.22 只有约 1.25:1），
   短睡日会被看成"没打卡"。当前四档对空格约 3.1 / 4.1 / 6.6 / 9.2 比 1，
   最低档已过 WCAG 3:1；最高档刻意停在浅紫而不是近白（近白会读成空格/高亮） */
.lv-1 {
  background: #5A57C8;
}

.lv-1 .mc-num,
.lv-1 .mc-dur {
  color: #EDEEFF;
}

.lv-2 {
  background: #6C68E8;
}

.lv-2 .mc-num,
.lv-2 .mc-dur {
  color: #F8FAFC;
}

.lv-3 {
  background: #8A90FF;
}

.lv-3 .mc-num,
.lv-3 .mc-dur {
  color: #1E1B4B;
}

.lv-4 {
  background: #A5B4FC;
}

.lv-4 .mc-num,
.lv-4 .mc-dur {
  color: #1E1B4B;
}

/* 今天就画内描边，避免和选中态的外描边互相覆盖 */
.mc-cell.is-today {
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.52);
}

/* 选中态用 outline：box-shadow 会被后面 .is-today / .is-partial 的同名属性覆盖，
   导致“今天且进行中”的格子点选后看不到金描边。outline 不参与 box-shadow 竞争。 */
.mc-cell.is-selected {
  outline: 2.5rpx solid #FDE68A;
  outline-offset: -2rpx;
  z-index: 1;
}

/* 未来日期只弱化，不整格降透明度：opacity .55 × 文字 .7 叠乘后对比度约 1.8:1，
   10 月 23–31 的日号在截图里几乎不可见，日历像被截断。 */
.mc-cell.is-future {
  background: rgba(148, 163, 184, 0.035);
  border: 1rpx dashed rgba(148, 163, 184, 0.22);
}

.mc-cell.is-future .mc-num {
  color: rgba(164, 179, 200, 0.7);
}

/* 进行中的一段：保留当天已有颜色，用内描边 + 亮点提示“还没结束” */
.mc-cell.is-partial {
  box-shadow: inset 0 0 0 2rpx var(--border-glow);
}

.mc-partial-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-primary);
}
