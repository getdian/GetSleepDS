<view wx:if="{{enabled && unitId}}" class="ad-slot {{failed ? 'is-failed' : loaded ? 'is-settled' : type === 'banner' ? 'is-pending-banner' : 'is-pending'}}">
  <ad
    wx:if="{{!failed && type === 'banner'}}"
    unit-id="{{unitId}}"
    bindload="onAdLoad"
    binderror="onAdError"
  ></ad>
  <ad
    wx:elif="{{!failed}}"
    unit-id="{{unitId}}"
    ad-type="template"
    ad-theme="{{theme}}"
    bindload="onAdLoad"
    binderror="onAdError"
  ></ad>
</view>
