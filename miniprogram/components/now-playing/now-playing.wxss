/* 外层只负责定位与“是否可点”：常驻 DOM，靠 class 走入场/折叠，避免 wx:if 硬切 */
.np-shell {
  position: fixed;
  left: 0;
  right: 0;
  /* 与入睡页 dock 共用同一套底部安全位：避开 tabBar 并拉开间距，又不压住计算器主按钮 */
  bottom: calc(176rpx + env(safe-area-inset-bottom));
  z-index: var(--z-overlay, 9999);
  padding: 0 0 0 24rpx;
  pointer-events: none;
  visibility: hidden;
  /* 折叠动效播完再隐藏，期间仍不接管点击 */
  transition: visibility 0s linear 0.24s;
}

.np-shell.is-in {
  visibility: visible;
  /* 外壳只包住播放条本身，不铺满整页；直接接管点击，兼容部分基础库
     对 pointer-events:none 父级下子元素点击失效的问题 */
  pointer-events: auto;
  transition: visibility 0s linear 0s;
}

.now-playing,
.np-float {
  pointer-events: auto;
}

/* 展开态点击外部：只折叠回音符，不停止播放 */
/* 同上：低于悬浮 tabBar(90)，避免吞掉第一次切 tab 的点击 */
.np-collapse-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: var(--z-collapse-mask, 85);
  background: transparent;
}

.now-playing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  /* 展开条比通栏窄，右缘直接吸附屏幕边 */
  width: 100%;
  max-width: 480rpx;
  min-height: 88rpx;
  margin-left: auto;
  padding: 14rpx 18rpx 14rpx 48rpx;
  border-radius: 999rpx 0 0 999rpx;
  border: none;
  background: rgba(8, 11, 20, 0.62);
  -webkit-backdrop-filter: blur(26rpx);
  backdrop-filter: blur(26rpx);
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.32);
  opacity: 0;
  /* 从右缘音符位置向左展开；收起时反向收回去 */
  transform: translate3d(60rpx, 0, 0) scale(0.92);
  transform-origin: 100% 50%;
  transition: transform 0.26s var(--ease-gentle), opacity 0.2s var(--ease-gentle);
}

.np-shell.is-in .now-playing {
  opacity: 1;
  transform: translate3d(0, 0, 0) scale(1);
  transition: transform 0.34s var(--ease-spring), opacity 0.22s var(--ease-gentle);
}

/* 点击外部：先向右收缩淡出，再切换成音符。
   需要压过 `.np-shell.is-in .now-playing` 的入场规则，否则计算器/统计页会直接消失。 */
.np-shell.is-in .now-playing.is-collapsing {
  opacity: 0;
  transform: translate3d(90rpx, 0, 0) scale(0.86);
  transition: transform 0.2s ease-in, opacity 0.16s ease-in;
}

.np-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border-radius: var(--radius-pill);
  transition: opacity 0.15s ease;
}

.np-main--tap {
  opacity: 0.68;
}

/* 信息区：曲名 · 分类，第二行均衡器 + 播放状态 + 定时 */
.np-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}

/* 播放中收起：右侧绿色音符，深色透明玻璃圆底，无边框 */
.np-float {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  margin-left: auto;
  margin-right: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(8, 11, 20, 0.3);
  border: none;
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.2);
  animation: npFloat 3.4s ease-in-out infinite;
}

/* 视觉只有音符，命中区向外扩到约 128rpx，方便单手点中 */
.np-float::after {
  content: "";
  position: absolute;
  left: -16rpx;
  right: -16rpx;
  top: -16rpx;
  bottom: -16rpx;
}

.np-float-note {
  font-family: var(--font-cn-serif);
  font-size: 66rpx;
  line-height: 1;
  color: var(--color-calm-teal, #34D399);
  text-shadow:
    0 0 22rpx rgba(52, 211, 153, 0.55),
    0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  animation: npNoteIn 0.18s ease-out;
}

/* 暂停后折叠：音符降亮度，避免误以为还在播 */
.np-float.is-paused .np-float-note {
  opacity: 0.58;
  text-shadow: none;
}

@keyframes npNoteIn {
  from { opacity: 0; transform: scale(0.76); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes npFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-8rpx) scale(1.04); }
}

.np-line {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.np-title {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.2;
  color: var(--text-primary);
}

.np-sep,
.np-cat {
  flex: none;
  font-size: 21rpx;
  line-height: 1.2;
  color: var(--text-muted);
}

.np-status {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--text-muted);
  transition: color 0.2s ease;
}

.np-status.is-on {
  color: var(--color-primary);
}

.np-status-text {
  flex: none;
  font-size: 20rpx;
  line-height: 1.2;
  transition: color 0.2s ease;
}

.np-timer-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--text-secondary);
}

/* 跳动音符：本条唯一的均衡器，四根加高加粗、大摆幅 */
.np-seq {
  display: flex;
  align-items: flex-end;
  height: 28rpx;
  flex: none;
}

.np-sbar {
  width: 5rpx;
  margin-right: 3rpx;
  border-radius: 2.5rpx;
  background: currentColor;
  transform-origin: bottom;
  animation: npSeq 0.9s ease-in-out infinite;
}

.np-s1 {
  height: 28rpx;
}

.np-s2 {
  height: 16rpx;
  animation-delay: 0.14s;
}

.np-s3 {
  height: 22rpx;
  animation-delay: 0.28s;
}

.np-s4 {
  height: 12rpx;
  animation-delay: 0.42s;
}

/* 暂停/折叠时停止跳动，避免隐藏页与暂停态继续吃 CPU */
.np-status.is-off .np-sbar,
.np-shell.is-out .np-sbar {
  animation-play-state: paused;
}

.np-status.is-off .np-sbar {
  opacity: 0.42;
}

@keyframes npSeq {
  0%, 100% {
    transform: scaleY(0.3);
  }
  50% {
    transform: scaleY(1);
  }
}

/* 右侧控制区：无底框纯图标，76rpx 命中区 + 伪元素扩到 88rpx */
.np-ctrls {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.np-icon {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.92);
  transition: transform 0.12s ease, opacity 0.12s ease;
}

/* 伪元素外扩 6rpx：视觉是纯图标，实际可点区域 88rpx */
.np-icon::after {
  content: "";
  position: absolute;
  left: -6rpx;
  right: -6rpx;
  top: -6rpx;
  bottom: -6rpx;
}

.np-icon--tap {
  transform: scale(0.86);
  opacity: 0.55;
}

/* 暂停图标：两根细竖条（对齐参考图，不用胶囊圆角） */
.np-ico-pause {
  display: flex;
  align-items: center;
  gap: 9rpx;
  height: 30rpx;
  animation: npIconIn 0.16s var(--ease-gentle);
}

.np-pbar {
  width: 7rpx;
  height: 32rpx;
  border-radius: 2rpx;
  background: currentColor;
}

/* 播放图标：三角，margin 补偿视觉居中 */
.np-ico-play {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 15rpx solid transparent;
  border-bottom: 15rpx solid transparent;
  border-left: 24rpx solid currentColor;
  animation: npIconIn 0.16s var(--ease-gentle);
}

/* 播放/暂停切换时给图标一个轻微的“落定”反馈 */
@keyframes npIconIn {
  from {
    opacity: 0;
    transform: scale(0.68);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
