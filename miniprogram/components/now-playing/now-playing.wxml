<view
  wx:if="{{visible && miniExpanded && !collapsed}}"
  class="np-collapse-mask"
  bindtap="collapseMini"
  aria-hidden="true"
></view>
<view class="np-shell {{visible ? 'is-in' : 'is-out'}}" aria-hidden="{{!visible}}">
  <view
    wx:if="{{!collapsed && (!playing || miniExpanded)}}"
    class="now-playing {{collapsing ? 'is-collapsing' : ''}}"
    bindtap="openAudio"
  >
    <view
      class="np-main"
      hover-class="np-main--tap"
      hover-stay-time="120"
      aria-role="button"
      aria-label="打开环境声音"
    >
      <view class="np-info">
        <view class="np-line">
          <text class="np-title">{{title}}</text>
          <block wx:if="{{category}}">
            <text class="np-sep">·</text>
            <text class="np-cat">{{category}}</text>
          </block>
        </view>
        <view class="np-status {{playing ? 'is-on' : 'is-off'}}">
          <view class="np-seq" aria-hidden="true">
            <view class="np-sbar np-s1"></view>
            <view class="np-sbar np-s2"></view>
            <view class="np-sbar np-s3"></view>
            <view class="np-sbar np-s4"></view>
          </view>
          <text class="np-status-text">{{loading ? '缓冲中…' : (playing ? '正在播放' : '已暂停')}}</text>
          <text wx:if="{{timerText}}" class="np-timer-text">· {{timerText}}</text>
        </view>
      </view>
    </view>

    <view class="np-ctrls">
      <view
        class="np-icon np-toggle"
        catchtap="toggle"
        hover-class="np-icon--tap"
        hover-stay-time="100"
        aria-role="button"
        aria-label="{{playing ? '暂停' : '继续播放'}}"
      >
        <block wx:if="{{playing}}">
          <view class="np-ico-pause">
            <view class="np-pbar"></view>
            <view class="np-pbar"></view>
          </view>
        </block>
        <block wx:else>
          <view class="np-ico-play"></view>
        </block>
      </view>

      <view
        class="np-icon np-stop"
        catchtap="close"
        hover-class="np-icon--tap"
        hover-stay-time="100"
        aria-role="button"
        aria-label="停止播放"
      >
        <view class="np-ico-stop"></view>
      </view>
    </view>
  </view>

  <view
    wx:else
    class="np-float {{playing ? '' : 'is-paused'}}"
    bindtap="expandMini"
    aria-role="button"
    aria-label="展开播放条"
  >
    <text class="np-float-note" aria-hidden="true">♪</text>
  </view>
</view>
