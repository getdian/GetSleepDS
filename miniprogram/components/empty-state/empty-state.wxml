<view class="empty">
  <view class="empty-scene" aria-hidden="true">
    <view class="es-halo"></view>
    <view class="es-moon"></view>
    <view class="es-star es-star-a"></view>
    <view class="es-star es-star-b"></view>
    <view class="es-star es-star-c"></view>
    <view class="es-star es-star-d"></view>
    <view class="es-grid">
      <view
        wx:for="{{cells}}"
        wx:key="*this"
        class="es-cell {{index === 8 ? 'is-lit' : ''}}"
      ></view>
    </view>
  </view>
  <text class="empty-title">{{title}}</text>
  <text wx:if="{{desc}}" class="empty-desc">{{desc}}</text>
  <view
    wx:if="{{actionText}}"
    class="empty-btn"
    bindtap="onAction"
    aria-role="button"
    aria-label="{{actionText}}"
  >
    <text>{{actionText}}</text>
  </view>
</view>
