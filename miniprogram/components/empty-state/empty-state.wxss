.empty {
  padding: 88rpx 40rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 单一图标：只保留 3×3 日历格，柔光作为夜色氛围垫在后面。
   月牙与网格并排会被读成“两个图标”（截图反馈），9 个格子塞进 49px 的月牙又会互相打架。 */
.empty-scene {
  position: relative;
  width: 164rpx;
  height: 164rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 柔光底：去掉硬边圆盘与描边，避免“星球/按钮”感 */
.es-halo {
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle at 50% 50%,
    rgba(167, 164, 255, 0.2) 0%,
    rgba(99, 102, 241, 0.08) 42%,
    rgba(13, 19, 34, 0) 70%
  );
  animation: empty-breathe 6.4s ease-in-out infinite;
}

/* 3×3 迷你格：左上第一格是“即将长出的第一格”。
   格子 30rpx + 描边 0.22，保证 9 格在深底上都可见。 */
.es-grid {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, 30rpx);
  grid-auto-rows: 30rpx;
  gap: 7rpx;
}

.es-cell {
  box-sizing: border-box;
  border-radius: 9rpx;
  background: rgba(167, 164, 255, 0.1);
  border: 1rpx solid rgba(167, 164, 255, 0.22);
}

.es-cell.is-lit {
  background: linear-gradient(145deg, #F3F6FF 0%, #C7D2FE 42%, #8B87FF 100%);
  border-color: rgba(238, 242, 255, 0.86);
  box-shadow:
    0 0 14rpx rgba(199, 210, 254, 0.55),
    0 0 30rpx rgba(99, 102, 241, 0.3);
  animation: empty-cell-glow 3.2s ease-in-out infinite;
}

@keyframes empty-cell-glow {
  0%,
  100% {
    box-shadow:
      0 0 14rpx rgba(199, 210, 254, 0.55),
      0 0 30rpx rgba(99, 102, 241, 0.3);
  }
  50% {
    box-shadow:
      0 0 20rpx rgba(199, 210, 254, 0.8),
      0 0 40rpx rgba(99, 102, 241, 0.45);
  }
}

@keyframes empty-breathe {
  0%,
  100% {
    opacity: 0.76;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.035);
  }
}

.empty-title {
  margin-top: 36rpx;
  font-family: var(--font-cn-serif);
  font-size: 30rpx;
  letter-spacing: 3rpx;
  color: var(--text-primary);
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.9;
  color: var(--text-muted);
  text-align: center;
}

.empty-actions {
  margin-top: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.empty-btn {
  position: relative;
  height: 64rpx;
  min-height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-glow);
  background: var(--glass-tint);
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-primary);
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.empty-btn::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -12rpx;
  bottom: -12rpx;
}

.empty-btn:active,
.empty-btn--tap {
  opacity: 0.82;
  transform: scale(0.96);
}

.empty-btn.is-primary {
  border: none;
  background: var(--btn-primary-bg);
  color: var(--btn-primary-fg);
  font-weight: 600;
  box-shadow: var(--btn-primary-shadow);
}

.empty-btn.is-secondary {
  border-color: rgba(145, 175, 255, 0.24);
  background: rgba(139, 135, 255, 0.08);
  color: var(--c-primary-soft, #9BA8DA);
  font-weight: 500;
}
