.empty {
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-orb {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, rgba(129, 140, 248, 0.26), rgba(20, 27, 45, 0.2) 70%);
  border: 1rpx solid var(--border-moon-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-moon);
}

.empty-moon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  box-shadow: -18rpx 8rpx 0 0 var(--text-secondary);
  transform: translateX(9rpx);
  opacity: 0.9;
}

.empty-title {
  margin-top: 36rpx;
  font-family: var(--font-cn-serif);
  font-size: 30rpx;
  letter-spacing: 3rpx;
  color: var(--text-primary);
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.9;
  color: var(--text-muted);
  text-align: center;
}

.empty-btn {
  margin-top: 38rpx;
  padding: 18rpx 52rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-glow);
  background: var(--glass-tint);
  font-size: 24rpx;
  color: var(--color-primary);
}
