/* 迷你播放器：常驻 DOM，用 class 切换展示/折叠，和跨页 now-playing 同款动效。
   定位/尺寸/玻璃底由文件末尾的覆盖块统一提供（单一来源），这里只管动画与布局。 */
.dock-mini {
  position: fixed;
  display: flex;
  align-items: center;
  opacity: 0;
  transform: translate3d(60rpx, 0, 0) scale(0.92);
  transform-origin: 100% 50%;
  pointer-events: none;
  visibility: hidden;
  transition: transform 0.26s var(--ease-gentle), opacity 0.2s var(--ease-gentle),
    visibility 0s linear 0.24s;
}

.dock-mini.is-in {
  opacity: 1;
  transform: translate3d(0, 0, 0) scale(1);
  pointer-events: auto;
  visibility: visible;
  transition: transform 0.34s var(--ease-spring), opacity 0.22s var(--ease-gentle),
    visibility 0s linear 0s;
}

/* 点击外部：先向右收缩淡出，再切换成音符 */
.dock-mini.is-collapsing {
  opacity: 0;
  transform: translate3d(90rpx, 0, 0) scale(0.86);
  transition: transform 0.2s ease-in, opacity 0.16s ease-in;
}

.dock-mini-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-pill);
  transition: opacity 0.15s ease;
}

.dock-mini-main--tap {
  opacity: 0.68;
}

.dock-mini-line {
  min-width: 0;
  display: flex;
  align-items: center;
}

.dock-mini-title {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  line-height: 1.2;
  color: var(--text-primary);
}

.dock-mini-sep,
.dock-mini-cat {
  flex: none;
  font-size: 21rpx;
  line-height: 1.2;
  color: var(--text-muted);
}

.dock-mini-status {
  min-width: 0;
  display: flex;
  align-items: center;
  color: var(--text-muted);
  transition: color 0.2s ease;
}

.dock-mini-status.is-on {
  color: var(--color-primary);
}

.dock-mini-sub {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 20rpx;
  line-height: 1.2;
}

/* 跳动音符：本条唯一的均衡器，四根加高加粗、大摆幅 */
.dock-seq {
  display: flex;
  align-items: flex-end;
  height: 28rpx;
  flex: none;
}

.dock-sbar {
  width: 5rpx;
  margin-right: 3rpx;
  border-radius: 2.5rpx;
  background: currentColor;
  transform-origin: bottom;
  animation: dockSeq 0.9s ease-in-out infinite;
}

.ds-1 {
  height: 28rpx;
}

.ds-2 {
  height: 16rpx;
  animation-delay: 0.14s;
}

.ds-3 {
  height: 22rpx;
  animation-delay: 0.28s;
}

.ds-4 {
  height: 12rpx;
  animation-delay: 0.42s;
}

.dock-mini-status.is-off .dock-sbar {
  animation-play-state: paused;
}

.dock-mini-status.is-off .dock-sbar {
  opacity: 0.42;
}

@keyframes dockSeq {
  0%, 100% {
    transform: scaleY(0.3);
  }
  50% {
    transform: scaleY(1);
  }
}

/* 右侧控制区：无底框纯图标，76rpx 命中区 + 伪元素扩到 88rpx */
.dock-mini-ctrls {
  flex: none;
  display: flex;
  align-items: center;
}

/* 下一首：双三角 + 竖条，与 now-playing 同一套几何 */
.dock-ico-next {
  display: flex;
  align-items: center;
  height: 26rpx;
}

.dock-next-tri {
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 13rpx solid currentColor;
}

.dock-next-tri + .dock-next-tri {
  margin-left: -4rpx;
}

.dock-next-bar {
  width: 4rpx;
  height: 20rpx;
  margin-left: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.dmc-btn {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.92);
  transition: opacity 0.12s ease, transform 0.12s ease;
}

/* 伪元素外扩 6rpx：视觉是纯图标，实际可点区域 88rpx */
.dmc-btn::after {
  content: "";
  position: absolute;
  left: -6rpx;
  right: -6rpx;
  top: -6rpx;
  bottom: -6rpx;
}

.dmc-btn:active,
.dmc-btn--tap {
  transform: scale(0.86);
  opacity: 0.55;
}

/* 暂停态图标：两根细竖条（与 now-playing 同几何） */
.dock-ico-pause {
  display: flex;
  align-items: center;
  height: 30rpx;
  animation: dockIconIn 0.16s var(--ease-gentle);
}

.dock-pbar {
  width: 6rpx;
  height: 30rpx;
  border-radius: 2rpx;
  background: currentColor;
}

/* 播放态图标：三角（margin 补偿视觉居中） */
.dock-ico-play {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 15rpx solid transparent;
  border-bottom: 15rpx solid transparent;
  border-left: 24rpx solid currentColor;
  animation: dockIconIn 0.16s var(--ease-gentle);
}

@keyframes dockIconIn {
  from {
    opacity: 0;
    transform: scale(0.68);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 遮罩与抽屉 */
.dock-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-sheet-mask, 180);
  background: transparent;
  pointer-events: none;
  transition: background 0.28s var(--ease-gentle);
}

.dock-mask.is-show {
  background: var(--scrim);
  pointer-events: auto;
}

.dock-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-sheet, 200);
  height: 86vh;
  display: flex;
  flex-direction: column;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  /* 顶部一层极淡的月晕，让抽屉与首页 Hero 同源 */
  background:
    radial-gradient(120% 52% at 50% 0%, rgba(129, 140, 248, 0.18) 0%, rgba(8, 11, 20, 0) 62%),
    var(--glass-card-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border-top: 1.5rpx solid var(--border-moon-light);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  box-shadow: 0 -28rpx 90rpx rgba(0, 0, 0, 0.5);
  transform: translateY(104%);
  transition: transform 0.4s var(--ease-spring);
}

.dock-sheet.is-show {
  transform: translateY(0);
}

/* 曲库少时让抽屉跟着内容收短，避免一两条声音撑出大片空白 */
.dock-sheet.is-short {
  height: auto;
  max-height: 86vh;
}

.dock-sheet.is-short .dock-list {
  flex: none;
  height: auto;
  max-height: none;
}

.dock-grip {
  width: 64rpx;
  height: 5rpx;
  margin: 0 auto 20rpx;
  border-radius: 3rpx;
  background: var(--border-moon-light);
  flex: none;
}

.dock-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex: none;
}

.dock-head-copy {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.dock-head-orb {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1rpx solid rgba(167, 164, 255, 0.28);
  background: linear-gradient(145deg, rgba(99, 102, 241, 0.36), rgba(30, 38, 70, 0.5));
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.28);
  font-family: var(--font-cn-serif);
  font-size: 30rpx;
  color: #DDE3FF;
}

.dock-head-text {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.dock-title {
  font-size: 36rpx;
  line-height: 1.25;
  color: var(--text-moon-pure);
}

.dock-head-stop {
  flex: none;
  min-height: 72rpx;
  margin-left: auto;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 停止二次确认：首点后 3 秒内转暖红并提示，再点才真正结束 */
.dock-head-stop.is-armed {
  color: #FCA5A5;
  font-weight: 600;
}

.dock-close {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--glass-tint);
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 30rpx;
  color: var(--text-secondary);
}

/* 当前播放：滚动列表后仍能看到正在响的声音 */
.dock-now {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(167, 164, 255, 0.2);
  background: rgba(99, 102, 241, 0.1);
  flex: none;
}

.dock-now-eq {
  width: 50rpx;
  height: 30rpx;
  flex: none;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 3rpx;
  color: var(--color-primary-soft);
}

.dock-now-eq .dock-sbar {
  width: 4rpx;
  margin-right: 0;
}

.dock-now-eq.is-off .dock-sbar {
  animation-play-state: paused;
  opacity: 0.42;
}

.dock-now-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 1rpx;
}

.dock-now-k {
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: var(--text-muted);
}

.dock-now-title {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 24rpx;
  color: var(--text-primary);
}

.dock-now-sub {
  flex: none;
  font-size: 19rpx;
  color: var(--color-primary-soft);
}

/* 搜索 */
.dock-search {
  position: relative;
  margin-top: 18rpx;
  flex: none;
}

.dock-input {
  height: 76rpx;
  padding: 0 64rpx 0 26rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  background: var(--glass-tint);
  font-size: 24rpx;
  color: var(--text-primary);
}

.dock-ph {
  color: var(--text-muted);
}

.dock-clear {
  position: absolute;
  right: 8rpx;
  top: 0;
  width: 64rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 分类 */
.dock-cats {
  height: 80rpx;
  margin-top: 12rpx;
  white-space: nowrap;
  flex: none;
}

.dock-cat-chips {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 20rpx;
}

.dock-cat {
  min-height: 72rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  background: var(--glass-tint);
  font-size: 24rpx;
  color: var(--text-secondary);
}

.dock-cat.cat-on {
  border-color: var(--border-glow);
  background: var(--glass-card-active);
  color: var(--text-moon-pure);
}

/* 列表 */
.dock-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  padding: 0 6rpx;
  flex: none;
}

.dock-section-title {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--text-muted);
}

.dock-section-count {
  font-size: 18rpx;
  color: var(--text-muted);
}

.dock-list {
  flex: 1;
  min-height: 0;
  height: 0;
  margin-top: 2rpx;
}

/* 列表去盒：行间 hairline；播放中的行是唯一带色块的行 */
.dock-track {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.dock-track.is-playing {
  background: var(--glass-tint);
  border-radius: var(--radius-md);
  border-bottom-color: transparent;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.dock-track:active {
  transform: scale(0.99);
}

.dock-cat:active,
.dock-timer-chip:active,
.dock-fav:active,
.dock-cache-clean:active {
  opacity: 0.7;
}

/* 列表内按钮视觉保持紧凑，伪元素把命中区补到约 88rpx */
.dock-fav,
.dock-tbtn,
.dock-cat,
.dock-cache-clean,
.dock-clear {
  position: relative;
}

.dock-fav::after,
.dock-tbtn::after,
.dock-cat::after,
.dock-cache-clean::after {
  content: "";
  position: absolute;
  left: -6rpx;
  right: -6rpx;
  top: -6rpx;
  bottom: -6rpx;
}

.dock-icon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
}

.dock-tinfo {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.dock-tname-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 正在播放的曲目在标题后加三根微型电平，暂停时变暗 */
.dock-track-eq {
  display: flex;
  align-items: flex-end;
  gap: 2rpx;
  height: 22rpx;
  margin-left: 2rpx;
  flex: none;
  opacity: 0.38;
}

.dock-track-eq.is-on {
  opacity: 1;
}

.dock-eq-bar {
  width: 3rpx;
  border-radius: 2rpx;
  background: var(--color-primary-soft);
  transform-origin: bottom;
  animation: dockTrackEq 0.9s ease-in-out infinite;
}

.dock-track-eq.is-on .eq-1 { height: 20rpx; }
.dock-track-eq.is-on .eq-2 { height: 12rpx; animation-delay: 0.16s; }
.dock-track-eq.is-on .eq-3 { height: 17rpx; animation-delay: 0.32s; }
.dock-track-eq:not(.is-on) .dock-eq-bar { height: 8rpx; animation: none; }

@keyframes dockTrackEq {
  0%, 100% { transform: scaleY(0.35); }
  50% { transform: scaleY(1); }
}

.dock-tname {
  font-size: 27rpx;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dock-tcat {
  flex: none;
  padding: 1rpx 10rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 16rpx;
  color: var(--text-muted);
}

.dock-tstate {
  font-size: 20rpx;
  color: var(--text-muted);
}

.dock-tbtn {
  flex: none;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 22rpx;
  color: var(--text-secondary);
}

.dock-fav {
  width: 64rpx;
  min-height: 72rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 32rpx;
  line-height: 1;
  color: var(--text-muted);
}

.dock-fav.is-on {
  color: var(--color-accent-moon);
  text-shadow: 0 0 18rpx rgba(253, 230, 138, 0.45);
}

.dock-tbtn.tb-on {
  border-color: var(--border-glow);
  color: var(--color-primary);
}

.dock-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 定时：左图标+文案，右侧等分胶囊分段（参考设计稿） */
.dock-timer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  flex: none;
}

.dock-timer-head {
  flex: none;
  display: flex;
  align-items: center;
  gap: 11rpx;
  min-width: 0;
}

/* 纯 CSS 秒表：表盘 + 顶部按钮 + 指针，笔画与图标参考图一致 */
.dock-timer-ico {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  flex: none;
  color: rgba(255, 255, 255, 0.64);
}

.dock-timer-ico::before {
  content: "";
  position: absolute;
  left: 4rpx;
  top: 7rpx;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.dock-timer-ico::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 1rpx;
  width: 14rpx;
  height: 3rpx;
  margin-left: -7rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.dock-timer-hand {
  position: absolute;
  left: 50%;
  top: 11rpx;
  width: 2rpx;
  height: 10rpx;
  margin-left: -1rpx;
  border-radius: 1rpx;
  background: currentColor;
  transform-origin: 50% 100%;
  transform: rotate(38deg);
}

.dock-timer-copy {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
  min-width: 0;
  max-width: 196rpx;
}

.dock-timer-label {
  font-size: 26rpx;
  line-height: 1.2;
  white-space: nowrap;
  color: var(--text-primary);
}

/* 运行中的剩余时间：与偏好档位区分，暂停时显示冻结的剩余 */
.dock-timer-live {
  font-size: 18rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--color-primary);
}

/* 深色轨道 + 等分分段，选中为浅紫药丸 */
.dock-timer-seg {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 5rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  background: rgba(0, 0, 0, 0.38);
}

.dock-timer-chip {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 2rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.56);
  transition: background 0.18s var(--ease-gentle), color 0.18s var(--ease-gentle),
    box-shadow 0.18s var(--ease-gentle);
}

/* 垂直扩 5rpx：视觉仍是 62rpx 药丸，实际可点 72rpx */
.dock-timer-chip::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -5rpx;
  bottom: -5rpx;
}

.dock-timer-chip--tap {
  opacity: 0.72;
}

.dock-timer-chip.is-on {
  background: #c9ccfa;
  color: #3f49bf;
  font-weight: 600;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.28);
}

/* 缓存 */
.dock-cache {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  flex: none;
}

.dock-cache-text {
  font-size: 20rpx;
  color: var(--text-muted);
}

.dock-cache-clean {
  min-height: 64rpx;
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--color-primary);
  padding: 0 0 0 16rpx;
}

.dock-tail {
  margin-top: 6rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-muted);
  flex: none;
}

/* ============================================================
   极简版：去掉抽屉内的卡片/胶囊框，只留图标、字号、颜色层级
   ============================================================ */

/* 右下角大音符：无实底，只有柔光和呼吸环。
   尺寸/安全位/玻璃底由文件末尾的覆盖块统一提供，这里只保留定位与居中。 */
.dock-fab {
  position: fixed;
  z-index: var(--z-fab, 40);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dock-fab::before {
  content: "";
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  top: 4rpx;
  bottom: 4rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(112, 108, 255, 0.3) 0%,
    rgba(80, 75, 200, 0.1) 52%,
    rgba(20, 20, 50, 0) 72%
  );
  filter: blur(10rpx);
  animation: fabGlow 4.5s var(--ease-gentle) infinite;
}

.dock-fab::after {
  content: "";
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 10rpx;
  bottom: 10rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(167, 164, 255, 0.22);
  animation: fabRing 4.5s var(--ease-gentle) infinite;
}

.dock-fab-glyph {
  position: relative;
  z-index: 1;
  font-family: var(--font-cn-serif);
  font-size: 54rpx;
  line-height: 1;
  color: rgba(240, 243, 255, 0.94);
  text-shadow:
    0 0 20rpx rgba(130, 125, 255, 0.6),
    0 4rpx 18rpx rgba(0, 0, 0, 0.45);
}

.dock-fab:active .dock-fab-glyph {
  transform: scale(0.9);
}

@keyframes fabGlow {
  0%, 100% { opacity: 0.6; transform: scale(0.94); }
  50% { opacity: 1; transform: scale(1.06); }
}

@keyframes fabRing {
  0%, 100% { opacity: 0.35; transform: scale(0.92); }
  50% { opacity: 0.8; transform: scale(1.04); }
}

/* 头部：一个简单音符 + 两级字号，不做圆形底 */
.dock-head-mark {
  width: 46rpx;
  flex: none;
  font-family: var(--font-cn-serif);
  font-size: 40rpx;
  line-height: 1;
  color: var(--color-primary-soft);
  text-shadow: 0 0 18rpx rgba(130, 125, 255, 0.45);
}

.dock-title {
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 关闭：无圆底，两根粗但收口的线 */
.dock-close {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex: none;
  padding: 0;
  border: none;
  background: transparent;
}

.dock-close::before,
.dock-close::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 32rpx;
  height: 3rpx;
  margin: -1.5rpx 0 0 -16rpx;
  border-radius: 2rpx;
  background: rgba(232, 238, 255, 0.8);
}

.dock-close::before {
  transform: rotate(45deg);
}

.dock-close::after {
  transform: rotate(-45deg);
}

/* 解锁状态：一行文字，不再有信息卡 */
.dock-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  padding: 0 4rpx;
  flex: none;
}

.dock-status-dot {
  width: 8rpx;
  height: 8rpx;
  flex: none;
  border-radius: 50%;
  background: var(--text-muted);
}

.dock-status-dot.is-on {
  background: var(--color-calm-teal);
  box-shadow: 0 0 12rpx rgba(45, 212, 191, 0.55);
}

.dock-status-text {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 搜索：底部一根细线 + 手绘放大镜 */
.dock-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 0 4rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  flex: none;
}

.dock-search-ico {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  flex: none;
  border: 2rpx solid rgba(220, 230, 255, 0.55);
  border-radius: 50%;
  box-sizing: border-box;
}

.dock-search-ico::after {
  content: "";
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: rgba(220, 230, 255, 0.55);
  transform: rotate(45deg);
}

.dock-input {
  flex: 1;
  height: 66rpx;
  padding: 0;
  border: none;
  background: transparent;
  font-size: 24rpx;
  color: var(--text-primary);
}

.dock-clear {
  position: static;
  width: 56rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 分类：纯文字 tab + 底部短横线 */
.dock-cats {
  height: 76rpx;
  margin-top: 18rpx;
}

.dock-cat-chips {
  gap: 36rpx;
  padding-right: 24rpx;
}

.dock-cat {
  position: relative;
  min-height: 76rpx;
  padding: 0;
  border: none;
  background: transparent;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  color: rgba(190, 205, 235, 0.62);
}

.dock-cat.cat-on {
  border: none;
  background: transparent;
  color: var(--text-primary);
  font-weight: 700;
}

.dock-cat.cat-on::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 28rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--color-primary-soft);
  transform: translateX(-50%);
}

/* 列表行：无卡片、无播放中底色，用图标色和字号区分 */
.dock-track {
  gap: 16rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
  background: transparent;
}

.dock-track.is-playing {
  background: transparent;
  border-radius: 0;
  border-bottom-color: rgba(255, 255, 255, 0.055);
  padding: 16rpx 4rpx;
}

.dock-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(167, 164, 255, 0.1);
}

.dock-icon {
  width: 42rpx;
  height: 42rpx;
}

.dock-icon-wrap.tone-teal { background: rgba(45, 212, 191, 0.12); }
.dock-icon-wrap.tone-blue { background: rgba(96, 165, 250, 0.12); }
.dock-icon-wrap.tone-amber { background: rgba(253, 230, 138, 0.12); }
.dock-icon-wrap.tone-violet { background: rgba(167, 164, 255, 0.12); }

.dock-tname {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.dock-tcat {
  flex: none;
  padding: 0;
  border: none;
  background: transparent;
  font-size: 17rpx;
  letter-spacing: 1rpx;
  color: var(--text-muted);
}

.dock-tcat.tone-teal { color: #5EEAD4; }
.dock-tcat.tone-blue { color: #93C5FD; }
.dock-tcat.tone-amber { color: var(--color-accent-moon, #FDE68A); }
.dock-tcat.tone-violet { color: #C4B5FD; }

.dock-tstate {
  font-size: 19rpx;
  color: var(--text-muted);
}

.dock-fav {
  width: 64rpx;
  min-height: 72rpx;
  font-size: 36rpx;
  line-height: 1;
  color: rgba(220, 230, 255, 0.48);
}

.dock-fav.is-on {
  color: var(--color-accent-moon, #FDE68A);
  text-shadow: 0 0 16rpx rgba(253, 230, 138, 0.4);
}

.dock-play {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 与迷你播放条右侧图标一致：只用粗符号，不加圆形描边框 */
  color: rgba(240, 243, 255, 0.9);
}



/* 列表主播放键：76rpx 视觉 + 6rpx 外扩 = 88rpx 热区，并补按压反馈 */
.dock-play::after {
  content: '';
  position: absolute;
  left: -6rpx;
  right: -6rpx;
  top: -6rpx;
  bottom: -6rpx;
}

.dock-play:active {
  transform: scale(0.94);
  opacity: 0.82;
}

.dock-play.is-pause {
  border-color: rgba(167, 164, 255, 0.45);
  color: var(--color-primary-soft);
}

.dock-play-ico {
  position: relative;
}

.dock-play-tri {
  width: 0;
  height: 0;
  margin-left: 5rpx;
  /* 去掉圆框后，三角形/双竖线要略大一点才撑得住识别度 */
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 20rpx solid currentColor;
}

.dock-play-pause {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.dock-play-bar {
  width: 4rpx;
  height: 24rpx;
  border-radius: 2rpx;
  background: currentColor;
}

/* 小节标题 */
.dock-section {
  margin-top: 20rpx;
  padding: 0 4rpx;
}

.dock-section-title {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--text-muted);
}

.dock-section-count {
  font-size: 17rpx;
  color: var(--text-muted);
}

/* 当前播放：一行，不做卡片 */
.dock-now {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  padding: 0 4rpx;
  border: none;
  background: transparent;
}

.dock-now-eq {
  width: 44rpx;
  height: 26rpx;
}

.dock-now-k {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: var(--text-muted);
}

.dock-now-title {
  font-size: 23rpx;
  color: var(--text-primary);
}

.dock-now-sub {
  font-size: 18rpx;
  color: var(--color-primary-soft);
}

/* 定时：与计算器「预计入睡耗时」同一套小胶囊，不再做整条深色轨道 */
.dock-timer {
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 0;
  border-top: none;
}

.dock-timer-seg {
  flex: 1;
  justify-content: flex-end;
  gap: 8rpx;
  padding: 0;
  border: none;
  background: transparent;
}

.dock-timer-chip {
  position: relative;
  flex: none;
  min-width: 76rpx;
  height: 44rpx;
  min-height: 44rpx;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: transparent !important;
  box-shadow: none !important;
  font-size: 23rpx;
  text-align: center;
  color: rgba(190, 204, 230, 0.7);
}

/* 44rpx 视觉 + 上下各 22rpx 外扩 = 88rpx 热区（档位横向间距小，只做纵向） */
.dock-timer-chip::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -22rpx;
  bottom: -22rpx;
}

.dock-timer-chip.is-on {
  color: #e9e7ff;
  font-weight: 500;
  background: rgba(150, 146, 255, 0.14) !important;
  box-shadow: inset 0 0 0 1rpx rgba(167, 164, 255, 0.3) !important;
}

/* 缓存与脚注：简单一行 */
.dock-cache {
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.dock-cache-text,
.dock-cache-clean,
.dock-tail {
  font-size: 18rpx;
  color: var(--text-muted);
}

.dock-cache-clean {
  padding-left: 12rpx;
  color: var(--color-primary-soft);
}

.dock-tail {
  margin-top: 4rpx;
}

/* ============================================================
   悬浮音符 / 绿色吸附音符 / 极简播放条
   ============================================================ */

/* 悬浮音符：页面主题深色 + 透明玻璃圆底，无边框、不描高光 */
.dock-fab {
  right: 26rpx;
  bottom: 24rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(8, 11, 20, 0.3);
  border: none;
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.2);
  animation: noteFloat 3.8s ease-in-out infinite;
}

.dock-fab::before,
.dock-fab::after {
  display: none;
}

.dock-fab-glyph {
  font-size: 66rpx;
  color: rgba(241, 245, 255, 0.94);
  text-shadow:
    0 0 22rpx rgba(140, 135, 255, 0.62),
    0 4rpx 16rpx rgba(0, 0, 0, 0.45);
}

/* 播放中收起：绿色音符吸附右侧，同为深色透明玻璃圆底，无边框 */
.dock-note {
  position: fixed;
  right: 26rpx;
  bottom: 24rpx;
  z-index: var(--z-fab, 40);
  width: 108rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(8, 11, 20, 0.3);
  border: none;
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.2);
  animation: noteFloat 3.4s ease-in-out infinite;
}

.dock-note-glyph {
  font-family: var(--font-cn-serif);
  font-size: 66rpx;
  line-height: 1;
  color: var(--color-calm-teal, #34D399);
  text-shadow:
    0 0 22rpx rgba(52, 211, 153, 0.55),
    0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  animation: dockNoteIn 0.18s ease-out;
}

/* 暂停后折叠：音符降亮度，避免误以为还在播 */
.dock-note.is-paused .dock-note-glyph {
  opacity: 0.58;
  text-shadow: none;
}

@keyframes dockNoteIn {
  from { opacity: 0; transform: scale(0.76); }
  to { opacity: 1; transform: scale(1); }
}

.dock-note:active .dock-note-glyph,
.dock-fab:active .dock-fab-glyph {
  transform: scale(0.9);
}

@keyframes noteFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-8rpx) scale(1.04); }
}

/* 展开播放器时点击外部：折叠回音符，不停止播放 */
/* 层级必须低于悬浮 tabBar(90)：否则展开迷你条后第一次点 tab 只会收起播放条，
   要把遮罩铺在 tabBar 之上。 */
.dock-collapse-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: var(--z-collapse-mask, 85);
  background: transparent;
}

/* 播放条：与 now-playing 共用宽度、右贴边、圆角和底部安全位；
   深色透明玻璃、无边框，与悬浮音符同一套质感 */
.dock-mini {
  left: auto;
  right: 0;
  bottom: 24rpx;
  width: 480rpx;
  max-width: calc(100% - 24rpx);
  min-height: 88rpx;
  padding: 14rpx 18rpx 14rpx 48rpx;
  border-radius: 999rpx 0 0 999rpx;
  border: none;
  background: rgba(8, 11, 20, 0.62);
  -webkit-backdrop-filter: blur(26rpx);
  backdrop-filter: blur(26rpx);
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.32);
  z-index: var(--z-player, 100);
}

.dock-mini .dock-pbar {
  width: 7rpx;
  height: 32rpx;
  border-radius: 2rpx;
}

/* 播放模式切换（单曲循环 / 收藏连播）：只在抽屉内出现，默认单曲 */
.dock-section-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dock-queue {
  position: relative;
  min-height: 60rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  font-size: 19rpx;
  color: rgba(190, 204, 230, 0.72);
  transition: background 0.16s ease, color 0.16s ease;
}

.dock-queue::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -16rpx;
  bottom: -16rpx;
}

.dock-queue.is-on {
  color: #e9e7ff;
  background: rgba(145, 175, 255, 0.16);
}

.dock-cache-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.dock-cache-tip {
  font-size: 18rpx;
  color: rgba(190, 204, 230, 0.5);
}

/* 继续上次：冷启动/重进小程序的一键续听入口 */
.dock-resume {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(145, 175, 255, 0.1);
  border: 1rpx solid rgba(145, 175, 255, 0.2);
}

.dock-resume-k {
  font-size: 20rpx;
  color: rgba(190, 204, 230, 0.7);
}

.dock-resume-v {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: rgba(233, 239, 255, 0.92);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dock-resume-arrow {
  font-size: 22rpx;
  color: var(--color-primary-soft);
}

.dock-resume--tap {
  background: rgba(145, 175, 255, 0.18);
}

/* 已缓存的曲目：可点的 ⤓ 标记（比"只能长按"更可发现） */
.dock-cached {
  position: relative;
  flex: none;
  width: 52rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 只留一个粗箭头：与播放/暂停图标同一套“无框、够粗、够简约”的语言 */
  color: rgba(110, 231, 183, 0.95);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.dock-cached::after {
  content: '';
  position: absolute;
  left: -14rpx;
  right: -14rpx;
  top: -14rpx;
  bottom: -14rpx;
}

.dock-cached:active {
  background: rgba(52, 211, 153, 0.14);
}


/* 老内核没有 flex gap：迷你条用相邻兄弟 margin 还原（iOS < 14.5 / 老安卓 X5） */
.dock-mini .dock-mini-ctrls {
  margin-left: 8rpx;
}

.dock-mini-status {
  margin-top: 6rpx;
}

.dock-mini-sep,
.dock-mini-cat {
  margin-left: 8rpx;
}

.dock-mini-sub,
.dock-mini-timer {
  margin-left: 10rpx;
}

.dock-mini-ctrls .dmc-btn + .dmc-btn {
  margin-left: 6rpx;
}

.dock-pbar + .dock-pbar {
  margin-left: 9rpx;
}
