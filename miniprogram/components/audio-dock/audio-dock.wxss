/* 悬浮声音入口 */
.dock-fab {
  position: fixed;
  right: 32rpx;
  bottom: 36rpx;
  z-index: 40;
  width: 116rpx;
  height: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  border-radius: 50%;
  border: 1rpx solid var(--border-glow);
  background: var(--glass-card-active);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.4);
  animation: dockFabIn 0.24s var(--ease-gentle);
}

@keyframes dockFabIn {
  from {
    opacity: 0;
    transform: scale(0.84);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.dock-fab:active {
  transform: scale(0.94);
}

.dock-fab-glyph {
  font-family: var(--font-cn-serif);
  font-size: 34rpx;
  line-height: 1;
  color: var(--color-accent-moon);
}

.dock-fab-label {
  font-family: var(--font-cn-serif);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--text-secondary);
}

/* 迷你播放器：常驻 DOM，用 class 切换展示/折叠，和跨页 now-playing 同款动效 */
.dock-mini {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 40;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 8rpx 14rpx 28rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  background: var(--glass-card-active);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  box-shadow: var(--shadow-moon);
  opacity: 0;
  transform: translate3d(0, 40rpx, 0) scale(0.96);
  transform-origin: 50% 100%;
  pointer-events: none;
  visibility: hidden;
  transition: transform 0.22s var(--ease-gentle), opacity 0.18s var(--ease-gentle),
    visibility 0s linear 0.24s;
}

.dock-mini.is-in {
  opacity: 1;
  transform: translate3d(0, 0, 0) scale(1);
  pointer-events: auto;
  visibility: visible;
  transition: transform 0.34s var(--ease-spring), opacity 0.22s var(--ease-gentle),
    visibility 0s linear 0s;
}

.dock-mini-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  border-radius: var(--radius-pill);
  transition: opacity 0.15s ease;
}

.dock-mini-main--tap {
  opacity: 0.68;
}

.dock-mini-line {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dock-mini-title {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  line-height: 1.2;
  color: var(--text-primary);
}

.dock-mini-sep,
.dock-mini-cat {
  flex: none;
  font-size: 21rpx;
  line-height: 1.2;
  color: var(--text-muted);
}

.dock-mini-status {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--text-muted);
  transition: color 0.2s ease;
}

.dock-mini-status.is-on {
  color: var(--color-primary);
}

.dock-mini-sub {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 20rpx;
  line-height: 1.2;
}

/* 跳动音符：本条唯一的均衡器，四根加高加粗、大摆幅 */
.dock-seq {
  display: flex;
  align-items: flex-end;
  height: 28rpx;
  flex: none;
}

.dock-sbar {
  width: 5rpx;
  margin-right: 3rpx;
  border-radius: 2.5rpx;
  background: currentColor;
  transform-origin: bottom;
  animation: dockSeq 0.9s ease-in-out infinite;
}

.ds-1 {
  height: 28rpx;
}

.ds-2 {
  height: 16rpx;
  animation-delay: 0.14s;
}

.ds-3 {
  height: 22rpx;
  animation-delay: 0.28s;
}

.ds-4 {
  height: 12rpx;
  animation-delay: 0.42s;
}

.dock-mini-status.is-off .dock-sbar,
.dock-mini.is-out .dock-sbar {
  animation-play-state: paused;
}

.dock-mini-status.is-off .dock-sbar {
  opacity: 0.42;
}

@keyframes dockSeq {
  0%, 100% {
    transform: scaleY(0.3);
  }
  50% {
    transform: scaleY(1);
  }
}

/* 右侧控制区：无底框纯图标，76rpx 命中区 + 伪元素扩到 88rpx */
.dock-mini-ctrls {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.dmc-btn {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.92);
  transition: opacity 0.12s ease, transform 0.12s ease;
}

/* 伪元素外扩 6rpx：视觉是纯图标，实际可点区域 88rpx */
.dmc-btn::after {
  content: "";
  position: absolute;
  left: -6rpx;
  right: -6rpx;
  top: -6rpx;
  bottom: -6rpx;
}

.dmc-btn:active,
.dmc-btn--tap {
  transform: scale(0.86);
  opacity: 0.55;
}

.dmc-x {
  color: rgba(255, 255, 255, 0.58);
}

/* 暂停态图标：两根细竖条（与 now-playing 同几何） */
.dock-ico-pause {
  display: flex;
  align-items: center;
  gap: 9rpx;
  height: 30rpx;
  animation: dockIconIn 0.16s var(--ease-gentle);
}

.dock-pbar {
  width: 6rpx;
  height: 30rpx;
  border-radius: 2rpx;
  background: currentColor;
}

/* 播放态图标：三角（margin 补偿视觉居中） */
.dock-ico-play {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 15rpx solid transparent;
  border-bottom: 15rpx solid transparent;
  border-left: 24rpx solid currentColor;
  animation: dockIconIn 0.16s var(--ease-gentle);
}

/* 关闭图标：细 ×，中心对齐 */
.dock-ico-x {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  animation: dockIconIn 0.16s var(--ease-gentle);
}

.dock-xbar {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 3rpx;
  height: 30rpx;
  margin: -15rpx 0 0 -1.5rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform-origin: 50% 50%;
}

@keyframes dockIconIn {
  from {
    opacity: 0;
    transform: scale(0.68);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.dx-a {
  transform: rotate(45deg);
}

.dx-b {
  transform: rotate(-45deg);
}

/* 遮罩与抽屉 */
.dock-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 180;
  background: transparent;
  pointer-events: none;
  transition: background 0.28s var(--ease-gentle);
}

.dock-mask.is-show {
  background: var(--scrim);
  pointer-events: auto;
}

.dock-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  height: 86vh;
  display: flex;
  flex-direction: column;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--glass-card-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border-top: 1.5rpx solid var(--border-moon-light);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  box-shadow: 0 -28rpx 90rpx rgba(0, 0, 0, 0.5);
  transform: translateY(104%);
  transition: transform 0.4s var(--ease-spring);
}

.dock-sheet.is-show {
  transform: translateY(0);
}

.dock-grip {
  width: 64rpx;
  height: 5rpx;
  margin: 0 auto 20rpx;
  border-radius: 3rpx;
  background: var(--border-moon-light);
  flex: none;
}

.dock-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: none;
}

.dock-title {
  font-size: 34rpx;
  color: var(--text-moon-pure);
}

.dock-close {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--glass-tint);
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 30rpx;
  color: var(--text-secondary);
}

/* 解锁条 */
.dock-unlock {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-glow);
  background: var(--glass-tint);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: none;
}

.du-main {
  font-size: 24rpx;
  color: var(--text-primary);
}

.du-sub {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 搜索 */
.dock-search {
  position: relative;
  margin-top: 18rpx;
  flex: none;
}

.dock-input {
  height: 76rpx;
  padding: 0 64rpx 0 26rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  background: var(--glass-tint);
  font-size: 24rpx;
  color: var(--text-primary);
}

.dock-ph {
  color: var(--text-muted);
}

.dock-clear {
  position: absolute;
  right: 8rpx;
  top: 0;
  width: 64rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 分类 */
.dock-cats {
  height: 80rpx;
  margin-top: 12rpx;
  white-space: nowrap;
  flex: none;
}

.dock-cat-chips {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 20rpx;
}

.dock-cat {
  min-height: 72rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  background: var(--glass-tint);
  font-size: 24rpx;
  color: var(--text-secondary);
}

.dock-cat.cat-on {
  border-color: var(--border-glow);
  background: var(--glass-card-active);
  color: var(--text-moon-pure);
}

/* 列表 */
.dock-list {
  flex: 1;
  min-height: 0;
  height: 0;
  margin-top: 8rpx;
}

/* 列表去盒：行间 hairline；播放中的行是唯一带色块的行 */
.dock-track {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.dock-track.is-playing {
  background: var(--glass-tint);
  border-radius: var(--radius-md);
  border-bottom-color: transparent;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.dock-track:active {
  transform: scale(0.99);
}

.dock-cat:active,
.dock-timer-chip:active,
.dock-fav:active,
.dock-cache-clean:active {
  opacity: 0.7;
}

.dock-icon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
}

.dock-tinfo {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.dock-tname-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dock-tname {
  font-size: 27rpx;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dock-tcat {
  flex: none;
  padding: 1rpx 10rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 16rpx;
  color: var(--text-muted);
}

.dock-tstate {
  font-size: 20rpx;
  color: var(--text-muted);
}

.dock-tbtn {
  flex: none;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 22rpx;
  color: var(--text-secondary);
}

.dock-fav {
  width: 64rpx;
  min-height: 72rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 32rpx;
  line-height: 1;
  color: var(--text-muted);
}

.dock-fav.is-on {
  color: var(--color-accent-moon);
  text-shadow: 0 0 18rpx rgba(253, 230, 138, 0.45);
}

.dock-tbtn.tb-on {
  border-color: var(--border-glow);
  color: var(--color-primary);
}

.dock-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 定时：左图标+文案，右侧等分胶囊分段（参考设计稿） */
.dock-timer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  flex: none;
}

.dock-timer-head {
  flex: none;
  display: flex;
  align-items: center;
  gap: 11rpx;
  min-width: 0;
}

/* 纯 CSS 秒表：表盘 + 顶部按钮 + 指针，笔画与图标参考图一致 */
.dock-timer-ico {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  flex: none;
  color: rgba(255, 255, 255, 0.64);
}

.dock-timer-ico::before {
  content: "";
  position: absolute;
  left: 4rpx;
  top: 7rpx;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.dock-timer-ico::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 1rpx;
  width: 14rpx;
  height: 3rpx;
  margin-left: -7rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.dock-timer-hand {
  position: absolute;
  left: 50%;
  top: 11rpx;
  width: 2rpx;
  height: 10rpx;
  margin-left: -1rpx;
  border-radius: 1rpx;
  background: currentColor;
  transform-origin: 50% 100%;
  transform: rotate(38deg);
}

.dock-timer-copy {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
  min-width: 0;
  max-width: 196rpx;
}

.dock-timer-label {
  font-size: 26rpx;
  line-height: 1.2;
  white-space: nowrap;
  color: var(--text-primary);
}

/* 运行中的剩余时间：与偏好档位区分，暂停时显示冻结的剩余 */
.dock-timer-live {
  font-size: 18rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--color-primary);
}

/* 深色轨道 + 等分分段，选中为浅紫药丸 */
.dock-timer-seg {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 5rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  background: rgba(0, 0, 0, 0.38);
}

.dock-timer-chip {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 2rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.56);
  transition: background 0.18s var(--ease-gentle), color 0.18s var(--ease-gentle),
    box-shadow 0.18s var(--ease-gentle);
}

/* 垂直扩 5rpx：视觉仍是 62rpx 药丸，实际可点 72rpx */
.dock-timer-chip::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -5rpx;
  bottom: -5rpx;
}

.dock-timer-chip--tap {
  opacity: 0.72;
}

.dock-timer-chip.is-on {
  background: #c9ccfa;
  color: #3f49bf;
  font-weight: 600;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.28);
}

/* 缓存 */
.dock-cache {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  flex: none;
}

.dock-cache-text {
  font-size: 20rpx;
  color: var(--text-muted);
}

.dock-cache-clean {
  min-height: 64rpx;
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--color-primary);
  padding: 0 0 0 16rpx;
}

.dock-tail {
  margin-top: 6rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-muted);
  flex: none;
}
