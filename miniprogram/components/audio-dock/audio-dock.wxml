<!-- 播放中展开态：点击外部只折叠回音符，不停止播放 -->
<view
  wx:if="{{currentId && miniExpanded && !collapsed && !open}}"
  class="dock-collapse-mask"
  bindtap="collapseMini"
  aria-hidden="true"
></view>

<!-- 空闲：右下角悬浮音符；播放中：绿色音符吸附右侧；展开后是迷你播放条 -->
<view
  wx:if="{{!currentId}}"
  class="dock-fab"
  bindtap="openSheet"
  aria-role="button"
  aria-label="打开环境声音"
>
  <text class="dock-fab-glyph" aria-hidden="true">♪</text>
</view>

<view
  wx:elif="{{!collapsed && (!playing || miniExpanded)}}"
  class="dock-mini is-in {{collapsing ? 'is-collapsing' : ''}}"
  bindtap="openSheet"
  aria-role="button"
  aria-label="打开环境声音"
>
  <view class="dock-mini-main" hover-class="dock-mini-main--tap" hover-stay-time="120">
    <view class="dock-mini-line">
      <text class="dock-mini-title">{{currentTitle}}</text>
      <block wx:if="{{currentCategory}}">
        <text class="dock-mini-sep">·</text>
        <text class="dock-mini-cat">{{currentCategory}}</text>
      </block>
    </view>
    <view class="dock-mini-status {{playing ? 'is-on' : 'is-off'}}">
      <view class="dock-seq" aria-hidden="true">
        <view class="dock-sbar ds-1"></view>
        <view class="dock-sbar ds-2"></view>
        <view class="dock-sbar ds-3"></view>
        <view class="dock-sbar ds-4"></view>
      </view>
      <text class="dock-mini-sub">{{loading ? '正在连接音频…' : (playerSub || (playing ? '正在播放' : '已暂停'))}}</text>
    </view>
  </view>
  <view class="dock-mini-ctrls">
    <view
      class="dmc-btn dock-toggle"
      catchtap="togglePlay"
      hover-class="dmc-btn--tap"
      hover-stay-time="100"
      aria-role="button"
      aria-label="{{playing ? '暂停' : '继续播放'}}"
    >
      <block wx:if="{{playing}}">
        <view class="dock-ico-pause">
          <view class="dock-pbar"></view>
          <view class="dock-pbar"></view>
        </view>
      </block>
      <block wx:else>
        <view class="dock-ico-play"></view>
      </block>
    </view>
  </view>
</view>

<view
  wx:else
  class="dock-note {{playing ? '' : 'is-paused'}}"
  bindtap="expandMini"
  aria-role="button"
  aria-label="展开播放条"
>
  <text class="dock-note-glyph" aria-hidden="true">♪</text>
</view>

<!-- 展开态：底部玻璃抽屉 -->
<view class="dock-mask {{open ? 'is-show' : ''}}" bindtap="closeSheet" catchtouchmove="noop"></view>

<view class="dock-sheet {{open ? 'is-show' : ''}} {{tracks.length <= 2 ? 'is-short' : ''}}">
  <view class="dock-grip" catchtouchmove="noop"></view>

  <view class="dock-head" catchtouchmove="noop">
    <view class="dock-head-copy">
      <view class="dock-head-mark">♫</view>
      <view class="dock-head-text">
        <text class="dock-title">环境声音</text>
      </view>
    </view>
    <text
      wx:if="{{currentId}}"
      class="dock-head-stop {{stopArmed ? 'is-armed' : ''}}"
      catchtap="requestStop"
      aria-role="button"
      aria-label="{{stopArmed ? '再点一次结束播放' : '结束播放'}}"
    >{{stopArmed ? '再点一次结束' : '结束播放'}}</text>
    <view class="dock-close" catchtap="closeSheet" aria-role="button" aria-label="关闭环境声音"></view>
  </view>

  <view wx:if="{{currentId}}" class="dock-now">
    <view class="dock-now-eq {{playing ? 'is-on' : 'is-off'}}">
      <view class="dock-sbar ds-1"></view>
      <view class="dock-sbar ds-2"></view>
      <view class="dock-sbar ds-3"></view>
      <view class="dock-sbar ds-4"></view>
    </view>
    <view class="dock-now-copy">
      <text class="dock-now-k">正在播放</text>
      <text class="dock-now-title">{{currentTitle}}</text>
    </view>
    <text class="dock-now-sub">{{loading ? '连接中…' : (playing ? '播放中' : '已暂停')}}</text>
  </view>

  <view wx:if="{{!freeMode}}" class="dock-status">
    <view class="dock-status-dot {{unlocked ? 'is-on' : ''}}"></view>
    <text wx:if="{{unlocked}}" class="dock-status-text">已解锁 · {{unlockRemainText}}</text>
    <text wx:else class="dock-status-text">轻触曲目，看一次视频解锁 {{unlockHours}} 小时</text>
  </view>

  <view class="dock-search" catchtouchmove="noop">
    <view class="dock-search-ico"></view>
    <input
      class="dock-input"
      value="{{keyword}}"
      placeholder="搜索：雨声 / 白噪音…"
      placeholder-class="dock-ph"
      confirm-type="search"
      adjust-position
      cursor-spacing="24"
      bindinput="onKeywordInput"
      bindconfirm="onSearchConfirm"
    />
    <view wx:if="{{keyword}}" class="dock-clear" bindtap="onClearKeyword">×</view>
  </view>

  <scroll-view class="dock-cats" scroll-x enhanced show-scrollbar="{{false}}" catchtouchmove="noop">
    <view class="dock-cat-chips">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="dock-cat {{activeCategory === item ? 'cat-on' : ''}}"
        data-cat="{{item}}"
        bindtap="onPickCategory"
      >{{item}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{resumeLabel}}" class="dock-resume" catchtap="onResumeLast" hover-class="dock-resume--tap" hover-stay-time="120">
    <text class="dock-resume-k">继续上次</text>
    <text class="dock-resume-v">{{resumeLabel}}</text>
    <text class="dock-resume-arrow">▶</text>
  </view>

  <view class="dock-section">
    <text class="dock-section-title">全部声音</text>
    <view class="dock-section-right">
      <view class="dock-queue {{queueMode === 'favorites' ? 'is-on' : ''}}" catchtap="onToggleQueueMode">
        {{queueMode === 'favorites' ? '🔁 收藏连播' : '🔂 单曲循环'}}
      </view>
      <text class="dock-section-count">{{filteredTracks.length}} 首</text>
    </view>
  </view>

  <scroll-view class="dock-list" scroll-y enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{filteredTracks}}"
      wx:key="id"
      class="dock-track {{currentId === item.id ? 'is-playing' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTrackTap"
      bindlongpress="onTrackLongPress"
    >
      <view class="dock-icon-wrap tone-{{item.tone}}">
        <image class="dock-icon" src="{{item.icon}}" mode="aspectFit" />
      </view>
      <view class="dock-tinfo">
        <view class="dock-tname-row">
          <text class="dock-tname">{{item.title}}</text>
          <text class="dock-tcat tone-{{item.tone}}">{{item.category}}</text>
          <view wx:if="{{currentId === item.id}}" class="dock-track-eq {{playing ? 'is-on' : ''}}">
            <view class="dock-eq-bar eq-1"></view>
            <view class="dock-eq-bar eq-2"></view>
            <view class="dock-eq-bar eq-3"></view>
          </view>
        </view>
        <text class="dock-tstate">{{currentId === item.id ? (loading ? '正在连接音频…' : (playing ? '播放中 · 点击暂停' : '已暂停 · 点击继续')) : (item.cached ? '已缓存 · 点击播放' : '点击播放')}}</text>
      </view>
      <view
        wx:if="{{item.cached && currentId !== item.id}}"
        class="dock-cached"
        data-id="{{item.id}}"
        catchtap="onRemoveCacheTap"
        aria-role="button"
        aria-label="删除这首的缓存"
      >↓</view>
      <view class="dock-fav {{item.favorite ? 'is-on' : ''}}" data-id="{{item.id}}" catchtap="onToggleFavorite">
        {{item.favorite ? '♥' : '♡'}}
      </view>
      <view class="dock-play {{currentId === item.id && playing ? 'is-pause' : ''}}" data-id="{{item.id}}" catchtap="onTrackTap" aria-role="button" aria-label="{{currentId === item.id && playing ? '暂停' : '播放'}}">
        <view wx:if="{{currentId === item.id && playing}}" class="dock-play-ico dock-play-pause">
          <view class="dock-play-bar"></view>
          <view class="dock-play-bar"></view>
        </view>
        <view wx:else class="dock-play-ico dock-play-tri"></view>
      </view>
    </view>
    <view wx:if="{{!filteredTracks.length}}" class="dock-empty">{{tracks.length ? '没有匹配的声音' : '正在加载声音…'}}</view>
  </scroll-view>

  <view wx:if="{{timerEnabled}}" class="dock-timer" catchtouchmove="noop">
    <view class="dock-timer-head">
      <view class="dock-timer-ico" aria-hidden="true">
        <view class="dock-timer-hand"></view>
      </view>
      <view class="dock-timer-copy">
        <text class="dock-timer-label">定时关闭</text>
        <text wx:if="{{timerRemainText}}" class="dock-timer-live">{{timerRemainText}}</text>
      </view>
    </view>
    <view class="dock-timer-seg" aria-role="radiogroup">
      <view
        wx:for="{{timerOptions}}"
        wx:key="value"
        class="dock-timer-chip {{timerMinutes === item.value ? 'is-on' : ''}}"
        data-value="{{item.value}}"
        bindtap="onTimerTap"
        hover-class="dock-timer-chip--tap"
        hover-stay-time="100"
        aria-role="radio"
        aria-checked="{{timerMinutes === item.value}}"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="dock-cache" catchtouchmove="noop">
    <view class="dock-cache-main">
      <text class="dock-cache-text">{{cacheText}}</text>
      <text class="dock-cache-tip">点曲目右侧 ⤓ 或长按，可只删除该曲缓存</text>
    </view>
    <text wx:if="{{cacheCount}}" class="dock-cache-clean" bindtap="onCleanCache">清理</text>
  </view>

  <view class="dock-tail" catchtouchmove="noop">锁屏后继续播放；定时到点自动停止</view>
</view>

<unlock-sheet
  show="{{sheetShow}}"
  title="{{unlockTitle}}"
  desc="{{unlocking && prepareText ? prepareText : unlockDesc}}"
  confirmText="{{unlockConfirm}}"
  cancelText="{{unlockCancel}}"
  loading="{{unlocking}}"
  bind:confirm="onSheetConfirm"
  bind:cancel="onSheetCancel"
/>
