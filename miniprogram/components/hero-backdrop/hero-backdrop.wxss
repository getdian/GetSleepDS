/* 与计算器页同一套 Hero 背景：顶部图片 + 向下渐隐，内容在其上 */
.hero-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  min-height: 560rpx;
  z-index: var(--z-hero, 0);
  overflow: hidden;
  pointer-events: none;
}

.hero-bg-img {
  display: block;
  width: 100%;
  height: auto;
}

.hero-bg-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* 唯一来源：app.wxss 的 --hero-scrim（与计算器页同一份，避免两页亮度不一致） */
  background: var(--hero-scrim);
}
