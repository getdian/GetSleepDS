.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-unlock, 300);
  display: flex;
  align-items: flex-end;
  background: transparent;
  pointer-events: none;
  transition: background 0.28s var(--ease-gentle);
}

.mask-on {
  /* 与 styles/sheet.wxss、background-picker 同一套遮罩：0.62 + blur 8 */
  background: rgba(4, 7, 15, 0.62);
  -webkit-backdrop-filter: blur(8rpx);
  backdrop-filter: blur(8rpx);
  pointer-events: auto;
}

.sheet {
  width: 100%;
  padding: 24rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  /* 底部弹层统一参数：36rpx 圆角 / 0.98 深底 */
  background: rgba(16, 22, 40, 0.98);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -24rpx 80rpx rgba(0, 0, 0, 0.45);
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity 0.28s var(--ease-gentle), transform 0.35s var(--ease-spring);
}

.sheet-on {
  opacity: 1;
  transform: translateY(0);
}

.sheet-bar {
  width: 64rpx;
  height: 5rpx;
  margin: 0 auto 30rpx;
  border-radius: 3rpx;
  background: var(--border-moon-light);
}

.sheet-title {
  display: block;
  font-family: var(--font-cn-serif);
  font-size: 36rpx;
  letter-spacing: 4rpx;
  color: var(--text-moon-pure);
}

.sheet-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.85;
  color: var(--text-secondary);
}

.sheet-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

.sheet-primary {
  margin-top: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  /* 与计算器/入睡页主按钮同一套：亮底深字，避免解锁面板出现“另一种紫” */
  background: var(--btn-primary-bg);
  color: var(--btn-primary-fg);
  font-weight: 600;
  box-shadow: var(--btn-primary-shadow);
}

.sheet-primary:active {
  transform: scale(0.98);
}

.sheet-loading {
  opacity: 0.6;
}

.sheet-ghost {
  margin-top: 16rpx;
  border: 1rpx solid var(--border-moon-subtle);
  background: var(--glass-tint);
  color: var(--text-secondary);
}
