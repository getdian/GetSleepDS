.ambient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  background:
    radial-gradient(95% 52% at 50% 0%, rgba(30, 41, 73, 0.72) 0%, rgba(12, 16, 29, 0) 66%),
    linear-gradient(180deg, #0B1020 0%, #080B14 58%, #070A11 100%);
}

/* 只保留一层极慢呼吸的月晕，避免星轨/光斑造成视觉噪声 */
.ambient__base {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(58% 38% at 78% 10%, rgba(129, 140, 248, 0.1), transparent 68%);
}

.ambient__glow {
  position: absolute;
  left: -18%;
  bottom: -32%;
  width: 136%;
  height: 82%;
  background: radial-gradient(46% 58% at 62% 44%, rgba(129, 140, 248, 0.1), transparent 72%);
  animation: glowBreathe 12s ease-in-out infinite alternate;
}

@keyframes glowBreathe {
  0% { opacity: 0.55; transform: scale(0.99); }
  100% { opacity: 0.9; transform: scale(1.02); }
}
