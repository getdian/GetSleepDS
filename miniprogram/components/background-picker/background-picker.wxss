.bp-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-sheet-mask, 180);
  background: rgba(4, 7, 16, 0.62);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.28s ease;
}

.bp-mask.is-show {
  opacity: 1;
  pointer-events: auto;
}

.bp-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-sheet, 200);
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 20rpx);
  border-radius: 36rpx 36rpx 0 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  background: #0D1428;
  transform: translateY(102%);
  transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.bp-sheet.is-show {
  transform: translateY(0);
}

.bp-grip {
  width: 72rpx;
  height: 6rpx;
  margin: 0 auto 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
}

.bp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx;
}

.bp-title {
  font-size: 30rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.94);
}

.bp-close {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.5);
}

.bp-cats {
  flex: none;
  padding: 4rpx 0 8rpx;
  white-space: nowrap;
}

.bp-cat-list {
  padding: 0 32rpx;
}

.bp-cat {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.62);
  background: rgba(255, 255, 255, 0.04);
}

.bp-cat.is-on {
  color: #FFFFFF;
  background: rgba(139, 135, 255, 0.25);
}

.bp-list {
  flex: 1;
  min-height: 0;
  height: 52vh;
  padding: 12rpx 32rpx 0;
}

.bp-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx;
  margin-bottom: 14rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  background: rgba(255, 255, 255, 0.035);
}

.bp-item:active,
.bp-cat:active {
  opacity: 0.72;
}

.bp-item.is-active {
  border-color: rgba(139, 135, 255, 0.55);
  background: rgba(139, 135, 255, 0.1);
}

/* 广告加载/下发期间：卡片暂不可点，视觉上明确“处理中” */
.bp-item.is-busy {
  opacity: 0.45;
}

.bp-img {
  width: 168rpx;
  height: 108rpx;
  flex: none;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.05);
}

.bp-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bp-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.94);
}

.bp-state {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.58);
}

.bp-badge {
  flex: none;
  min-height: 56rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.65);
  background: rgba(255, 255, 255, 0.06);
}

.bp-badge.is-on {
  color: #C9C6FF;
  background: rgba(139, 135, 255, 0.18);
}

.bp-check {
  flex: none;
  font-size: 20rpx;
  color: #A7A4FF;
}

.bp-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.36);
}

.bp-foot {
  flex: none;
  padding: 18rpx 32rpx 0;
  font-size: 20rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.52);
}
