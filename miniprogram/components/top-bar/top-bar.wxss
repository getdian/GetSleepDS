:host {
  display: block;
}

.topbar-spacer {
  width: 100%;
  pointer-events: none;
}

.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  width: 100%;
  background: transparent;
  pointer-events: none;
}

.topbar-glow {
  position: absolute;
  top: -40rpx;
  left: -60rpx;
  width: 520rpx;
  height: 220rpx;
  pointer-events: none;
  background: radial-gradient(50% 60% at 40% 50%, rgba(129, 140, 248, 0.16), transparent 72%);
  opacity: 0.75;
}

.topbar-row {
  position: relative;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  box-sizing: border-box;
}

/* 通栏灵动岛：从左侧安全边距一直延伸到微信胶囊前，四周仍完全透明 */
.island {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 10rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  background: rgba(20, 27, 45, 0.52);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.22);
  pointer-events: auto;
}

.island-orb {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-accent-moon);
  box-shadow: 0 0 18rpx var(--color-accent-moon);
}

.island-brand {
  font-family: var(--font-cn-serif);
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--text-secondary);
}

.island-sep {
  font-size: 18rpx;
  color: var(--text-muted);
}

.island-title {
  font-family: var(--font-cn-serif);
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--text-moon-pure);
}

/* 首页品牌模式：去掉胶囊实体，只留「☾ 睡点」，右侧交给微信原生胶囊 */
.island.is-brand-only {
  flex: none;
  padding: 0;
  border: none;
  background: transparent;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  box-shadow: none;
  pointer-events: none;
}

.island.is-brand-only .island-brand {
  font-family: var(--font-sans);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.92);
}

.island.is-brand-only .island-orb {
  box-shadow: 0 0 14rpx rgba(253, 230, 138, 0.55);
}
