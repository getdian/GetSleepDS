<view class="topbar-spacer" style="height:{{totalHeight}}px;"></view>
<view class="topbar" style="padding-top:{{statusBarHeight}}px;">
  <view class="topbar-glow"></view>
  <view class="topbar-row" style="height:{{navHeight}}px; padding-right:{{capsuleGap}}px;">
    <view class="island {{brandOnly ? 'is-brand-only' : ''}}">
      <view class="island-orb"></view>
      <text class="island-brand">睡点</text>
      <block wx:if="{{!brandOnly}}">
        <text class="island-sep">/</text>
        <text class="island-title">{{title}}</text>
      </block>
    </view>
  </view>
</view>
