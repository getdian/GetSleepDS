.tw {
  display: flex;
  align-items: stretch;
  gap: 4rpx;
  height: 440rpx;
  width: 100%;
}

.tw-cols {
  position: relative;
  flex: 1;
  height: 440rpx;
  overflow: hidden;
}

.tw-col {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  z-index: 1;
}

.tw-col-left {
  left: 0;
}

.tw-col-right {
  left: 50%;
}

.tw-scroll {
  width: 100%;
}

.tw-item {
  text-align: center;
  font-size: 31rpx;
  color: #94A3B8;
  color: var(--text-secondary, #94A3B8);
  opacity: 0.78;
  font-variant-numeric: tabular-nums;
  transition: color 0.2s ease, opacity 0.2s ease;
}

.tw-item.is-on {
  color: #F8FAFC;
  color: var(--text-moon-pure, #F8FAFC);
  opacity: 1;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.tw-colon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 34rpx;
  font-weight: 500;
  color: #94A3B8;
  color: var(--text-secondary, #94A3B8);
  opacity: 1;
  pointer-events: none;
  z-index: 4;
}

/* 上午 / 下午：文字切换，不再做成两个方块 */
.tw-period {
  width: 76rpx;
  height: 440rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  flex: none;
}

.tw-period-btn {
  position: relative;
  width: 100%;
  padding: 8rpx 0;
  text-align: center;
  color: var(--text-muted);
  font-size: 21rpx;
  letter-spacing: 1rpx;
  border-radius: var(--radius-pill);
  transition: color 0.2s ease, background 0.2s ease;
}

.tw-period-btn.is-on {
  color: var(--text-moon-pure);
  font-weight: 500;
  background: rgba(99, 102, 241, 0.2);
}
