.tw {
  display: flex;
  align-items: stretch;
  gap: 4rpx;
  height: 380rpx;
  width: 100%;
}

.tw-cols {
  position: relative;
  flex: 1;
  height: 380rpx;
  overflow: hidden;
}

.tw-col {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  z-index: 1;
}

.tw-col-left {
  left: 0;
}

.tw-col-right {
  left: 50%;
}

.tw-scroll {
  width: 100%;
}

.tw-item {
  text-align: center;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.48);
  font-variant-numeric: tabular-nums;
  transition: color 0.2s ease;
}

.tw-item.is-on {
  color: rgba(255, 255, 255, 0.96);
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 居中选中带：横向渐变高亮 + 极轻描边，时间像漂在一条光带上 */
.tw-band {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  border-radius: 18rpx;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.04) 0%,
    rgba(255, 255, 255, 0.1) 24%,
    rgba(255, 255, 255, 0.1) 76%,
    rgba(255, 255, 255, 0.04) 100%
  );
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  pointer-events: none;
}

.tw-colon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 40rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.62);
  opacity: 1;
  pointer-events: none;
  z-index: 4;
}

/* 上午 / 下午：竖排小胶囊组，选中项点亮为月光紫 */
.tw-period {
  width: 92rpx;
  height: 380rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  flex: none;
}

.tw-period-btn {
  position: relative;
  width: 100%;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.045);
  transition: color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.tw-period-btn.is-on {
  color: #FFFFFF;
  font-weight: 500;
  background: linear-gradient(135deg, #ABA8FF, #8B87FF);
  box-shadow: 0 6rpx 16rpx rgba(139, 135, 255, 0.32);
}
