.tw {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 380rpx;
  width: 100%;
}

.tw-cols {
  position: relative;
  flex: 1;
  height: 380rpx;
  overflow: hidden;
}

.tw-col {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  z-index: 1;
}

.tw-col-left {
  left: 0;
}

.tw-col-right {
  left: 50%;
}

.tw-scroll {
  width: 100%;
}

.tw-item {
  text-align: center;
  font-size: 38rpx;
  color: rgba(145, 170, 220, 0.5);
  font-variant-numeric: tabular-nums;
  transition: color 0.2s ease, font-size 0.2s ease;
}

.tw-item.is-on {
  color: #FFFFFF;
  font-size: 84rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 20rpx rgba(110, 150, 255, 0.35);
}

/* 居中选中带：横向渐变微光带 + 顶底微光线，两侧无缝渐隐 */
.tw-band {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(45, 70, 160, 0.15) 15%,
    rgba(65, 100, 220, 0.28) 50%,
    rgba(45, 70, 160, 0.15) 85%,
    transparent 100%
  );
  border-top: 1.5rpx solid rgba(135, 175, 250, 0.45);
  border-bottom: 1.5rpx solid rgba(135, 175, 250, 0.45);
  pointer-events: none;
}

.tw-colon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 52rpx;
  font-weight: 500;
  color: #FFFFFF;
  text-shadow: 0 2rpx 14rpx rgba(120, 150, 255, 0.4);
  pointer-events: none;
  z-index: 4;
}

/* 上午 / 下午：一体化竖排胶囊 */
.tw-period {
  width: 96rpx;
  height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx;
  box-sizing: border-box;
  flex: none;
  border-radius: 44rpx;
  background: rgba(18, 26, 56, 0.65);
  border: 1.5rpx solid rgba(255, 255, 255, 0.09);
  box-shadow: 0 6rpx 20rpx rgba(4, 8, 24, 0.4);
}

.tw-period-btn {
  position: relative;
  width: 100%;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  color: rgba(150, 175, 220, 0.65);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  border-radius: 34rpx;
  background: transparent;
  transition: color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.tw-period-btn.is-on {
  color: #FFFFFF;
  font-weight: 500;
  background: rgba(60, 75, 145, 0.8);
  box-shadow: 0 4rpx 14rpx rgba(20, 30, 80, 0.45);
}
