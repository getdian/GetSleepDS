.tw {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 420rpx;
  width: 100%;
}

.tw-cols {
  position: relative;
  flex: 1;
  height: 420rpx;
  overflow: hidden;
}

.tw-col {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  z-index: 1;
}

.tw-col-left {
  left: 0;
}

.tw-col-right {
  left: 50%;
}

.tw-scroll {
  width: 100%;
}

.tw-item {
  text-align: center;
  font-size: 38rpx;
  color: rgba(145, 170, 220, 0.45);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, "PingFang SC", sans-serif;
  font-variant-numeric: tabular-nums;
  transition: color 0.2s ease, font-size 0.2s ease;
}

.tw-item.is-on {
  color: #FFFFFF;
  font-size: 78rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-shadow: 0 4rpx 24rpx rgba(130, 165, 255, 0.45);
}

/* 居中选中带：精致圆润的微光玻璃胶囊，告别生硬贯穿横线 */
.tw-band {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  border-radius: 24rpx;
  background: linear-gradient(
    180deg,
    rgba(42, 64, 150, 0.28) 0%,
    rgba(30, 48, 120, 0.42) 100%
  );
  border: 1rpx solid rgba(135, 175, 255, 0.25);
  box-shadow: 0 6rpx 24rpx rgba(12, 22, 60, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
  pointer-events: none;
}

.tw-colon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 48rpx;
  font-weight: 400;
  color: #FFFFFF;
  text-shadow: 0 2rpx 14rpx rgba(135, 175, 255, 0.45);
  pointer-events: none;
  z-index: 4;
}

/* 上午 / 下午：一体化微光胶囊，大点击区 + 提升 3D 层级 */
.tw-period {
  position: relative;
  z-index: 10;
  width: 96rpx;
  height: 168rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx;
  box-sizing: border-box;
  flex: none;
  border-radius: 48rpx;
  background: rgba(18, 26, 56, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 6rpx 20rpx rgba(4, 8, 24, 0.45);
  transform: translateZ(5px);
  -webkit-transform: translateZ(5px);
  cursor: pointer;
}

.tw-period-btn {
  position: relative;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  color: rgba(150, 175, 220, 0.65);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  border-radius: 36rpx;
  background: transparent;
  transition: color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  cursor: pointer;
}

.tw-period-btn.is-on {
  color: #FFFFFF;
  font-weight: 500;
  background: rgba(65, 82, 160, 0.9);
  box-shadow: 0 4rpx 14rpx rgba(18, 28, 75, 0.5);
}
