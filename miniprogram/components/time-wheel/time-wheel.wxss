.tw {
  display: flex;
  align-items: stretch;
  gap: 4rpx;
  height: 380rpx;
  width: 100%;
}

.tw-cols {
  position: relative;
  flex: 1;
  height: 380rpx;
  overflow: hidden;
}

.tw-col {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  z-index: 1;
}

.tw-col-left {
  left: 0;
}

.tw-col-right {
  left: 50%;
}

.tw-scroll {
  width: 100%;
}

.tw-item {
  text-align: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.30);
  font-variant-numeric: tabular-nums;
  transition: color 0.2s ease;
}

.tw-item.is-on {
  color: rgba(255, 255, 255, 0.94);
  font-size: 64rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 居中状态条：只留极轻的底色，不再用上下描边 */
.tw-band {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.045);
  pointer-events: none;
}

.tw-colon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 36rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.55);
  opacity: 1;
  pointer-events: none;
  z-index: 4;
}

/* 上午 / 下午：文字切换，不再做成两个方块 */
.tw-period {
  width: 76rpx;
  height: 380rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  flex: none;
}

.tw-period-btn {
  position: relative;
  width: 100%;
  padding: 8rpx 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.36);
  font-size: 21rpx;
  letter-spacing: 1rpx;
  border-radius: 999rpx;
  transition: color 0.2s ease, background 0.2s ease;
}

.tw-period-btn.is-on {
  color: rgba(255, 255, 255, 0.94);
  font-weight: 500;
  background: rgba(139, 135, 255, 0.18);
}
