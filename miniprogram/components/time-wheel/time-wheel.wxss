.tw {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 420rpx;
  width: 100%;
}

.tw-cols {
  position: relative;
  flex: 1;
  height: 420rpx;
  overflow: hidden;
}

.tw-col {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  z-index: 1;
}

.tw-col-left {
  left: 0;
}

.tw-col-right {
  left: 50%;
}

.tw-scroll {
  width: 100%;
}

.tw-item {
  text-align: center;
  font-size: 38rpx;
  color: rgba(145, 170, 220, 0.45);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, "PingFang SC", sans-serif;
  font-variant-numeric: tabular-nums;
  transition: color 0.2s ease, font-size 0.2s ease;
}

.tw-item.is-on {
  color: #FFFFFF;
  font-size: 78rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-shadow: 0 4rpx 24rpx rgba(130, 165, 255, 0.45);
}

/* 居中选中带：极轻微全宽水平渐变，左右渐隐到透明，无边框无圆角 */
.tw-band {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  /* 光带只占行高的 68%，避免选中行背景块过厚 */
  transform: translateY(-50%) scaleY(0.68);
  z-index: 2;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(40, 60, 140, 0.18) 18%,
    rgba(50, 75, 165, 0.25) 50%,
    rgba(40, 60, 140, 0.18) 82%,
    transparent 100%
  );
  pointer-events: none;
}

.tw-colon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 48rpx;
  font-weight: 400;
  color: #FFFFFF;
  text-shadow: 0 2rpx 14rpx rgba(135, 175, 255, 0.45);
  pointer-events: none;
  z-index: 4;
}

/* 上午 / 下午：一体化分段胶囊，每段 44px 触控高度 */
.tw-period {
  position: relative;
  z-index: 10;
  width: 104rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx;
  box-sizing: border-box;
  flex: none;
  border-radius: 48rpx;
  overflow: hidden;
  background: rgba(18, 26, 56, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 6rpx 20rpx rgba(4, 8, 24, 0.45);
}

.tw-period-btn {
  position: relative;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: rgba(165, 190, 235, 0.72);
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  border-radius: 44rpx;
  background: transparent;
  transition: color 0.18s ease, background 0.18s ease;
  will-change: background;
}

.tw-period-btn.is-on {
  color: #FFFFFF;
  font-weight: 500;
  background: rgba(65, 82, 160, 0.9);
}
