.hm {
  width: 100%;
}

.hm-body {
  display: flex;
  align-items: stretch;
  justify-content: center;
}

/* 左侧固定星期标签：顶部先跳过月份行（28rpx）+ 其下边距（6rpx），与格子行对齐 */
.hm-weeks {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-right: 10rpx;
  padding-top: 34rpx;
}

.hm-week {
  width: 26rpx;
  /* 实际高度由 heatmap.wxml 的内联 style 跟随 cellSize；这里只是首帧兜底 */
  height: 26rpx;
  line-height: 26rpx;
  font-size: 16rpx;
  color: var(--text-muted);
  text-align: center;
}

.hm-scroll {
  flex: 0 1 auto;
  min-width: 0;
}

.hm-inner {
  display: inline-block;
  padding-bottom: 4rpx;
}

.hm-months {
  display: grid;
  gap: 4rpx;
  height: 28rpx;
  margin-bottom: 6rpx;
}

.hm-month {
  grid-row: 1;
  font-size: 16rpx;
  color: var(--text-muted);
  white-space: nowrap;
  line-height: 1;
}

.hm-grid {
  display: grid;
  grid-auto-flow: column;
  gap: 4rpx;
}

/* 宽高由 grid track 决定（wxml 内联 template），格子自身只负责填满 */
.hm-cell {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  background: var(--heat-0);
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.hm-cell:active {
  transform: scale(0.92);
  opacity: 0.75;
}

.hm-pad {
  background: transparent;
}

.hm-l1 { background: var(--heat-1); }
.hm-l2 { background: var(--heat-2); }
.hm-l3 { background: var(--heat-3); }
.hm-l4 { background: var(--heat-4); }
.hm-l5 { background: var(--heat-5); }

.hm-partial {
  background: transparent;
  border: 1.5rpx solid var(--border-glow);
}

.hm-today {
  box-shadow: 0 0 0 2rpx var(--border-moon-light);
}

/* 未来占位：淡填充 + 可见虚线轮廓，与“未打卡”的实心空格明确区分 */
.hm-future {
  background: rgba(148, 163, 184, 0.03);
  border: 1rpx dashed rgba(148, 163, 184, 0.32);
  opacity: 1;
}




