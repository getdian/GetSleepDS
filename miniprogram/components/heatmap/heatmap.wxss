.hm {
  width: 100%;
}

.hm-scroll {
  width: 100%;
}

.hm-inner {
  display: inline-block;
  padding-bottom: 4rpx;
}

.hm-months {
  display: grid;
  gap: 8rpx;
  height: 32rpx;
  margin-bottom: 8rpx;
}

.hm-month {
  grid-row: 1;
  font-size: 18rpx;
  color: var(--text-muted);
  white-space: nowrap;
  line-height: 1;
}

.hm-grid {
  display: grid;
  grid-template-rows: repeat(7, 56rpx);
  grid-auto-flow: column;
  gap: 8rpx;
}

.hm-cell {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--border-moon-subtle);
  background: var(--heat-0);
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.hm-cell:active {
  transform: scale(0.92);
  opacity: 0.75;
}

.hm-pad {
  background: transparent;
  border-color: transparent;
}

.hm-l1 { background: var(--heat-1); border-color: rgba(129, 140, 248, 0.12); }
.hm-l2 { background: var(--heat-2); border-color: rgba(129, 140, 248, 0.16); }
.hm-l3 { background: var(--heat-3); border-color: rgba(129, 140, 248, 0.2); }
.hm-l4 { background: var(--heat-4); border-color: rgba(165, 180, 252, 0.24); }
.hm-l5 { background: var(--heat-5); border-color: rgba(196, 181, 253, 0.28); }

.hm-partial {
  background: transparent;
  border: 1.5rpx solid var(--border-glow);
}

.hm-today {
  box-shadow: 0 0 0 2rpx var(--border-moon-light);
}

.hm-legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 18rpx;
}

.hm-legend-text {
  font-size: 18rpx;
  color: var(--text-muted);
}

.hm-legend-cell {
  width: 18rpx;
  height: 18rpx;
  border-radius: 5rpx;
}

.hm-legend-partial {
  margin-left: auto;
  font-size: 18rpx;
  color: var(--text-muted);
}
