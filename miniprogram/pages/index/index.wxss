/* 首页局部设计 token：只作用于计算器页，不改其他页面的全局色板 */
.calc-page {
  --c-primary: #8B87FF;
  --c-primary-soft: #A7A4FF;
  --c-text: rgba(255, 255, 255, 0.94);
  --c-text-2: rgba(255, 255, 255, 0.62);
  --c-text-3: rgba(255, 255, 255, 0.36);
  --c-border: rgba(255, 255, 255, 0.07);
  position: relative;
  z-index: 1;
  padding-top: 8rpx;
}

/* Hero 背景图：从状态栏后开始，底部渐隐到现有夜色 */
/* 高度跟随图片：按宽度等比显示，整张图完整可见，不做裁切 */
.hero-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  min-height: 560rpx;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.hero-bg-img {
  display: block;
  width: 100%;
  height: auto;
}

.hero-bg-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    180deg,
    rgba(8, 13, 29, 0.1) 0%,
    rgba(8, 13, 29, 0.42) 52%,
    #080B14 100%
  );
}

/* 标题区 */
.calc-hero {
  position: relative;
  padding: 16rpx 8rpx 0;
  margin-bottom: 24rpx;
}

.hero-title {
  display: block;
  font-family: var(--font-sans);
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.18;
  letter-spacing: 1rpx;
  color: var(--c-text);
}

.hero-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--c-text-2);
}

.hero-tools {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.hero-bg-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  font-size: 20rpx;
  color: var(--c-text-2);
}

.hero-bg-btn:active {
  opacity: 0.7;
}

.hero-bg-arrow {
  color: var(--c-primary-soft);
}

/* 3D 单卡：只翻转计算区域 */
.calc-stage {
  perspective: 1600rpx;
}

.calc-flip {
  position: relative;
  height: 820rpx;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.calc-flip.is-flipped {
  transform: rotateY(180deg);
}

.calc-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 34rpx 30rpx 28rpx;
  border-radius: 36rpx;
  border: 1rpx solid var(--c-border);
  background: rgba(13, 20, 40, 0.66);
  -webkit-backdrop-filter: blur(22rpx);
  backdrop-filter: blur(22rpx);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

.calc-front {
  justify-content: flex-start;
  pointer-events: auto;
}

.calc-flip.is-flipped .calc-front {
  pointer-events: none;
}

.calc-back {
  transform: rotateY(180deg);
  pointer-events: none;
}

.calc-flip.is-flipped .calc-back {
  pointer-events: auto;
}

/* 模式切换：一个轻 pill，而不是传统 Segmented Control */
.mode-switch {
  align-self: center;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(139, 135, 255, 0.14);
}

.mode-switch:active {
  opacity: 0.8;
}

.mode-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--c-text);
}

.mode-arrow {
  font-size: 22rpx;
  color: var(--c-primary-soft);
}

/* 时间轮：不套厚边框，让时间漂浮在夜色里 */
.wheel-frame {
  margin-top: 16rpx;
}

.now-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 8rpx 0;
}

.now-hint {
  font-size: 18rpx;
  color: var(--c-text-3);
}

.now-link {
  padding: 4rpx 0;
  font-size: 20rpx;
  color: var(--c-primary-soft);
}

/* 入睡耗时 */
.fall-block {
  margin-top: 18rpx;
}

.fall-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 21rpx;
  color: var(--c-text-2);
}

.fall-chips {
  display: flex;
  gap: 12rpx;
}

.fall-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  height: 64rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--c-text-3);
  background: rgba(255, 255, 255, 0.035);
  transition: color 0.2s ease, background 0.2s ease;
}

.fall-chip.is-on {
  color: #FFFFFF;
  background: rgba(139, 135, 255, 0.26);
}

.fall-unit {
  font-size: 18rpx;
}

/* 主按钮 */
.calc-action {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  height: 108rpx;
  border-radius: 30rpx;
  background: var(--c-primary);
  color: #0B102D;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.calc-action:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.action-arrow {
  font-size: 28rpx;
}

/* 结果面 */
.result-label {
  display: block;
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: var(--c-text-2);
}

.result-main {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 10rpx;
  padding-left: 18rpx;
  border-left: 4rpx solid var(--c-primary);
}

.result-day {
  font-size: 20rpx;
  color: var(--c-primary-soft);
}

.result-time {
  font-family: var(--font-sans);
  font-size: 96rpx;
  font-weight: 300;
  line-height: 1.05;
  letter-spacing: 0;
  color: var(--c-text);
  font-variant-numeric: tabular-nums;
}

.result-time.is-compact {
  font-size: 54rpx;
}

.result-meta {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--c-text-2);
}

.result-note {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--c-text-3);
}

.result-list {
  margin-top: 18rpx;
  border-top: 1rpx solid var(--c-border);
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 18rpx 2rpx;
  border-bottom: 1rpx solid var(--c-border);
}

.result-row.is-passed {
  opacity: 0.36;
}

.result-row-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.result-row-day {
  font-size: 16rpx;
  color: var(--c-text-3);
}

.result-row-time {
  font-size: 34rpx;
  color: var(--c-text-2);
  font-variant-numeric: tabular-nums;
}

.result-row-tag {
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--c-border);
  font-size: 15rpx;
  color: var(--c-text-3);
}

.result-row-meta {
  font-size: 18rpx;
  color: var(--c-text-3);
}

.result-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 18rpx;
}

.result-reset {
  padding: 10rpx 0;
  font-size: 22rpx;
  color: var(--c-text-2);
}

.result-switch {
  font-size: 20rpx;
  color: var(--c-primary-soft);
}

.result-share {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

/* 脚注 */
.calc-note {
  margin-top: 24rpx;
  padding: 0 18rpx;
  text-align: center;
  font-size: 18rpx;
  line-height: 1.9;
  color: var(--c-text-3);
}
