/* 首页局部设计 token：只作用于计算器页，不改其他页面的全局色板 */
.calc-page {
  --c-primary: #8B87FF;
  /* 与全局 --color-primary-soft 同值：本页历史上自建过一套局部 token，
     保留变量名兼容既有引用，值必须与 app.wxss 保持一致 */
  --c-primary-soft: var(--color-primary-soft, #A7A4FF);
  --c-text: rgba(255, 255, 255, 0.96);
  --c-text-2: rgba(255, 255, 255, 0.72);
  --c-text-3: rgba(255, 255, 255, 0.52);
  --c-border: rgba(255, 255, 255, 0.07);
  position: relative;
  z-index: var(--z-page, 1);
  padding-top: 8rpx;
}

/* Hero 背景图：从状态栏后开始，底部渐隐到现有夜色 */
/* 高度跟随图片：按宽度等比显示，整张图完整可见，不做裁切 */
.hero-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  min-height: 560rpx;
  z-index: var(--z-hero, 0);
  overflow: hidden;
  pointer-events: none;
}

.hero-bg-img {
  display: block;
  width: 100%;
  height: auto;
}

.hero-bg-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* 后台可能上传亮图：整体压暗，保证状态栏、标题、时间轮在图上仍可读。
     与 hero-backdrop 组件共用 app.wxss 的 --hero-scrim，避免两页亮度不一致。 */
  background: var(--hero-scrim);
}

/* 标题区 */
.calc-hero {
  position: relative;
  padding: 16rpx 8rpx 0;
  margin-bottom: 28rpx;
}

.hero-title {
  display: block;
  /* 给右上角“换背景”留出安全距离，320 宽也不挤字 */
  padding-right: 148rpx;
  font-family: var(--font-sans);
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: 2rpx;
  color: #FFFFFF;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.5);
}

.hero-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(220, 230, 255, 0.78);
}

.hero-tools {
  position: absolute;
  right: 8rpx;
  top: 24rpx;
}

.hero-bg-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(8, 11, 20, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(12rpx);
}

/* 视觉更小，实际可点区域仍补到约 72rpx */
.hero-bg-btn::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -8rpx;
  bottom: -8rpx;
}

.hero-bg-btn:active {
  opacity: 0.7;
}

.hero-bg-arrow {
  color: var(--c-primary-soft);
}

/* 极简无框外壳：去掉边框和厚重背景，让时钟滚轮自然漂浮在夜空中 */
.calc-card-wrap {
  position: relative;
  width: 100%;
}

.calc-card {
  position: relative;
  padding: 10rpx 4rpx 20rpx;
  background: transparent;
  border: none;
  box-shadow: none;
}

/* 模式切换：一体化极简胶囊 */
.mode-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.mode-capsule {
  display: inline-flex;
  align-items: center;
  height: 88rpx;
  padding: 6rpx 14rpx 6rpx 6rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(18, 26, 56, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  box-shadow: 0 6rpx 20rpx rgba(4, 8, 24, 0.35);
  transition: opacity 0.16s ease;
}

.mode-capsule:active {
  opacity: 0.82;
}

.mode-pill-active {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 76rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(60, 75, 145, 0.85);
  box-shadow: 0 4rpx 12rpx rgba(20, 30, 80, 0.4);
}

.mode-ico {
  font-size: 26rpx;
  line-height: 1;
  color: #FFFFFF;
}

.mode-text {
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  color: #FFFFFF;
}

.mode-swap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-left: 8rpx;
}

.mode-swap-ico {
  font-size: 28rpx;
  line-height: 1;
  color: rgba(180, 205, 250, 0.75);
}

/* 3D 翻转舞台与卡片：完全消除抖动与穿透 */
.calc-stage {
  position: relative;
  /* 不在正面常驻 perspective：即使没有 rotate，3D 透视也会让
     scroll-view/上午下午的 tap 命中偏移。透视只放在翻转时的 transform 里。 */
  width: 100%;
  /* 舞台高度同时决定正/背面：正面主按钮靠 margin-top:auto 贴底，
     缩短舞台 = 按钮上移 + 整张卡片变矮。背面结果内容需放得下。 */
  height: 712rpx;
}

.calc-flip {
  position: relative;
  width: 100%;
  height: 100%;
  /* 正面不进入 3D 上下文：scroll-view/按钮在 preserve-3d 下会出现
     开发者工具里点不中、滚不动的问题。只有翻到背面时才启用 3D。 */
  transform-style: flat;
  -webkit-transform-style: flat;
  transition: transform 0.6s cubic-bezier(0.4, 0.0, 0.2, 1);
  -webkit-transition: -webkit-transform 0.6s cubic-bezier(0.4, 0.0, 0.2, 1);
  will-change: transform;
}

.calc-flip.is-flipped {
  transform: perspective(1600rpx) rotateY(180deg);
  -webkit-transform: perspective(1600rpx) rotateY(180deg);
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
}

.calc-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.calc-front {
  /* 不要 translateZ：正面内容层的原生 scroll-view 会因此产生点击偏移 */
  transform: none;
  -webkit-transform: none;
  z-index: 2;
  pointer-events: auto;
  visibility: visible;
  transition: visibility 0s linear 0.3s;
}

.calc-flip.is-flipped .calc-front {
  visibility: hidden;
  pointer-events: none;
  transition: visibility 0s linear 0.3s;
}

.calc-back {
  transform: rotateY(180deg);
  -webkit-transform: rotateY(180deg);
  z-index: 1;
  pointer-events: none;
  visibility: hidden;
  transition: visibility 0s linear 0.3s;
  padding: 0 12rpx;
}

.calc-flip.is-flipped .calc-back {
  visibility: visible;
  pointer-events: auto;
  z-index: 2;
  transition: visibility 0s linear 0.3s;
}

/* 时间轮：自然漂浮在夜色里 */
.wheel-frame {
  margin-top: 6rpx;
}

.now-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14rpx;
}

.now-hint {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: var(--c-text-3);
}

.now-link {
  flex: none;
  min-height: 64rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 12rpx;
  font-size: 24rpx;
  color: var(--c-primary-soft);
}

.now-link:active {
  opacity: 0.68;
}

/* 选择起床时间时只隐藏动作，保留行高，避免切模式时把下面的耗时档位顶下去 */
.now-link.is-hidden {
  visibility: hidden;
  pointer-events: none;
}

/* 入睡耗时：标签与档位同一行，档位靠右 */
.fall-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 10rpx;
  padding: 0 12rpx;
}

.fall-head {
  flex: none;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 极简 CSS 时钟图标 */
.fall-ico {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2.5rpx solid rgba(150, 175, 235, 0.85);
}

.fall-ico::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2rpx;
  height: 7rpx;
  background: rgba(150, 175, 235, 0.9);
  transform: translate(-50%, -100%);
  border-radius: 2rpx;
}

.fall-ico::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 5rpx;
  height: 2rpx;
  background: rgba(150, 175, 235, 0.9);
  transform: translate(0, -50%);
  border-radius: 2rpx;
}

.fall-label {
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 500;
  color: rgba(190, 210, 245, 0.78);
}

.fall-chips {
  flex: none;
  display: flex;
  gap: 8rpx;
}

/* 未选中的档位只显示文字，不画底框；选中项才是一枚小标签 */
.fall-chip {
  position: relative;
  flex: none;
  width: 72rpx;
  height: 44rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  border-radius: 999rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, sans-serif;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1;
  color: rgba(170, 186, 215, 0.55);
  background: transparent;
  transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
}

/* 垂直扩 14rpx：视觉只有 44rpx 高的小标签，实际可点 72rpx */
.fall-chip::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -14rpx;
  bottom: -14rpx;
}

.fall-chip--tap {
  opacity: 0.7;
}

.fall-chip.is-on {
  color: #e9e7ff;
  font-weight: 500;
  background: rgba(150, 146, 255, 0.14);
  box-shadow: inset 0 0 0 1rpx rgba(167, 164, 255, 0.3);
}

.fall-unit {
  font-size: 18rpx;
  margin-left: 1rpx;
  opacity: 0.72;
}

/* 主按钮：参考效果图的平滑长药丸 + 深靛蓝文字 */
.calc-action {
  margin-top: auto;
  min-height: 104rpx;
  margin-left: 12rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 104rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8E98FF 0%, #707DEB 100%);
  color: #141B45;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 14rpx 36rpx rgba(118, 131, 251, 0.35);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.calc-action:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.action-arrow {
  font-size: 32rpx;
  font-weight: 600;
  color: #141B45;
}


/* 结果面：与参考图设计完全对齐 */
.result-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
  margin-bottom: 18rpx;
}

.result-moon {
  font-size: 28rpx;
  line-height: 1;
}

.result-label {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #FFFFFF;
}

/* 第一推荐大卡片：与参考图一致的微光容器 */
.result-main {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, rgba(65, 85, 175, 0.35) 0%, rgba(45, 60, 130, 0.25) 100%);
  border: 1.5rpx solid rgba(140, 175, 255, 0.3);
  box-shadow: 0 8rpx 28rpx rgba(15, 25, 70, 0.4);
  margin-bottom: 16rpx;
}

.result-bar {
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 8rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: #818CF8;
  box-shadow: 0 0 16rpx rgba(129, 140, 248, 0.85);
}

.result-body {
  flex: 1;
  min-width: 0;
  padding-left: 14rpx;
}

.result-line {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  white-space: nowrap;
  flex-wrap: nowrap;
}

.result-day {
  font-size: 20rpx;
  color: var(--c-primary-soft);
  flex-shrink: 0;
}

.result-time {
  font-family: var(--font-sans);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: 1rpx;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.result-time.is-compact {
  font-size: 44rpx;
  font-weight: 600;
}

.result-dot {
  font-size: 22rpx;
  color: rgba(180, 200, 240, 0.6);
  flex-shrink: 0;
}

.result-meta-inline {
  font-size: 22rpx;
  color: rgba(205, 220, 255, 0.85);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.result-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: rgba(200, 215, 250, 0.8);
}

.result-note {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(185, 205, 240, 0.72);
}

.result-badge {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(120, 120, 250, 0.5), rgba(90, 95, 240, 0.4));
  border: 1rpx solid rgba(170, 185, 255, 0.45);
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 14rpx rgba(100, 110, 250, 0.35);
}

.result-badge-star {
  font-size: 19rpx;
  color: #FFFFFF;
}

/* 时长护栏：偏短用琥珀，不足用柔红，避免与“推荐”紫色混淆 */
.result-badge.guide-short {
  background: rgba(245, 194, 107, 0.14);
  border-color: rgba(245, 194, 107, 0.4);
  color: #f5c26b;
  box-shadow: none;
}

.result-badge.guide-low {
  background: rgba(248, 113, 113, 0.14);
  border-color: rgba(248, 113, 113, 0.4);
  color: #fca5a5;
  box-shadow: none;
}

/* 后续推荐行列表 */
.result-list {
  display: flex;
  flex-direction: column;
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.result-row:last-child {
  border-bottom: none;
}

.result-row.is-passed {
  opacity: 0.38;
}

.result-row-left {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.result-row-day {
  font-size: 20rpx;
  color: rgba(160, 180, 225, 0.65);
}

.result-row-time {
  font-size: 38rpx;
  font-weight: 600;
  color: rgba(230, 240, 255, 0.95);
  font-variant-numeric: tabular-nums;
}

.result-row-tag {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  font-size: 19rpx;
  color: rgba(205, 220, 250, 0.72);
}

.result-row-right {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.result-row-dot {
  flex: none;
  font-size: 22rpx;
  color: rgba(160, 180, 225, 0.5);
}

.result-row-meta {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 23rpx;
  color: rgba(185, 205, 240, 0.8);
}

.result-row-guide {
  flex: none;
  font-size: 21rpx;
  font-weight: 500;
  white-space: nowrap;
}

.result-row-guide.guide-ok {
  color: rgba(167, 164, 255, 0.9);
}

.result-row-guide.guide-short {
  color: #f5c26b;
}

.result-row-guide.guide-low {
  color: #fca5a5;
}

.result-fall {
  margin-left: auto;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(145, 175, 255, 0.22);
  background: rgba(30, 45, 90, 0.35);
  color: var(--c-primary-soft);
  font-size: 20rpx;
}

.result-fall:active {
  opacity: 0.72;
}

.result-fall-swap {
  font-size: 22rpx;
}

.result-extra {
  margin-top: 14rpx;
  padding: 0 4rpx;
}

.result-go {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 80rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(145, 175, 255, 0.3);
  background: rgba(34, 48, 96, 0.45);
  color: var(--c-primary-soft);
  font-size: 26rpx;
  font-weight: 500;
}

.result-go:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.result-go-arrow {
  font-size: 28rpx;
}

.result-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 8rpx;
}

.result-reset,
.result-switch {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  font-weight: 500;
}

.result-reset {
  font-size: 26rpx;
  color: rgba(220, 235, 255, 0.9);
}

.result-switch {
  font-size: 24rpx;
  color: var(--c-primary-soft);
}

.result-action:active,
.result-reset:active,
.result-switch:active {
  opacity: 0.72;
}

.result-share {
  display: flex;
  justify-content: center;
  margin-top: 4rpx;
}

/* 全部周期都已错过（view.compact）时结果多一行，压缩纵向节奏，
   保证内容仍落在翻转舞台内，不会压到脚注 */
.calc-back.is-compact .result-head {
  margin-bottom: 12rpx;
}

.calc-back.is-compact .result-main {
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.calc-back.is-compact .result-row {
  padding: 10rpx 8rpx;
}

.calc-back.is-compact .result-extra {
  margin-top: 10rpx;
}

.calc-back.is-compact .result-go {
  margin-top: 8rpx;
}

/* 320 宽小屏：隐藏推荐徽标，让主时间与 meta 有空间 */
@media (max-width: 360px) {
  .result-badge {
    display: none;
  }

  .hero-title {
    font-size: 64rpx;
    padding-right: 132rpx;
  }

  .result-line {
    flex-wrap: wrap;
  }

  .result-meta-inline {
    white-space: normal;
  }
}

/* 跨页播放器宿主：压在页面内容之上，否则音符/播放条会被底部主按钮拦截点击 */
.np-host {
  position: relative;
  z-index: var(--z-player-host, 120);
}

/* 脚注 */
.calc-note {
  margin-top: 24rpx;
  padding: 0 18rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.9;
  color: var(--c-text-3);
}
