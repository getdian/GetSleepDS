.calc-page {
  padding-top: 16rpx;
}

.calc-hero {
  margin-bottom: 24rpx;
}

.calc-hero .title-xl {
  margin-top: 8rpx;
}

.calc-hero .sub {
  margin-top: 10rpx;
}

/* 入睡耗时 */
.fall-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 6rpx 8rpx 6rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: var(--radius-pill);
  background: rgba(20, 27, 45, 0.46);
}

.fall-label {
  flex: none;
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

.fall-chips {
  display: flex;
  gap: 2rpx;
}

.fall-chip {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
  transition: color 0.2s ease, background 0.2s ease;
}

.fall-unit {
  font-size: 17rpx;
}

.fall-chip.is-on {
  color: var(--text-moon-pure);
  background: #6366F1;
}

/* 计算区：标题与按钮都在框外，边框只框住滑轮 */
.calc-card {
  margin-top: 28rpx;
}

.calc-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 6rpx 20rpx;
}

.calc-head:active {
  opacity: 0.82;
}

.calc-glyph-wrap {
  width: 58rpx;
  height: 58rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.055);
}

.calc-glyph-wrap.is-sleep {
  background: rgba(45, 212, 191, 0.08);
}

.calc-glyph {
  font-family: var(--font-cn-serif);
  font-size: 25rpx;
  color: var(--color-accent-moon);
}

.calc-glyph-wrap.is-sleep .calc-glyph {
  color: #6EE7D8;
}

.calc-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 1rpx;
}

.calc-question {
  font-family: var(--font-sans);
  font-size: 29rpx;
  font-weight: 500;
  letter-spacing: 0;
  color: var(--text-primary);
}

.calc-sub {
  font-size: 18rpx;
  color: var(--text-muted);
}

.calc-time {
  margin-top: 3rpx;
  font-size: 40rpx;
  font-weight: 300;
  letter-spacing: 1rpx;
  color: var(--text-moon-pure);
  font-variant-numeric: tabular-nums;
}

.calc-toggle {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 300;
  color: var(--text-muted);
}

/* 边框只框滑轮：与「入睡需要」条同款视觉（月影描边 + 夜面底色） */
.wheel-frame {
  padding: 10rpx 0;
  border: 1rpx solid var(--border-moon-subtle);
  border-radius: var(--radius-lg);
  background: rgba(20, 27, 45, 0.46);
}

.calc-body {
  padding: 0;
  perspective: 1400rpx;
}

.calc-flip {
  position: relative;
  height: 600rpx;
  transform-style: preserve-3d;
  transition: transform 0.5s var(--ease-gentle);
}

.calc-flip.is-flipped {
  transform: rotateY(180deg);
}

.calc-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 600rpx;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  display: flex;
  flex-direction: column;
}

.calc-front {
  justify-content: flex-start;
  pointer-events: auto;
}

.calc-flip.is-flipped .calc-front {
  pointer-events: none;
}

.calc-face .btn-lunar-capsule {
  margin-top: 0;
}

.calc-back {
  transform: rotateY(180deg);
  padding-top: 4rpx;
  align-items: center;
  justify-content: flex-start;
  pointer-events: none;
}

.calc-flip.is-flipped .calc-back {
  pointer-events: auto;
}

.calc-action {
  margin: 26rpx 4rpx 0;
}

/* 现在时间 */
.now-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 10rpx 0;
}

.now-hint {
  font-size: 18rpx;
  color: var(--text-muted);
}

.now-link {
  font-size: 20rpx;
  color: #A5B4FC;
  padding: 4rpx 0;
}

/* 结果 */
.result-label {
  font-size: 18rpx;
  letter-spacing: 5rpx;
  color: var(--text-muted);
}

.result-main {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 8rpx;
}

.result-day {
  font-size: 21rpx;
  color: var(--color-accent-moon);
  letter-spacing: 1rpx;
}

.result-time {
  font-family: var(--font-sans);
  font-size: 88rpx;
  font-weight: 300;
  line-height: 1.08;
  letter-spacing: 0;
  color: var(--text-moon-pure);
  font-variant-numeric: tabular-nums;
}

.result-time.is-compact {
  font-size: 50rpx;
  letter-spacing: 0;
}

.result-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.result-note {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--text-muted);
}

.result-list {
  width: 100%;
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.result-row.is-passed {
  opacity: 0.36;
}

.result-row-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.result-row-day {
  font-size: 18rpx;
  color: var(--text-muted);
}

.result-row-time {
  font-size: 30rpx;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.result-row-tag {
  padding: 2rpx 8rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 15rpx;
  color: var(--text-muted);
}

.result-row-meta {
  font-size: 18rpx;
  color: var(--text-muted);
}

.result-reset {
  width: 100%;
  margin-top: 18rpx;
}

.result-share {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

/* 脚注 */
.calc-note {
  margin-top: 28rpx;
  padding: 0 18rpx;
  text-align: center;
  font-size: 18rpx;
  line-height: 1.9;
  color: var(--text-muted);
}
