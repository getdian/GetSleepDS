/* 首页局部设计 token：只作用于计算器页，不改其他页面的全局色板 */
.calc-page {
  --c-primary: #8B87FF;
  --c-primary-soft: #A7A4FF;
  --c-text: rgba(255, 255, 255, 0.94);
  --c-text-2: rgba(255, 255, 255, 0.62);
  --c-text-3: rgba(255, 255, 255, 0.36);
  --c-border: rgba(255, 255, 255, 0.07);
  position: relative;
  z-index: 1;
  padding-top: 8rpx;
}

/* Hero 背景图：从状态栏后开始，底部渐隐到现有夜色 */
/* 高度跟随图片：按宽度等比显示，整张图完整可见，不做裁切 */
.hero-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  min-height: 560rpx;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.hero-bg-img {
  display: block;
  width: 100%;
  height: auto;
}

.hero-bg-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    180deg,
    rgba(8, 13, 29, 0.06) 0%,
    rgba(8, 13, 29, 0.36) 55%,
    #080B14 100%
  );
}

/* 标题区 */
.calc-hero {
  position: relative;
  padding: 16rpx 8rpx 0;
  margin-bottom: 28rpx;
}

.hero-title {
  display: block;
  font-family: var(--font-sans);
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
  color: var(--c-text);
  text-shadow: 0 6rpx 28rpx rgba(2, 6, 18, 0.5);
}

.hero-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.68);
}

.hero-tools {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.hero-bg-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-bg-btn:active {
  opacity: 0.7;
}

.hero-bg-arrow {
  color: var(--c-primary-soft);
}

/* 玻璃卡外壳：静态容器，不参与 3D 翻转 */
.calc-card {
  position: relative;
  padding: 30rpx 28rpx 32rpx;
  border-radius: 44rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background:
    linear-gradient(
      168deg,
      rgba(255, 255, 255, 0.10) 0%,
      rgba(255, 255, 255, 0.04) 42%,
      rgba(139, 135, 255, 0.08) 100%
    ),
    rgba(15, 22, 44, 0.56);
  -webkit-backdrop-filter: blur(28rpx) saturate(150%);
  backdrop-filter: blur(28rpx) saturate(150%);
  box-shadow: 0 30rpx 70rpx rgba(2, 6, 18, 0.5);
}

/* 卡片顶缘高光：玻璃质感的点睛，不加别的装饰 */
.calc-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 12%;
  right: 12%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.34), transparent);
}

/* 模式切换：常驻卡片顶部，不翻转 */
.mode-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.mode-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 68rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(139, 135, 255, 0.38), rgba(139, 135, 255, 0.16));
  border: 1rpx solid rgba(167, 164, 255, 0.28);
  transition: opacity 0.16s ease;
}

.mode-pill:active {
  opacity: 0.82;
}

.mode-ico {
  font-size: 26rpx;
  line-height: 1;
}

.mode-text {
  font-size: 27rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  color: var(--c-text);
}

.mode-swap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: opacity 0.16s ease;
}

.mode-swap:active {
  opacity: 0.75;
}

.mode-swap-ico {
  font-size: 30rpx;
  line-height: 1;
  color: var(--c-primary-soft);
}

/* 3D 翻转：只翻内容层，玻璃壳保持不动 */
.calc-stage {
  perspective: 1500rpx;
}

.calc-flip {
  position: relative;
  height: 720rpx;
  transform-style: preserve-3d;
  transition: transform 0.62s cubic-bezier(0.45, 0.05, 0.2, 1);
  will-change: transform;
}

.calc-flip.is-flipped {
  transform: rotateY(180deg);
}

.calc-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

/* 交叉淡入兜底：内容层里嵌着滚筒的嵌套 3D，
   个别 WebKit 上 backface-visibility 会失效造成正反穿透 */
.calc-front {
  opacity: 1;
  transition: opacity 0.26s ease 0.22s;
  pointer-events: auto;
}

.calc-flip.is-flipped .calc-front {
  opacity: 0;
  transition: opacity 0.26s ease;
  pointer-events: none;
}

.calc-back {
  transform: rotateY(180deg);
  opacity: 0;
  transition: opacity 0.26s ease;
  pointer-events: none;
}

.calc-flip.is-flipped .calc-back {
  opacity: 1;
  transition: opacity 0.26s ease 0.22s;
  pointer-events: auto;
}

/* 时间轮：不套厚边框，让时间漂浮在夜色里 */
.wheel-frame {
  margin-top: 10rpx;
}

.now-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 8rpx 0;
}

.now-hint {
  font-size: 18rpx;
  color: var(--c-text-3);
}

.now-link {
  padding: 4rpx 0;
  font-size: 20rpx;
  color: var(--c-primary-soft);
}

/* 入睡耗时 */
.fall-block {
  margin-top: 22rpx;
}

.fall-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

/* 极简 CSS 时钟图标：与主色同调，不引素材 */
.fall-ico {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(167, 164, 255, 0.85);
}

.fall-ico::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2rpx;
  height: 7rpx;
  background: rgba(167, 164, 255, 0.9);
  transform: translate(-50%, -100%);
  border-radius: 2rpx;
}

.fall-ico::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6rpx;
  height: 2rpx;
  background: rgba(167, 164, 255, 0.9);
  transform: translate(0, -50%);
  border-radius: 2rpx;
}

.fall-label {
  font-size: 22rpx;
  color: var(--c-text-2);
}

.fall-chips {
  display: flex;
  gap: 12rpx;
}

.fall-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  height: 68rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.055);
  transition: color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.fall-chip.is-on {
  color: #FFFFFF;
  font-weight: 500;
  background: linear-gradient(135deg, #ABA8FF, #8B87FF);
  box-shadow: 0 8rpx 22rpx rgba(139, 135, 255, 0.32);
}

.fall-unit {
  font-size: 18rpx;
}

/* 主按钮 */
.calc-action {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  height: 108rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #ABA8FF 0%, #8B87FF 100%);
  color: #FFFFFF;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 16rpx 36rpx rgba(139, 135, 255, 0.34);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.calc-action:active {
  transform: scale(0.98);
  opacity: 0.94;
}

.action-arrow {
  font-size: 28rpx;
}

/* 结果面 */
.result-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

/* 极简 CSS 弯月：不引素材 */
.result-moon {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  box-shadow: inset -8rpx 5rpx 0 0 rgba(167, 164, 255, 0.95);
  transform: rotate(-18deg);
}

.result-label {
  font-size: 25rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.82);
}

.result-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 26rpx;
}

.result-bar {
  flex: none;
  width: 6rpx;
  height: 76rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #A7A4FF, #8B87FF);
  box-shadow: 0 0 14rpx rgba(139, 135, 255, 0.5);
}

.result-body {
  flex: 1;
  min-width: 0;
}

.result-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.result-day {
  font-size: 22rpx;
  color: var(--c-primary-soft);
}

.result-time {
  font-family: var(--font-sans);
  font-size: 84rpx;
  font-weight: 600;
  line-height: 1.05;
  letter-spacing: 1rpx;
  color: var(--c-text);
  font-variant-numeric: tabular-nums;
}

.result-time.is-compact {
  font-size: 50rpx;
  font-weight: 500;
}

.result-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--c-text-2);
}

.result-note {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  color: var(--c-text-3);
}

.result-badge {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 46rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(139, 135, 255, 0.24);
  border: 1rpx solid rgba(167, 164, 255, 0.3);
  color: #FFFFFF;
  font-size: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(139, 135, 255, 0.2);
}

.result-badge-star {
  font-size: 18rpx;
  color: var(--c-primary-soft);
}

.result-list {
  margin-top: 26rpx;
  border-top: 1rpx solid var(--c-border);
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid var(--c-border);
}

.result-row.is-passed {
  opacity: 0.36;
}

.result-row-left {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.result-row-day {
  font-size: 16rpx;
  color: var(--c-text-3);
}

.result-row-time {
  font-size: 36rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.88);
  font-variant-numeric: tabular-nums;
}

.result-row-tag {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--c-border);
  font-size: 15rpx;
  color: var(--c-text-3);
}

.result-row-meta {
  font-size: 19rpx;
  color: var(--c-text-3);
}

.result-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 20rpx;
}

.result-reset {
  padding: 10rpx 0;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.74);
}

.result-switch {
  font-size: 21rpx;
  color: var(--c-primary-soft);
}

.result-share {
  display: flex;
  justify-content: center;
  margin-top: 12rpx;
}

/* 脚注 */
.calc-note {
  margin-top: 24rpx;
  padding: 0 18rpx;
  text-align: center;
  font-size: 18rpx;
  line-height: 1.9;
  color: var(--c-text-3);
}
