<ambient />

<view wx:if="{{background && !bgError}}" class="hero-bg">
  <image
    class="hero-bg-img"
    src="{{background.localPath || background.url}}"
    mode="widthFix"
    binderror="onBackgroundError"
  />
  <view class="hero-bg-scrim"></view>
</view>

<top-bar brand-only="{{true}}" action-text="{{!singlePage && backgrounds.length ? '换背景' : ''}}" bind:action="openBgPicker" />

<view class="page calc-page">
  <view class="calc-hero {{flipped ? 'is-result' : ''}}">
    <!-- Hero 与卡顶胶囊同侧：标题问「你要选的那个时间」（输入），副标说明会算出什么（输出）。
         此前标题问结果、胶囊问输入，用户会把该选的时间读反。
         两个方向都不写「今晚/明早」：白天小睡时结果可能落在当天，陈述必须始终成立。 -->
    <!-- 翻转后回显「你选的时间」：背面已经给出结果，页头再问一次会显得没跟上；
         只陈述输入，与结果卡的「推荐…时间」形成 输入→输出 的阅读顺序。 -->
    <text wx:if="{{!flipped}}" class="hero-title">{{mode === 'wake' ? '想几点起？' : '想几点睡？'}}</text>
    <view wx:else class="hero-echo">
      <view class="hero-echo-line">
        <text class="hero-echo-day">{{view.echoPrefix}}</text>
        <text class="hero-echo-time">{{mode === 'wake' ? wakeTime : sleepTime}}</text>
        <text class="hero-echo-unit">{{mode === 'wake' ? '起床' : '入睡'}}</text>
      </view>
    </view>
    <text class="hero-sub">{{mode === 'wake' ? '选一个起床时间，找到适合你的睡点。' : '选一个入睡时间，找到适合你的起床时间。'}}</text>
  </view>

  <!-- 玻璃卡外壳：静态不翻转，作为视觉锚点 -->
  <view class="calc-card-wrap">
    <view class="calc-card">
      <!-- 模式切换：一体化胶囊常驻卡片顶部，不参与翻转 -->
      <view class="mode-row">
        <view class="mode-capsule" bindtap="toggleMode" hover-class="mode-capsule--tap" hover-stay-time="120">
          <view class="mode-pill-active">
            <view class="mode-ico {{mode === 'wake' ? 'is-sun' : 'is-moon'}}"></view>
            <text class="mode-text">{{mode === 'wake' ? '选择起床时间' : '选择入睡时间'}}</text>
          </view>
          <view class="mode-swap">
            <text class="mode-swap-ico">⇄</text>
          </view>
        </view>
      </view>

      <!-- 3D 翻转只作用于内容层 -->
      <view class="calc-stage">
        <view class="calc-flip {{flipped ? 'is-flipped' : ''}}">
          <!-- 正面：选择与计算 -->
          <view class="calc-face calc-front">
            <view class="wheel-frame">
              <time-wheel
                id="calc-wheel"
                value="{{mode === 'wake' ? wakeTime : sleepTime}}"
                bind:change="onTimeChange"
              />
            </view>

            <view class="now-row">
              <!-- 两种模式都陈述“选中的这个时刻指哪一天”：今天/明天 + 时段 + 24h 时间 -->
              <text class="now-hint">{{mode === 'wake' ? wakeContext : sleepContext}}</text>
              <text class="now-link {{mode === 'sleep' ? '' : 'is-hidden'}}" bindtap="onNowTap" hover-class="now-link--tap" hover-stay-time="120">用现在的时间</text>
            </view>

            <view class="fall-row">
              <view class="fall-head">
                <view class="fall-ico"></view>
                <text class="fall-label">预计入睡耗时</text>
              </view>
              <view class="fall-chips">
                <view
                  wx:for="{{fallOptions}}"
                  wx:key="*this"
                  class="fall-chip {{fallAsleep === item ? 'is-on' : ''}}"
                  data-min="{{item}}"
                  bindtap="onFallAsleepTap"
                  hover-class="fall-chip--tap"
                  hover-stay-time="100"
                >
                  <text>{{item}}</text>
                  <text class="fall-unit">分</text>
                </view>
              </view>
            </view>

            <view class="calc-action" bindtap="onCalc" hover-class="calc-action--tap" hover-stay-time="120">
              <text>{{mode === 'wake' ? '计算我的睡点' : '计算我的起床时间'}}</text>
              <text class="action-arrow">→</text>
            </view>
          </view>

          <!-- 背面：推荐结果（参考图下方推荐列表的翻转实现）。
               dense 条件只看行数：compact 同样是「3 行 + 主卡」，之前被排除后
               反而比 dense 更高（多一行 meta + 更松的按钮），会顶出 712rpx 舞台。 -->
          <view class="calc-face calc-back {{view && view.compact ? 'is-compact' : ''}} {{view && view.rows.length >= 3 ? 'is-dense' : ''}}">
            <block wx:if="{{view}}">
              <view class="result-head">
                <!-- 结果指向入睡点用月牙，指向起床时间用太阳 -->
                <view class="result-ico {{mode === 'wake' ? 'is-moon' : 'is-sun'}}"></view>
                <text class="result-label">{{view.label}}</text>
                <view class="result-fall" bindtap="cycleFall" hover-class="result-fall--tap" hover-stay-time="120">
                  <text>{{fallAsleep}} 分钟入睡</text>
                  <text class="result-fall-swap">⇄</text>
                </view>
              </view>

              <view class="result-main">
                <view class="result-bar"></view>
                <view class="result-body">
                  <view class="result-line">
                    <text wx:if="{{view.mainDay}}" class="result-day">{{view.mainDay}}</text>
                    <text class="result-time {{view.compact ? 'is-compact' : ''}}">{{view.mainTime}}</text>
                    <block wx:if="{{!view.compact}}">
                      <text class="result-dot">·</text>
                      <text class="result-meta-inline">{{view.mainMeta}}</text>
                    </block>
                  </view>
                  <text wx:if="{{view.compact}}" class="result-meta">{{view.mainMeta}}</text>
                  <text wx:if="{{view.note}}" class="result-note">{{view.note}}</text>
                </view>
                <view wx:if="{{!view.compact}}" class="result-badge guide-{{view.mainGuideTone}}">
                  <text wx:if="{{view.mainGuideTone === 'ok'}}" class="result-badge-star">★</text>
                  <text>{{view.mainGuideLabel}}</text>
                </view>
              </view>

              <view class="result-list">
                <view
                  wx:for="{{view.rows}}"
                  wx:key="cycles"
                  class="result-row {{item.passed ? 'is-passed' : ''}} {{item.extra ? 'is-extra' : ''}}"
                >
                  <view class="result-row-left">
                    <text wx:if="{{item.day}}" class="result-row-day">{{item.day}}</text>
                    <text class="result-row-time">{{item.time}}</text>
                    <text wx:if="{{item.extra}}" class="result-row-tag is-extra">补觉</text>
                    <text wx:if="{{item.passed}}" class="result-row-tag">已过</text>
                  </view>
                  <view class="result-row-right">
                    <text class="result-row-dot">·</text>
                    <text class="result-row-meta">{{item.cycles}} 个周期 · {{item.duration}}</text>
                    <text class="result-row-guide guide-{{item.guideTone}}">· {{item.guideLabel}}</text>
                  </view>
                </view>
              </view>

              <!-- 上行：提醒 + 换方向（换方向是页内动作，单页模式也保留）；
                   下行：返回 + 去入睡打卡（跨页动作，单页模式隐藏） -->
              <view class="result-extra">
                <view
                  wx:if="{{!singlePage && view.mainAt && !view.mainPassed}}"
                  class="result-remind {{remindAt === view.mainAt ? 'is-set' : ''}}"
                  bindtap="onRemindMain"
                  hover-class="result-remind--tap"
                  hover-stay-time="120"
                >
                  <text class="result-remind-ico">{{remindAt === view.mainAt ? '✓' : '◔'}}</text>
                  <text>{{remindAt === view.mainAt ? '已设提醒' : (mode === 'wake' ? '提醒我入睡' : '提醒我起床')}}</text>
                </view>
                <view class="result-switch" bindtap="toggleMode" hover-class="result-switch--tap" hover-stay-time="120">{{mode === 'wake' ? '换成我想几点睡' : '换成我想几点起'}} ⇄</view>
              </view>

              <view class="result-actions">
                <view class="result-reset" bindtap="reset" hover-class="result-reset--tap" hover-stay-time="120">‹ 返回</view>
                <view wx:if="{{!singlePage}}" class="result-go" bindtap="goSleep" hover-class="result-go--tap" hover-stay-time="120">
                  <text>去入睡打卡</text>
                  <text class="result-go-arrow">→</text>
                </view>
              </view>

              <view class="result-share">
                <!-- 图标 + 文字比纯蓝链接更精致，同时弱于上面两个 pill -->
                <share-btn text="分享给朋友" variant="icon" />
              </view>
            </block>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view
    class="calc-note"
    bindtap="openWhy"
    hover-class="calc-note--tap"
    hover-stay-time="120"
    aria-role="button"
    aria-label="为什么按 90 分钟周期计算"
  >
    <text>按 90 分钟周期计算，仅作时间参考</text>
    <text class="calc-note-more">为什么是 90 分钟？›</text>
  </view>

  <ad-slot slot-name="home" enabled="{{ads.home.enabled}}" unit-id="{{ads.home.unitId}}" type="{{ads.home.type}}" />
</view>

<view class="np-host"><now-playing id="np" /></view>

<!-- 为什么是 90 分钟：仅陈述一般睡眠常识，不做医疗建议 -->
<view wx:if="{{whyOpen}}" class="end-mask" catchtap="closeWhy" catchtouchmove="noop">
  <view class="end-sheet why-sheet" catchtap="noop" catchtouchmove="noop" aria-role="dialog" aria-label="为什么按 90 分钟周期计算">
    <view class="end-head">
      <view class="why-head-text">
        <text class="end-title">为什么是 90 分钟？</text>
        <text class="end-sub">睡眠周期与闹钟的关系</text>
      </view>
      <text class="end-close" catchtap="closeWhy" aria-role="button" aria-label="关闭" hover-class="end-close--tap" hover-stay-time="100">×</text>
    </view>

    <view class="why-point">
      <text class="why-num">1</text>
      <view class="why-body">
        <text class="why-title">一轮大约 90 分钟</text>
        <text class="why-text">睡眠在浅睡、深睡与做梦（REM）之间循环。成年人一轮常见 70–120 分钟，平均约 90 分钟——90 是常用均值，不是精确值。</text>
      </view>
    </view>

    <view class="why-point">
      <text class="why-num">2</text>
      <view class="why-body">
        <text class="why-title">8 小时 = 5.33 个周期</text>
        <text class="why-text">8 小时本身没问题，只是不在 90 分钟的整数倍上。固定时刻的闹钟不一定落在周期末尾；在周期中途（尤其深睡阶段）被叫醒，容易有刚醒时的昏沉感。深睡多集中在前半夜，后半夜以 REM 为主。</text>
      </view>
    </view>

    <view class="why-point">
      <text class="why-num">3</text>
      <view class="why-body">
        <text class="why-title">5 个周期 = 7.5 小时</text>
        <text class="why-text">在周期末尾（浅睡或 REM）醒来，通常比在周期中途醒来更清爽。但总时长仍以成人常见的 7–9 小时为准；个体差异很大，不必为凑周期刻意少睡。</text>
      </view>
    </view>

    <text class="why-foot">注：以上为一般睡眠常识，不构成医疗建议；作息以自身感受为准。</text>
  </view>
</view>

<background-picker
  show="{{bgOpen}}"
  items="{{bgItems}}"
  categories="{{bgCategories}}"
  active-category="{{bgCategory}}"
  active-id="{{background ? background.id : ''}}"
  unlock-hours="{{bgUnlockHours}}"
  free-mode="{{bgFreeMode}}"
  busy="{{bgBusy}}"
  bind:close="closeBgPicker"
  bind:category="onBgCategory"
  bind:select="onBgSelect"
/>

<custom-tab-bar wx:if="{{!singlePage}}" />
