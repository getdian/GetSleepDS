<ambient />

<view wx:if="{{background && !bgError}}" class="hero-bg">
  <image
    class="hero-bg-img"
    src="{{background.localPath || background.url}}"
    mode="widthFix"
    binderror="onBackgroundError"
  />
  <view class="hero-bg-scrim"></view>
</view>

<top-bar brand-only="{{true}}" action-text="换背景" bind:action="openBgPicker" />

<view class="page calc-page">
  <view class="calc-hero">
    <!-- Hero 与卡顶胶囊同侧：标题问「你要选的那个时间」（输入），副标说明会算出什么（输出）。
         此前标题问结果、胶囊问输入，用户会把该选的时间读反。
         两个方向都不写「今晚/明早」：白天小睡时结果可能落在当天，陈述必须始终成立。 -->
    <text class="hero-title">{{mode === 'wake' ? '想几点起？' : '想几点睡？'}}</text>
    <text class="hero-sub">{{mode === 'wake' ? '选一个起床时间，找到适合你的睡点。' : '选一个入睡时间，找到适合你的起床时间。'}}</text>
  </view>

  <!-- 玻璃卡外壳：静态不翻转，作为视觉锚点 -->
  <view class="calc-card-wrap">
    <view class="calc-card">
      <!-- 模式切换：一体化胶囊常驻卡片顶部，不参与翻转 -->
      <view class="mode-row">
        <view class="mode-capsule" bindtap="toggleMode">
          <view class="mode-pill-active">
            <view class="mode-ico {{mode === 'wake' ? 'is-sun' : 'is-moon'}}"></view>
            <text class="mode-text">{{mode === 'wake' ? '选择起床时间' : '选择入睡时间'}}</text>
          </view>
          <view class="mode-swap">
            <text class="mode-swap-ico">⇄</text>
          </view>
        </view>
      </view>

      <!-- 3D 翻转只作用于内容层 -->
      <view class="calc-stage">
        <view class="calc-flip {{flipped ? 'is-flipped' : ''}}">
          <!-- 正面：选择与计算 -->
          <view class="calc-face calc-front">
            <view class="wheel-frame">
              <time-wheel
                id="calc-wheel"
                value="{{mode === 'wake' ? wakeTime : sleepTime}}"
                bind:change="onTimeChange"
              />
            </view>

            <view class="now-row">
              <!-- 两种模式都陈述“选中的这个时刻指哪一天”：今天/明天 + 时段 + 24h 时间 -->
              <text class="now-hint">{{mode === 'wake' ? wakeContext : sleepContext}}</text>
              <text class="now-link {{mode === 'sleep' ? '' : 'is-hidden'}}" bindtap="onNowTap">用现在的时间</text>
            </view>

            <view class="fall-row">
              <view class="fall-head">
                <view class="fall-ico"></view>
                <text class="fall-label">预计入睡耗时</text>
              </view>
              <view class="fall-chips">
                <view
                  wx:for="{{fallOptions}}"
                  wx:key="*this"
                  class="fall-chip {{fallAsleep === item ? 'is-on' : ''}}"
                  data-min="{{item}}"
                  bindtap="onFallAsleepTap"
                  hover-class="fall-chip--tap"
                  hover-stay-time="100"
                >
                  <text>{{item}}</text>
                  <text class="fall-unit">分</text>
                </view>
              </view>
            </view>

            <view class="calc-action" bindtap="onCalc">
              <text>{{mode === 'wake' ? '计算我的睡点' : '计算我的起床时间'}}</text>
              <text class="action-arrow">→</text>
            </view>
          </view>

          <!-- 背面：推荐结果（参考图下方推荐列表的翻转实现） -->
          <view class="calc-face calc-back {{view && view.compact ? 'is-compact' : ''}}">
            <block wx:if="{{view}}">
              <view class="result-head">
                <!-- 结果指向入睡点用月牙，指向起床时间用太阳 -->
                <view class="result-ico {{mode === 'wake' ? 'is-moon' : 'is-sun'}}"></view>
                <text class="result-label">{{view.label}}</text>
                <view class="result-fall" bindtap="cycleFall">
                  <text>{{fallAsleep}} 分钟入睡</text>
                  <text class="result-fall-swap">⇄</text>
                </view>
              </view>

              <view class="result-main">
                <view class="result-bar"></view>
                <view class="result-body">
                  <view class="result-line">
                    <text wx:if="{{view.mainDay}}" class="result-day">{{view.mainDay}}</text>
                    <text class="result-time {{view.compact ? 'is-compact' : ''}}">{{view.mainTime}}</text>
                    <block wx:if="{{!view.compact}}">
                      <text class="result-dot">·</text>
                      <text class="result-meta-inline">{{view.mainMeta}}</text>
                    </block>
                  </view>
                  <text wx:if="{{view.compact}}" class="result-meta">{{view.mainMeta}}</text>
                  <text wx:if="{{view.note}}" class="result-note">{{view.note}}</text>
                </view>
                <view wx:if="{{!view.compact}}" class="result-badge guide-{{view.mainGuideTone}}">
                  <text wx:if="{{view.mainGuideTone === 'ok'}}" class="result-badge-star">★</text>
                  <text>{{view.mainGuideLabel}}</text>
                </view>
              </view>

              <view class="result-list">
                <view
                  wx:for="{{view.rows}}"
                  wx:key="cycles"
                  class="result-row {{item.passed ? 'is-passed' : ''}}"
                >
                  <view class="result-row-left">
                    <text wx:if="{{item.day}}" class="result-row-day">{{item.day}}</text>
                    <text class="result-row-time">{{item.time}}</text>
                    <text wx:if="{{item.passed}}" class="result-row-tag">已过</text>
                  </view>
                  <view class="result-row-right">
                    <text class="result-row-dot">·</text>
                    <text class="result-row-meta">{{item.cycles}} 个周期 · {{item.duration}}</text>
                    <text class="result-row-guide guide-{{item.guideTone}}">· {{item.guideLabel}}</text>
                  </view>
                </view>
              </view>

              <view class="result-extra">
                <view class="result-go" bindtap="goSleep">
                  <text>去入睡打卡</text>
                  <text class="result-go-arrow">→</text>
                </view>
              </view>

              <view class="result-actions">
                <view class="result-reset" bindtap="reset">↻ 重新选择</view>
                <view class="result-switch" bindtap="toggleMode">{{mode === 'wake' ? '换成我想几点睡' : '换成我想几点起'}} ⇄</view>
              </view>

              <view class="result-share">
                <share-btn text="分享给朋友" variant="link" />
              </view>
            </block>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="calc-note">
    <text>按 90 分钟周期计算，仅作时间参考</text>
  </view>

  <ad-slot slot-name="home" enabled="{{ads.home.enabled}}" unit-id="{{ads.home.unitId}}" type="{{ads.home.type}}" />
</view>

<view class="np-host"><now-playing /></view>

<background-picker
  show="{{bgOpen}}"
  items="{{bgItems}}"
  categories="{{bgCategories}}"
  active-category="{{bgCategory}}"
  active-id="{{background ? background.id : ''}}"
  unlock-hours="{{bgUnlockHours}}"
  free-mode="{{bgFreeMode}}"
  busy="{{bgBusy}}"
  bind:close="closeBgPicker"
  bind:category="onBgCategory"
  bind:select="onBgSelect"
/>

<custom-tab-bar />
