.sleep-page {
  position: relative;
  z-index: 1;
  padding-top: 8rpx;
  padding-bottom: 190rpx;
}

/* Hero：与计算器页同一套大标题 + 轻说明 */
.sleep-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 22rpx;
}

.sleep-hero-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.sleep-eyebrow {
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
  color: var(--color-primary-soft);
}

.sleep-date {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--text-muted);
}

.sleep-title {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-sans);
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: 2rpx;
  color: #FFFFFF;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.55);
}

.sleep-sub {
  display: block;
  max-width: 620rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(220, 230, 255, 0.72);
}

/* 提示条：只留一条轻线，不再做卡片 */
.notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 4rpx 0 10rpx;
  padding: 12rpx 2rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
  font-size: 22rpx;
  color: var(--text-secondary);
}

.notice-text {
  flex: 1;
  min-width: 0;
}

.notice-close {
  flex: none;
  color: var(--color-primary);
}

/* 入睡圆环：边缘透明，靠柔光/呼吸环向外辐射 */
.orb-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
}

.orb-stage {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.orb-aura {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(18rpx);
  background: radial-gradient(
    circle,
    rgba(120, 112, 255, 0.3) 0%,
    rgba(90, 80, 220, 0.12) 48%,
    rgba(20, 20, 50, 0) 72%
  );
  animation: orbPulse 6s var(--ease-gentle) infinite;
}

.aura-a {
  width: 430rpx;
  height: 430rpx;
}

.aura-b {
  width: 360rpx;
  height: 360rpx;
  opacity: 0.7;
  animation-delay: 1.4s;
}

.aura-c {
  width: 480rpx;
  height: 480rpx;
  opacity: 0.45;
  animation-delay: 2.8s;
}

.orb-section.is-sleeping .orb-aura {
  background: radial-gradient(
    circle,
    rgba(58, 210, 190, 0.26) 0%,
    rgba(55, 90, 190, 0.12) 48%,
    rgba(20, 20, 50, 0) 72%
  );
}

.sleep-orb {
  position: relative;
  z-index: 1;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: none;
  background: radial-gradient(
    circle at 50% 40%,
    rgba(126, 122, 255, 0.7) 0%,
    rgba(88, 82, 220, 0.48) 42%,
    rgba(55, 52, 150, 0.2) 66%,
    rgba(20, 20, 55, 0) 80%
  );
  box-shadow:
    0 0 80rpx rgba(109, 104, 255, 0.36),
    0 0 160rpx rgba(80, 75, 210, 0.18);
  transition: transform 0.3s var(--ease-spring), background 0.5s ease, box-shadow 0.5s ease;
}

.sleep-orb::before {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 18rpx;
  bottom: 18rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  pointer-events: none;
}

.sleep-orb::after {
  content: "";
  position: absolute;
  left: 62rpx;
  top: 46rpx;
  width: 110rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  filter: blur(14rpx);
  transform: rotate(-24deg);
  pointer-events: none;
}

.sleep-orb:active {
  transform: scale(0.96);
}

.orb--sleeping {
  background: radial-gradient(
    circle at 50% 40%,
    rgba(58, 220, 198, 0.58) 0%,
    rgba(55, 95, 200, 0.44) 45%,
    rgba(38, 58, 145, 0.18) 68%,
    rgba(20, 20, 55, 0) 80%
  );
  box-shadow:
    0 0 80rpx rgba(45, 212, 191, 0.28),
    0 0 160rpx rgba(55, 80, 200, 0.16);
}

.orb-kicker {
  position: relative;
  z-index: 1;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 233, 255, 0.72);
}

.orb-time {
  position: relative;
  z-index: 1;
  font-family: var(--font-sans);
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: 2rpx;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 2rpx 20rpx rgba(10, 10, 40, 0.3);
}

.orb-meta {
  position: relative;
  z-index: 1;
  max-width: 230rpx;
  text-align: center;
  font-size: 19rpx;
  line-height: 1.35;
  color: rgba(222, 231, 255, 0.78);
}

.orb-caption {
  display: block;
  margin-top: 2rpx;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--text-secondary);
}

.orb-note {
  display: block;
  margin-top: 8rpx;
  text-align: center;
  font-size: 19rpx;
  color: var(--text-muted);
}

.undo-bed {
  margin-top: 8rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 完成态：同样不套卡片，直接落在背景上 */
.done-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 12rpx;
}

.done-kicker {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: var(--text-muted);
}

.done-duration {
  margin-top: 10rpx;
  font-family: var(--font-cn-serif);
  font-size: 76rpx;
  line-height: 1.1;
  letter-spacing: 2rpx;
  color: var(--text-moon-pure);
  font-variant-numeric: tabular-nums;
}

.done-duration-k {
  margin-top: 4rpx;
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: var(--text-muted);
}

.done-timeline {
  width: 100%;
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.done-time {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.done-time.is-right {
  align-items: flex-end;
}

.done-time-k {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--text-muted);
}

.done-time-v {
  font-size: 30rpx;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.done-rail {
  flex: 1;
  display: flex;
  align-items: center;
  margin: 0 18rpx;
}

.done-rail-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(167, 164, 255, 0.15), rgba(167, 164, 255, 0.5));
}

.done-rail-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  box-shadow: 0 0 12rpx rgba(167, 164, 255, 0.6);
}

.done-rail-dot.is-end {
  background: var(--color-accent-moon);
  box-shadow: 0 0 12rpx rgba(253, 230, 138, 0.5);
}

.done-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
}

.overwrite {
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-primary-soft);
  text-decoration: underline;
}

.overwrite:active,
.notice:active,
.week-section:active {
  opacity: 0.72;
}

.undo {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 21rpx;
  color: var(--text-muted);
}

/* 展示位 */
.sleep-ad {
  margin-top: 20rpx;
}

/* 最近 7 天：无卡片，只留标题和柱线 */
.week-section {
  margin-top: 44rpx;
  padding: 0 4rpx;
}

.week-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.week-head-copy {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.week-title {
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: var(--text-secondary);
}

.week-sub {
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: var(--text-muted);
}

.week-link {
  flex: none;
  min-height: 72rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 4rpx 0 20rpx;
  font-size: 22rpx;
  color: var(--color-primary);
}

.week-days {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 22rpx;
}

.week-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.day-track {
  position: relative;
  width: 14rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  overflow: hidden;
}

.day-fill {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  transition: height 0.35s var(--ease-gentle), background 0.3s ease;
}

.day-fill.level-0 {
  height: 7rpx;
  background: rgba(255, 255, 255, 0.06);
}

.day-fill.level-1 {
  height: 18rpx;
  background: var(--heat-1);
}

.day-fill.level-2 {
  height: 34rpx;
  background: var(--heat-2);
}

.day-fill.level-3 {
  height: 52rpx;
  background: var(--heat-3);
}

.day-fill.level-4 {
  height: 70rpx;
  background: var(--heat-4);
}

.day-fill.level-5 {
  height: 84rpx;
  background: var(--heat-5);
}

.day-fill.is-partial {
  height: 50rpx;
  background: transparent;
  border: 1rpx dashed var(--border-glow);
}

.day-fill.is-today {
  box-shadow: 0 0 0 2rpx var(--border-moon-light);
}

.day-label {
  font-size: 20rpx;
  color: var(--text-muted);
}

.day-label.is-today-label {
  color: var(--text-primary);
  font-weight: 500;
}

.week-summary-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.week-summary {
  font-size: 19rpx;
  color: var(--text-muted);
}

.week-sep {
  font-size: 19rpx;
  color: var(--text-muted);
  opacity: 0.6;
}

.sleep-share {
  display: flex;
  justify-content: center;
  margin-top: 14rpx;
}

.sleep-quote {
  display: block;
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
  letter-spacing: 7rpx;
  opacity: 0.9;
}

/* 熄灯 */
.dim-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-cosmic);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s var(--ease-gentle);
}

.dim-mask.is-on {
  opacity: 0.97;
  pointer-events: auto;
}

.dim-text {
  font-size: 44rpx;
  color: var(--text-secondary);
  opacity: 0;
  transition: opacity 0.35s ease 0.35s;
}

.dim-mask.is-on .dim-text {
  opacity: 1;
}

@keyframes orbPulse {
  0%, 100% {
    transform: scale(0.92);
    opacity: 0.55;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.2;
  }
}

@media (max-width: 360px) {
  .sleep-title {
    font-size: 64rpx;
  }

  .orb-stage {
    width: 400rpx;
    height: 400rpx;
  }

  .sleep-orb {
    width: 292rpx;
    height: 292rpx;
  }

  .done-duration {
    font-size: 64rpx;
  }

  .aura-c {
    width: 430rpx;
    height: 430rpx;
  }
}
