.sleep-page {
  padding-top: 8rpx;
}

.sleep-hero {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 28rpx;
}

.sleep-date {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
}

.sleep-hero .title-xl {
  margin-top: 4rpx;
}

/* 提示条 */
.notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-glow);
  background: var(--glass-tint);
  font-size: 22rpx;
  color: var(--text-secondary);
}

.notice-close {
  color: var(--color-primary);
}

/* 打卡卡 */
.record-card {
  padding: 30rpx 28rpx 34rpx;
}

.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-kicker {
  font-family: var(--font-cn-serif);
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--text-secondary);
}

.record-state {
  padding: 4rpx 18rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 18rpx;
  color: var(--text-muted);
}

.pill-sleeping {
  color: var(--color-calm-teal);
  border-color: rgba(45, 212, 191, 0.4);
}

.pill-done {
  color: var(--color-accent-moon);
  border-color: rgba(253, 230, 138, 0.4);
}

/* 月相大圆钮 + 双环呼吸 */
.dial-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 420rpx;
  margin: 8rpx 0 2rpx;
}

.dial-halo {
  position: absolute;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  border: 1.5rpx solid var(--border-glow);
  animation: haloBreathe 4.5s var(--ease-gentle) infinite;
}

.halo-two {
  width: 392rpx;
  height: 392rpx;
  border-color: rgba(129, 140, 248, 0.18);
  animation-delay: 1.6s;
}

.dial {
  position: relative;
  z-index: 1;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  border: 1rpx solid var(--border-moon-light);
  box-shadow: 0 24rpx 64rpx rgba(99, 102, 241, 0.4), inset 0 2rpx 12rpx rgba(255, 255, 255, 0.25);
  transition: transform 0.3s var(--ease-spring), background 0.4s ease, box-shadow 0.4s ease;
}

.dial:active {
  transform: scale(0.96);
}

.dial--sleeping {
  background: linear-gradient(135deg, var(--color-calm-teal), var(--color-primary-dark));
  box-shadow: 0 24rpx 64rpx rgba(45, 212, 191, 0.3), inset 0 2rpx 12rpx rgba(255, 255, 255, 0.22);
}

.dial-title {
  font-family: var(--font-cn-serif);
  font-size: 46rpx;
  letter-spacing: 6rpx;
  color: var(--text-moon-pure);
}

.dial-sub {
  font-size: 20rpx;
  color: rgba(248, 250, 252, 0.75);
  font-variant-numeric: tabular-nums;
}

.record-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

.undo-bed {
  margin-top: 16rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--text-muted);
  text-decoration: underline;
}

/* 完成态：三项汇总 */
.done-grid {
  display: flex;
  padding: 36rpx 0 18rpx;
}

.done-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.done-v {
  font-family: var(--font-cn-serif);
  font-size: 30rpx;
  color: var(--text-moon-pure);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.done-accent {
  color: var(--color-primary);
}

.done-k {
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
}

.overwrite {
  margin: 22rpx 0 0;
  padding: 18rpx 24rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(129, 140, 248, 0.3);
  background: rgba(99, 102, 241, 0.1);
  font-size: 22rpx;
  color: #C7D2FE;
}

.undo {
  margin-top: 18rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--text-muted);
}

/* 展示位：与上方撤销入口再拉开一档，降低误触 */
.sleep-ad {
  margin-top: 24rpx;
}

.sleep-share {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

/* 最近 7 天：无框分区，打卡卡是本页唯一玻璃焦点 */
.week-card {
  margin-top: 36rpx;
}

.week-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.week-title {
  font-family: var(--font-cn-serif);
  font-size: 28rpx;
  letter-spacing: 3rpx;
  color: var(--text-primary);
}

.week-link {
  font-size: 18rpx;
  color: var(--color-primary);
}

.week-days {
  display: flex;
  justify-content: space-between;
  margin-top: 26rpx;
}

.week-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.day-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 1rpx solid var(--border-moon-subtle);
  background: var(--heat-0);
  transition: background 0.3s ease;
}

.day-dot.level-1 { background: var(--heat-1); border-color: transparent; }
.day-dot.level-2 { background: var(--heat-2); border-color: transparent; }
.day-dot.level-3 { background: var(--heat-3); border-color: transparent; }
.day-dot.level-4 { background: var(--heat-4); border-color: transparent; }
.day-dot.level-5 { background: var(--heat-5); border-color: transparent; }

.day-dot.is-partial {
  background: transparent;
  border: 1.5rpx solid var(--border-glow);
}

.day-dot.is-today {
  box-shadow: 0 0 0 3rpx var(--border-moon-light);
}

.day-label {
  font-size: 18rpx;
  color: var(--text-muted);
}

.day-label.is-today-label {
  color: var(--text-primary);
}

.week-summary {
  display: block;
  margin-top: 22rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--text-muted);
}

.sleep-quote {
  display: block;
  margin-top: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-muted);
  letter-spacing: 8rpx;
  opacity: 0.9;
}

/* 熄灯 */
.dim-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-cosmic);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s var(--ease-gentle);
}

.dim-mask.is-on {
  opacity: 0.97;
}

.dim-text {
  font-size: 44rpx;
  color: var(--text-secondary);
  opacity: 0;
  transition: opacity 0.35s ease 0.35s;
}

.dim-mask.is-on .dim-text {
  opacity: 1;
}

@keyframes haloBreathe {
  0% { transform: scale(0.94); opacity: 0.5; }
  100% { transform: scale(1.08); opacity: 0.15; }
}

