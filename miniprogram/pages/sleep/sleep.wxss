/* 补记/结束/编辑面板样式与统计页共用一份，见 styles/sheet.wxss */
@import "../../styles/sheet.wxss";

.sleep-page {
  position: relative;
  z-index: var(--z-page, 1);
  padding-top: 8rpx;
  /* 与 app.wxss .page 同口径：为常驻悬浮音符留出空间 */
  padding-bottom: 140rpx;
}

/* Hero：与计算器页同一套大标题 + 轻说明 */
.sleep-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 22rpx;
}

.sleep-hero-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.sleep-date {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--text-muted);
}

.sleep-title {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-sans);
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: 2rpx;
  color: #FFFFFF;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.55);
}

.sleep-sub {
  display: block;
  max-width: 620rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(220, 230, 255, 0.72);
}

/* 提示条：只留一条轻线，不再做卡片 */
.notice {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 4rpx 0 10rpx;
  padding: 12rpx 2rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 视觉只有 ~59rpx 高，把可点区域补到约 75rpx */
.notice::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -8rpx;
  bottom: -8rpx;
}

.notice-text {
  flex: 1;
  min-width: 0;
}

.notice-close {
  flex: none;
  color: var(--color-primary);
}

.notice {
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.notice:active,
.notice--tap {
  opacity: 0.65;
  transform: scale(0.98);
}

/* 入睡圆环：边缘透明，靠柔光/呼吸环向外辐射 */
.orb-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
}

.orb-stage {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.orb-aura {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(18rpx);
  background: radial-gradient(
    circle,
    rgba(120, 112, 255, 0.3) 0%,
    rgba(90, 80, 220, 0.12) 48%,
    rgba(20, 20, 50, 0) 72%
  );
  animation: orbPulse 6s var(--ease-gentle) infinite;
}

.aura-a {
  width: 430rpx;
  height: 430rpx;
}

.aura-b {
  width: 360rpx;
  height: 360rpx;
  opacity: 0.7;
  animation-delay: 1.4s;
}

.aura-c {
  width: 480rpx;
  height: 480rpx;
  opacity: 0.45;
  animation-delay: 2.8s;
}

.orb-section.is-sleeping .orb-aura {
  background: radial-gradient(
    circle,
    rgba(58, 210, 190, 0.26) 0%,
    rgba(55, 90, 190, 0.12) 48%,
    rgba(20, 20, 50, 0) 72%
  );
}

.sleep-orb {
  position: relative;
  z-index: 1;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: none;
  background: radial-gradient(
    circle at 50% 40%,
    rgba(126, 122, 255, 0.7) 0%,
    rgba(88, 82, 220, 0.48) 42%,
    rgba(55, 52, 150, 0.2) 66%,
    rgba(20, 20, 55, 0) 80%
  );
  box-shadow:
    0 0 80rpx rgba(109, 104, 255, 0.36),
    0 0 160rpx rgba(80, 75, 210, 0.18);
  transition: transform 0.3s var(--ease-spring), background 0.5s ease, box-shadow 0.5s ease;
}

.sleep-orb::before {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 18rpx;
  bottom: 18rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  pointer-events: none;
}

.sleep-orb::after {
  content: "";
  position: absolute;
  left: 62rpx;
  top: 46rpx;
  width: 110rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  filter: blur(14rpx);
  transform: rotate(-24deg);
  pointer-events: none;
}

.sleep-orb:active,
.sleep-orb--tap {
  transform: scale(0.96);
  opacity: 0.88;
}

.orb--sleeping {
  background: radial-gradient(
    circle at 50% 40%,
    rgba(58, 220, 198, 0.58) 0%,
    rgba(55, 95, 200, 0.44) 45%,
    rgba(38, 58, 145, 0.18) 68%,
    rgba(20, 20, 55, 0) 80%
  );
  box-shadow:
    0 0 80rpx rgba(45, 212, 191, 0.28),
    0 0 160rpx rgba(55, 80, 200, 0.16);
}

.orb-kicker {
  position: relative;
  z-index: 1;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  /* 压在高亮光核上：睡前场景是确认状态的关键信息，需 ≥4.5:1 */
  color: rgba(232, 239, 255, 0.9);
  text-shadow: 0 1rpx 8rpx rgba(8, 12, 32, 0.45);
}

.orb-time {
  position: relative;
  z-index: 1;
  font-family: var(--font-sans);
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: 2rpx;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 2rpx 20rpx rgba(10, 10, 40, 0.3);
}

.orb-meta {
  position: relative;
  z-index: 1;
  max-width: 230rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.35;
  color: rgba(231, 238, 255, 0.9);
  text-shadow: 0 1rpx 8rpx rgba(8, 12, 32, 0.45);
}

.orb-caption {
  display: block;
  margin-top: 2rpx;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--text-secondary);
}

.orb-note {
  display: block;
  margin-top: 8rpx;
  text-align: center;
  font-size: 19rpx;
  color: var(--text-muted);
}

/* 入睡中次级动作行：撤销在左，分享在右，左右对齐在同一行 */
.sleeping-sub-actions {
  width: 100%;
  max-width: 560rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.sleeping-sub-actions .undo-bed {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.sleeping-sub-actions .undo-bed:active,
.sleeping-sub-actions .undo-bed--tap {
  opacity: 0.52;
  transform: scale(0.97);
}

.sleeping-sub-actions .sleeping-share {
  display: flex;
  align-items: center;
}

/* 完成态：同样不套卡片，直接落在背景上 */
.done-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 12rpx;
}

.done-kicker {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: var(--text-muted);
}

/* 记录存在但没有任何可用段（脏数据）：不给空白大数字，直接说明可撤销重记 */
.done-empty {
  margin-top: 40rpx;
  padding: 0 36rpx;
}

.done-empty-text {
  display: block;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.8;
  color: var(--text-secondary);
}

.done-duration {
  margin-top: 10rpx;
  font-family: var(--font-cn-serif);
  font-size: 76rpx;
  line-height: 1.1;
  letter-spacing: 2rpx;
  color: var(--text-moon-pure);
  font-variant-numeric: tabular-nums;
}

.done-duration-k {
  margin-top: 4rpx;
  font-size: 19rpx;
  letter-spacing: 3rpx;
  color: var(--text-muted);
}

.done-timeline {
  width: 100%;
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.done-time {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.done-time.is-right {
  align-items: flex-end;
}

.done-time-k {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--text-muted);
}

.done-time-v {
  font-size: 30rpx;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.done-rail {
  flex: 1;
  display: flex;
  align-items: center;
  margin: 0 18rpx;
}

/* 分段轨道：底色是"首段入睡 → 末段起床"的总跨度，亮条是真正睡着的段，
   中间留空即清醒间断。单段时是一整条，视觉与旧版一致。 */
.done-rail-track {
  position: relative;
  flex: 1;
  height: 8rpx;
  margin: 0 10rpx;
  border-radius: 4rpx;
  background: rgba(167, 164, 255, 0.14);
  overflow: hidden;
}

.done-rail-seg {
  position: absolute;
  top: 0;
  bottom: 0;
  /* 0.8% 在 390 屏上只有约 1.5pt，1 分钟段仍看不见；给一个物理下限 */
  min-width: 6rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, rgba(167, 164, 255, 0.72), rgba(233, 238, 255, 0.95));
  box-shadow: 0 0 10rpx rgba(167, 164, 255, 0.35);
}

/* 段数 / 间断摘要：解释"首末跨度"与"总睡眠"为什么对不上 */
.done-segments-text {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.52);
}

/* 真实入睡时刻：与「总睡眠」区分，用主色提示这是更细的一层信息 */
.done-sleep-note {
  display: block;
  margin-top: 10rpx;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--color-primary-soft);
  opacity: 0.9;
}

.done-rail-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  box-shadow: 0 0 12rpx rgba(167, 164, 255, 0.6);
}

.done-rail-dot.is-end {
  background: var(--color-accent-moon);
  box-shadow: 0 0 12rpx rgba(253, 230, 138, 0.5);
}

/* 完成态主操作：两个小型按钮同一行，主次用底色区分 */
.done-cta-row {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.cta-mini {
  position: relative;
  /* 完成态主操作是「继续入睡」，32pt 的按钮在睡前单手场景偏小；视觉不变、热区补到 88rpx */
  min-height: 88rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary-soft);
  background: rgba(139, 135, 255, 0.12);
  transition: opacity 0.2s ease, transform 0.2s var(--ease-spring);
}

.cta-mini.is-primary {
  background: var(--btn-primary-bg);
  color: var(--btn-primary-fg);
  box-shadow: 0 8rpx 24rpx rgba(109, 104, 255, 0.28);
}

.cta-mini:active,
.cta-mini--tap {
  opacity: 0.76;
  transform: scale(0.96);
}

.cta-mini.is-primary:active,
.cta-mini.is-primary.cta-mini--tap {
  opacity: 0.82;
  transform: scale(0.96);
  box-shadow: 0 4rpx 14rpx rgba(109, 104, 255, 0.22);
}

.undo {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 21rpx;
  color: var(--text-muted);
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.undo:active,
.undo--tap {
  opacity: 0.52;
  transform: scale(0.98);
}

/* 展示位 */
.sleep-ad {
  margin-top: 20rpx;
}

/* 一行轻量统计：圆盘移除后只保留本周/连续计数与统计入口（打卡心智钩子） */
.stats-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 36rpx;
  padding: 22rpx 4rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: opacity 0.16s ease;
}

.stats-strip-main {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--text-secondary);
}

.stats-strip-link {
  flex: none;
  min-height: 72rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 4rpx 0 20rpx;
  font-size: 22rpx;
  color: var(--color-primary);
}

.stats-strip:active,
.stats-strip--tap {
  opacity: 0.65;
}

.sleep-share {
  display: flex;
  justify-content: center;
  margin-top: 14rpx;
}

.sleep-quote {
  display: block;
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
  letter-spacing: 7rpx;
  opacity: 0.9;
}

/* 每日一句比固定短句长：收窄字距、放宽行高，允许自然折行不撑破舞台 */
.sleep-quote.is-quote {
  padding: 0 40rpx;
  letter-spacing: 2rpx;
  line-height: 1.9;
}

.sleep-quote-source {
  display: block;
  margin-top: 10rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--text-muted);
  opacity: 0.7;
}

/* 熄灯（睡前模式）：毛玻璃压暗整页，只留熄灭态的入睡时间 */
.dim-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* 熄灯是整页动作：必须盖住悬浮 tabBar(90) 与迷你播放器(100)，
     但仍低于底部弹层（180/200），避免遮罩压住解锁/背景选择面板 */
  z-index: var(--z-dim, 150);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 0.84 深底：不支持 backdrop-filter 的机型自动退回"接近关灯"，
     而不是半透明花屏；支持时 blur 让背景只剩一层毛玻璃轮廓 */
  background: rgba(4, 7, 15, 0.84);
  -webkit-backdrop-filter: blur(20rpx) saturate(120%);
  backdrop-filter: blur(20rpx) saturate(120%);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.5s var(--ease-gentle);
}

.dim-mask.is-on {
  opacity: 1;
  pointer-events: auto;
}

.dim-kicker {
  position: absolute;
  top: 16%;
  left: 0;
  right: 0;
  text-align: center;
  font-family: var(--font-cn-serif);
  font-size: 26rpx;
  letter-spacing: 10rpx;
  color: rgba(226, 232, 240, 0.42);
}

/* 熄灭态的入睡时间：浮在毛玻璃上，亮度压到 0.84，不刺眼但可读 */
.dim-orb {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: radial-gradient(
    circle at 50% 40%,
    rgba(126, 122, 255, 0.3) 0%,
    rgba(88, 82, 220, 0.16) 46%,
    rgba(20, 20, 55, 0) 74%
  );
  filter: brightness(0.84);
}

.dim-orb-kicker {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(224, 233, 255, 0.5);
}

.dim-orb-time {
  font-size: 60rpx;
  font-weight: 300;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.82);
  font-variant-numeric: tabular-nums;
}

.dim-orb-meta {
  font-size: 19rpx;
  color: rgba(222, 231, 255, 0.52);
}

/* 熄灯态唯一业务出口：一眼可见的「结束入睡」，一次点击按当前时间结束 */
.dim-end {
  position: absolute;
  left: 50%;
  bottom: calc(13% + 72rpx);
  transform: translateX(-50%);
  min-width: 288rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  font-size: 27rpx;
  letter-spacing: 2rpx;
  color: rgba(233, 239, 255, 0.92);
  transition: background 0.16s ease, transform 0.16s ease;
}

.dim-end:active,
.dim-end--tap {
  background: rgba(255, 255, 255, 0.2);
  transform: translateX(-50%) scale(0.97);
}

.dim-hint {
  position: absolute;
  bottom: 13%;
  left: 0;
  right: 0;
  text-align: center;
  /* 熄灯后唯一交互出口：字号与对比度都不能再叠 opacity 弱化（合成后曾仅 2.4:1） */
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(203, 213, 225, 0.72);
}

@keyframes orbPulse {
  0%, 100% {
    transform: scale(0.92);
    opacity: 0.55;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.2;
  }
}

@media (max-width: 360px) {
  .sleep-title {
    font-size: 64rpx;
  }

  .orb-stage {
    width: 400rpx;
    height: 400rpx;
  }

  .sleep-orb {
    width: 292rpx;
    height: 292rpx;
  }

  .done-duration {
    font-size: 64rpx;
  }

  .aura-c {
    width: 430rpx;
    height: 430rpx;
  }
}

/* 到点提醒入口：弱实心胶囊按钮，简洁无边框 */
.sleep-reminder {
  align-self: center;
  min-height: 60rpx;
  margin-top: 18rpx;
  padding: 0 32rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: none;
  background: rgba(255, 255, 255, 0.08);
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  color: rgba(225, 235, 255, 0.88);
  transition: opacity 0.16s ease, transform 0.16s ease, background 0.16s ease;
}

.sleep-reminder:active,
.sleep-reminder--tap {
  opacity: 0.65;
  transform: scale(0.97);
}

.sleep-reminder.is-on {
  background: rgba(139, 135, 255, 0.22);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(139, 135, 255, 0.25);
}

/* 超过预计起床：在圆环下方给一个明确的结束入口 */
.sleep-overdue {
  margin: 18rpx auto 0;
  max-width: 560rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(245, 194, 107, 0.32);
  background: rgba(245, 194, 107, 0.08);
  text-align: center;
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.sleep-overdue:active,
.sleep-overdue--tap {
  opacity: 0.72;
  transform: scale(0.98);
}

.sleep-overdue-title {
  display: block;
  font-size: 25rpx;
  color: #f5c26b;
}

.sleep-overdue-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.62);
}

/* 本日多段睡眠明细：每段 88rpx 高，右侧修改按钮有独立命中区 */
.done-sessions {
  width: 100%;
  margin-top: 18rpx;
  padding: 14rpx 18rpx 6rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.035);
}

.done-sessions-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  padding-bottom: 6rpx;
}

.done-sessions-k {
  display: block;
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.46);
}

.done-sessions-hint {
  flex: none;
  /* 17rpx + 0.3 白在深底上约 2.3:1，属于"可修正"入口提示，必须可读 */
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.done-session-row {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 8rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.055);
  color: rgba(220, 230, 255, 0.8);
}

.done-session-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.done-session-time {
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  color: rgba(228, 236, 255, 0.9);
}

.done-session-dur {
  font-size: 19rpx;
  color: rgba(167, 164, 255, 0.9);
}

/* 段列表右侧操作：纯文字按钮，加粗 + 异色区分修改/删除，无边框 */
.done-session-ops {
  flex: none;
  display: flex;
  align-items: center;
  /* 修改/删除是相邻的破坏性操作，3pt 的间距太容易误触；留出 8pt（margin 兼容老内核） */
}

.session-op {
  position: relative;
  min-height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.session-op.is-edit {
  color: var(--color-primary-soft);
}

.session-op.is-del {
  color: var(--color-danger);
}

/* 视觉 64rpx，命中区补到 88rpx（上下各 12rpx） */
.session-op::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -12rpx;
  bottom: -12rpx;
}

.session-op:active,
.session-op--tap {
  opacity: 0.5;
  transform: scale(0.94);
}

.manual-entry {
  position: relative;
  margin-top: 28rpx;
  min-height: 64rpx;
  height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: var(--btn-primary-bg);
  color: var(--btn-primary-fg);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: var(--btn-primary-shadow);
  text-decoration: none;
  transition: opacity 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
}

.manual-entry::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -12rpx;
  bottom: -12rpx;
}

.manual-entry:active,
.manual-entry--tap {
  opacity: 0.82;
  transform: scale(0.96);
  box-shadow: 0 4rpx 14rpx rgba(109, 104, 255, 0.22);
}

/* 超过 24h 的常驻提示：给出「结束并校准」与「丢弃这段」两个明确出口 */
.sleep-stale {
  width: 100%;
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(253, 230, 138, 0.08);
  border: 1rpx solid rgba(253, 230, 138, 0.22);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sleep-stale-title {
  font-size: 25rpx;
  font-weight: 600;
  color: rgba(253, 236, 190, 0.95);
}

.sleep-stale-sub {
  font-size: 21rpx;
  line-height: 1.5;
  color: rgba(226, 232, 240, 0.68);
}

.sleep-stale-actions {
  display: flex;
  margin-top: 10rpx;
}

.sleep-stale-btn {
  position: relative;
  min-height: 72rpx;
  padding: 0 26rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 23rpx;
  color: rgba(235, 242, 255, 0.92);
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.sleep-stale-btn::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -8rpx;
  bottom: -8rpx;
}

.sleep-stale-btn.is-ghost {
  background: transparent;
  border: 1rpx solid rgba(248, 113, 113, 0.42);
  color: rgba(252, 165, 165, 0.92);
}

.sleep-stale-btn--tap {
  opacity: 0.72;
  transform: scale(0.97);
}

/* 老内核没有 flex gap（iOS < 14.5 / 老安卓 X5）：按钮行/统计行用相邻兄弟 margin */
.done-cta-row .cta-mini + .cta-mini {
  margin-left: 20rpx;
}

.done-session-ops .session-op + .session-op {
  margin-left: 16rpx;
}

.sleep-stale-actions .sleep-stale-btn + .sleep-stale-btn {
  margin-left: 16rpx;
}

.stats-strip > text + text {
  margin-left: 12rpx;
}
