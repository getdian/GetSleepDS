<ambient />
<hero-backdrop />
<top-bar brand-only="{{true}}" style="display:block;width:100%;" />

<view class="page sleep-page">
  <view class="sleep-hero fade-up">
    <view class="sleep-hero-meta">
      <text class="sleep-eyebrow">TONIGHT</text>
      <text class="sleep-date">{{dateText}}</text>
    </view>
    <text class="sleep-title">{{heroTitle}}</text>
    <text class="sleep-sub">{{heroSub}}</text>
  </view>

  <view wx:if="{{notice}}" class="notice" bindtap="onNoticeClose">
    <text class="notice-text">{{notice}}</text>
    <text class="notice-close">知道了</text>
  </view>

  <block wx:if="{{state !== 'done'}}">
    <view class="orb-section fade-up {{state === 'sleeping' ? 'is-sleeping' : ''}}">
      <view class="orb-stage">
        <view class="orb-aura aura-a"></view>
        <view class="orb-aura aura-b"></view>
        <view class="orb-aura aura-c"></view>
        <view
          class="sleep-orb orb--{{state}}"
          bindtap="onPrimaryTap"
          aria-role="button"
          aria-label="{{state === 'sleeping' ? '记录起床时间' : '记录入睡时间'}}"
        >
          <text class="orb-kicker">{{orbKicker}}</text>
          <text class="orb-time">{{orbTime}}</text>
          <text class="orb-meta">{{orbMeta}}</text>
        </view>
      </view>
      <text class="orb-caption">{{orbCaption}}</text>
      <text wx:if="{{recordHint}}" class="orb-note">{{recordHint}}</text>
      <view wx:if="{{state === 'sleeping'}}" class="sleep-reminder {{reminderOn ? 'is-on' : ''}}" bindtap="onReminderTap">
        {{reminderOn ? '已开启到点提醒' : '到点提醒我结束'}}
      </view>
      <view wx:if="{{overdue}}" class="sleep-overdue" bindtap="openEndSheet">
        <text class="sleep-overdue-title">该结束入睡啦</text>
        <text class="sleep-overdue-sub">{{overdueText}} · 点此校准并保存</text>
      </view>
      <view wx:if="{{state === 'sleeping'}}" class="undo-bed" bindtap="onUndoBed">
        点错了？撤销本次入睡
      </view>
      <view wx:if="{{state === 'idle'}}" class="manual-entry" bindtap="openManualSheet">
        补记入睡
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="done-section fade-up">
      <text class="done-kicker">{{greeting}} · SLEEP LOG</text>
      <text class="done-duration">{{recordView.duration}}</text>
      <text class="done-duration-k">当天总睡眠（含午休/间断）</text>
      <view class="done-timeline">
        <view class="done-time">
          <text class="done-time-k">{{recordView.timelineFirstK}}</text>
          <text class="done-time-v">{{recordView.firstBed}}</text>
        </view>
        <view class="done-rail">
          <view class="done-rail-dot"></view>
          <view class="done-rail-line"></view>
          <view class="done-rail-dot is-end"></view>
        </view>
        <view class="done-time is-right">
          <text class="done-time-k">{{recordView.timelineLastK}}</text>
          <text class="done-time-v">{{recordView.lastWake}}</text>
        </view>
      </view>
      <view wx:if="{{recordView.sessions.length}}" class="done-sessions">
        <view class="done-sessions-head">
          <text class="done-sessions-k">本日睡眠段</text>
          <text class="done-sessions-hint">时间不准可修正</text>
        </view>
        <view wx:for="{{recordView.sessions}}" wx:key="id" class="done-session-row">
          <view class="done-session-main">
            <text class="done-session-time">{{item.bed}} – {{item.wake}}</text>
            <text class="done-session-dur">{{item.duration}}</text>
          </view>
          <view class="done-session-ops">
            <view class="session-op is-edit" data-id="{{item.id}}" data-day="{{item.day}}" catchtap="onEditSession">修改</view>
            <view class="session-op is-del" data-id="{{item.id}}" data-day="{{item.day}}" catchtap="onDeleteSession">删除</view>
          </view>
        </view>
      </view>
      <view class="done-cta-row">
        <view class="cta-mini is-primary" bindtap="onAddSession">继续入睡（开始计时）</view>
        <view class="cta-mini" bindtap="openManualSheet">补记入睡</view>
      </view>
      <view class="undo" bindtap="onUndoTap">记录有误？撤销当天记录</view>
    </view>
  </block>

  <view class="sleep-ad">
    <ad-slot slot-name="sleep" enabled="{{ads.sleep.enabled}}" unit-id="{{ads.sleep.unitId}}" type="{{ads.sleep.type}}" />
  </view>

  <view wx:if="{{weekCount > 0 || streak > 0}}" class="stats-strip fade-up" bindtap="goStats">
    <text class="stats-strip-main">本周 {{weekCount}} 天 · 连续 {{streak}} 天</text>
    <text class="stats-strip-link">查看统计 ›</text>
  </view>

  <view class="sleep-share">
    <share-btn text="分享今晚的睡眠" variant="link" />
  </view>

  <text class="sleep-quote font-poetic fade-up">{{footerText}}</text>
</view>

<audio-dock id="dock" />

<view wx:if="{{endShow}}" class="end-mask" catchtap="onEndCancel">
  <view class="end-sheet" catchtap="noop">
    <view class="end-head">
      <view>
        <text class="end-title">{{endMode === 'manual' ? '补记一段睡眠' : (endMode === 'edit' ? '修改这段睡眠' : '结束本次入睡')}}</text>
        <text class="end-sub">{{endMode === 'manual' ? '选择醒来日与真实入睡/起床时间，不会启动计时' : (endMode === 'edit' ? '只调整时间，归属日保持不变' : (endStale ? '超过 24 小时未结束：请确认真实醒来日与时间' : '时间不准可以直接改，保存后归入醒来日'))}}</text>
      </view>
      <text class="end-close" catchtap="onEndCancel">×</text>
    </view>
    <picker
      wx:if="{{endMode === 'manual' || endStale}}"
      mode="date"
      value="{{endDate}}"
      start="{{endDateMin}}"
      end="{{endToday}}"
      bindchange="onEndDateChange"
    >
      <view class="end-date-row">
        <text class="end-date-k">醒来日</text>
        <view class="end-date-v">
          <text>{{endDateText}}</text>
          <text class="end-date-arrow">›</text>
        </view>
      </view>
    </picker>
    <view class="end-times">
      <picker mode="time" value="{{endBedTime}}" data-field="endBedTime" bindchange="onEndTimeChange">
        <view class="end-time-item">
          <text class="end-time-k">入睡</text>
          <text class="end-time-v">{{endBedTime}}</text>
        </view>
      </picker>
      <text class="end-arrow">→</text>
      <picker mode="time" value="{{endWakeTime}}" data-field="endWakeTime" bindchange="onEndTimeChange">
        <view class="end-time-item">
          <text class="end-time-k">起床</text>
          <text class="end-time-v">{{endWakeTime}}</text>
        </view>
      </picker>
    </view>
    <view class="end-summary">
      <text wx:if="{{endStartDateText}}">入睡 {{endStartDateText}}</text>
      <text wx:if="{{endStartDateText}}">·</text>
      <text>归入 {{endDayText}}（醒来日）</text>
      <text>·</text>
      <text>时长 {{endDurationText}}</text>
    </view>
    <text wx:if="{{endHint}}" class="end-hint">{{endHint}}</text>
    <text wx:if="{{endError}}" class="end-error">{{endError}}</text>
    <view class="end-actions">
      <view class="end-btn ghost" catchtap="onEndCancel">取消</view>
      <view class="end-btn primary {{endError ? 'is-disabled' : ''}}" catchtap="onEndConfirm">{{endMode === 'manual' ? '保存补记' : (endMode === 'edit' ? '保存修改' : '保存记录')}}</view>
    </view>
  </view>
</view>

<view class="dim-mask {{dim ? 'is-on' : ''}}" bindtap="onDimTap">
  <text class="dim-text font-poetic">晚安</text>
</view>

<custom-tab-bar />
