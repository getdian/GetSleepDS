<ambient />
<hero-backdrop />
<top-bar brand-only="{{true}}" style="display:block;width:100%;" />

<view class="page sleep-page" bindtouchstart="onPageTouch">
  <view class="sleep-hero fade-up">
    <view class="sleep-hero-meta">
      <text class="sleep-eyebrow">SLEEP LOG</text>
      <text class="sleep-date">{{dateText}}</text>
    </view>
    <text class="sleep-title">{{heroTitle}}</text>
    <text class="sleep-sub">{{heroSub}}</text>
  </view>

  <view wx:if="{{notice}}" class="notice" bindtap="onNoticeClose" hover-class="notice--tap" hover-stay-time="100">
    <text class="notice-text">{{notice}}</text>
    <text class="notice-close">知道了</text>
  </view>

  <block wx:if="{{state !== 'done'}}">
    <view class="orb-section fade-up {{state === 'sleeping' ? 'is-sleeping' : ''}}">
      <view class="orb-stage">
        <view class="orb-aura aura-a"></view>
        <view class="orb-aura aura-b"></view>
        <view class="orb-aura aura-c"></view>
        <view
          class="sleep-orb orb--{{state}}"
          bindtap="onPrimaryTap"
          hover-class="sleep-orb--tap"
          hover-stay-time="120"
          aria-role="button"
          aria-label="{{state === 'sleeping' ? '记录起床时间' : '记录入睡时间'}}"
        >
          <text class="orb-kicker">{{orbKicker}}</text>
          <text class="orb-time">{{orbTime}}</text>
          <text class="orb-meta">{{orbMeta}}</text>
        </view>
      </view>
      <text class="orb-caption">{{orbCaption}}</text>
      <text wx:if="{{recordHint}}" class="orb-note">{{recordHint}}</text>
      <view wx:if="{{state === 'sleeping'}}" class="sleep-reminder {{reminderOn ? 'is-on' : ''}}" bindtap="onReminderTap" hover-class="sleep-reminder--tap" hover-stay-time="120">
        {{reminderOn ? '已开启 · 到点提醒记录起床' : '到点提醒我记录起床'}}
      </view>
      <view wx:if="{{overdue}}" class="sleep-overdue" bindtap="openEndSheet" hover-class="sleep-overdue--tap" hover-stay-time="120">
        <text class="sleep-overdue-title">该结束入睡啦</text>
        <text class="sleep-overdue-sub">{{overdueText}} · 点此校准并保存</text>
      </view>
      <view wx:if="{{state === 'sleeping'}}" class="sleeping-sub-actions">
        <view class="undo-bed" bindtap="onUndoBed" hover-class="undo-bed--tap" hover-stay-time="120">点错了？撤销本次入睡</view>
        <view class="sleeping-share">
          <share-btn text="分享这一段睡眠" variant="icon" />
        </view>
      </view>
      <view wx:if="{{state === 'idle'}}" class="manual-entry" bindtap="openManualSheet" hover-class="manual-entry--tap" hover-stay-time="120">
        补记入睡
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="done-section fade-up">
      <text class="done-kicker">{{greeting}} · SLEEP LOG</text>
      <block wx:if="{{recordView}}">
        <text class="done-duration">{{recordView.duration}}</text>
        <text class="done-duration-k">当天总睡眠（含午休/间断）</text>
        <view class="done-timeline">
          <view class="done-time">
            <text class="done-time-k">{{recordView.timelineFirstK}}</text>
            <text class="done-time-v">{{recordView.firstBed}}</text>
          </view>
          <view class="done-rail">
            <view class="done-rail-dot"></view>
            <view class="done-rail-track">
              <view
                wx:for="{{recordView.timeline}}"
                wx:key="key"
                class="done-rail-seg"
                style="left: {{item.left}}%; width: {{item.width}}%"
              ></view>
            </view>
            <view class="done-rail-dot is-end"></view>
          </view>
          <view class="done-time is-right">
            <text class="done-time-k">{{recordView.timelineLastK}}</text>
            <text class="done-time-v">{{recordView.lastWake}}</text>
          </view>
        </view>
        <text wx:if="{{recordView.segmentsText}}" class="done-segments-text">{{recordView.segmentsText}}</text>
        <view wx:if="{{recordView.sessionCount > 0}}" class="done-sessions">
          <view class="done-sessions-head">
            <text class="done-sessions-k">本日睡眠段</text>
            <text class="done-sessions-hint">时间不准可修正</text>
          </view>
          <view wx:for="{{recordView.sessions}}" wx:key="id" class="done-session-row">
            <view class="done-session-main">
              <text class="done-session-time">{{item.bed}} – {{item.wake}}</text>
              <text class="done-session-dur">{{item.duration}}</text>
            </view>
            <view class="done-session-ops">
              <view class="session-op is-edit" data-id="{{item.id}}" data-day="{{item.day}}" catchtap="onEditSession" hover-class="session-op--tap" hover-stay-time="100">修改</view>
              <view class="session-op is-del" data-id="{{item.id}}" data-day="{{item.day}}" catchtap="onDeleteSession" hover-class="session-op--tap" hover-stay-time="100">删除</view>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="done-empty">
        <text class="done-empty-text">{{recordHint || '这条记录缺少可用的睡眠段，可撤销后重新记录'}}</text>
      </view>
      <view class="done-cta-row">
        <view class="cta-mini is-primary" bindtap="onAddSession" hover-class="cta-mini--tap" hover-stay-time="120">继续入睡（开始计时）</view>
        <view class="cta-mini" bindtap="openManualSheet" hover-class="cta-mini--tap" hover-stay-time="120">补记入睡</view>
      </view>
      <view class="undo" bindtap="onUndoTap" hover-class="undo--tap" hover-stay-time="120">记录有误？撤销当天记录</view>
    </view>
  </block>

  <view class="sleep-ad">
    <ad-slot slot-name="sleep" enabled="{{ads.sleep.enabled}}" unit-id="{{ads.sleep.unitId}}" type="{{ads.sleep.type}}" />
  </view>

  <view wx:if="{{weekCount > 0 || streak > 0}}" class="stats-strip fade-up" bindtap="goStats" hover-class="stats-strip--tap" hover-stay-time="120">
    <text class="stats-strip-main">本周 {{weekCount}} 天 · 连续 {{streak}} 天</text>
    <text class="stats-strip-link">查看统计 ›</text>
  </view>

  <view wx:if="{{state !== 'sleeping'}}" class="sleep-share">
    <share-btn text="分享这一段睡眠" variant="icon" />
  </view>

  <text class="sleep-quote font-poetic fade-up">{{footerText}}</text>
</view>

<audio-dock id="dock" bind:sheetclose="onDockSheetClose" />

<view wx:if="{{endShow}}" class="end-mask" catchtap="onEndCancel" catchtouchmove="noop">
  <view
    class="end-sheet"
    catchtap="noop"
    catchtouchmove="noop"
    aria-role="dialog"
    aria-label="{{endMode === 'manual' ? '补记一段睡眠' : (endMode === 'edit' ? '修改这段睡眠' : '结束本次入睡')}}"
  >
    <view class="end-head">
      <view>
        <text class="end-title">{{endMode === 'manual' ? '补记一段睡眠' : (endMode === 'edit' ? '修改这段睡眠' : '结束本次入睡')}}</text>
        <text class="end-sub">{{endMode === 'manual' ? '选择醒来日与真实入睡/起床时间，不会启动计时' : (endMode === 'edit' ? '只调整时间，归属日保持不变' : (endStale ? '超过 24 小时未结束：请确认真实醒来日与时间' : '时间不准可以直接改，保存后归入醒来日'))}}</text>
      </view>
      <text class="end-close" catchtap="onEndCancel" aria-role="button" aria-label="关闭" hover-class="end-close--tap" hover-stay-time="100">×</text>
    </view>
    <picker
      wx:if="{{endMode === 'manual' || endStale}}"
      mode="date"
      value="{{endDate}}"
      start="{{endDateMin}}"
      end="{{endToday}}"
      bindchange="onEndDateChange"
    >
      <view class="end-date-row" hover-class="end-date-row--tap" hover-stay-time="100">
        <text class="end-date-k">醒来日</text>
        <view class="end-date-v">
          <text>{{endDateText}}</text>
          <text class="end-date-arrow">›</text>
        </view>
      </view>
    </picker>
    <view class="end-times">
      <picker mode="time" value="{{endBedTime}}" data-field="endBedTime" bindchange="onEndTimeChange">
        <view class="end-time-item" hover-class="end-time-item--tap" hover-stay-time="100">
          <text class="end-time-k">入睡</text>
          <text class="end-time-v">{{endBedTime}}</text>
        </view>
      </picker>
      <text class="end-arrow">→</text>
      <picker mode="time" value="{{endWakeTime}}" data-field="endWakeTime" bindchange="onEndTimeChange">
        <view class="end-time-item" hover-class="end-time-item--tap" hover-stay-time="100">
          <text class="end-time-k">起床</text>
          <text class="end-time-v">{{endWakeTime}}</text>
        </view>
      </picker>
    </view>
    <view class="end-summary">
      <text wx:if="{{endStartDateText}}">入睡 {{endStartDateText}}</text>
      <text wx:if="{{endStartDateText}}">·</text>
      <text>归入 {{endDayText}}（醒来日）</text>
      <text>·</text>
      <text>时长 {{endDurationText}}</text>
    </view>
    <text wx:if="{{endHint}}" class="end-hint">{{endHint}}</text>
    <text wx:if="{{endError}}" class="end-error">{{endError}}</text>
    <view class="end-actions">
      <view class="end-btn ghost" catchtap="onEndCancel" hover-class="end-btn--tap" hover-stay-time="120">取消</view>
      <view class="end-btn primary {{endError ? 'is-disabled' : ''}}" catchtap="onEndConfirm" hover-class="end-btn--tap" hover-stay-time="120">{{endMode === 'manual' ? '保存补记' : (endMode === 'edit' ? '保存修改' : '保存记录')}}</view>
    </view>
  </view>
</view>

<view class="dim-mask {{dim ? 'is-on' : ''}}" catchtap="onDimTap" catchtouchmove="noop">
  <text class="dim-kicker">已入睡</text>
  <view class="dim-orb">
    <text class="dim-orb-kicker">入睡时间</text>
    <text class="dim-orb-time">{{orbTime}}</text>
    <text class="dim-orb-meta">{{orbMeta}}</text>
  </view>
  <text class="dim-hint">轻触任意处唤醒</text>
</view>

<custom-tab-bar />
