/* 补记面板样式与入睡页共用一份，见 styles/sheet.wxss */
@import "../../styles/sheet.wxss";

/* 跨页播放器宿主：压在页面内容之上，避免底部内容拦截音符点击 */
.np-host {
  position: relative;
  z-index: var(--z-player-host, 120);
}

.stats-page {
  padding-top: 8rpx;
  /* .page 已带 200rpx + safe-area 的底部让位；统计页底部由 .safe-bottom 单独算一次。
     两处叠加会变成 380rpx + 两个 safe-area（iPhone 14 约 267pt），页脚像被推到了半屏。 */
  padding-bottom: 0;
}

/* 底部清场：音符/播放条从 176rpx 起、高 108rpx，浮动动画顶点约 292rpx。
   这里一次给 300rpx + safe-area，盖过音符带；页脚广告位在 spacer 之前，
   实载时只会把「数据与备份」抬得更高，不会再出现两段让位相加。 */
.stats-page .safe-bottom {
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

.stats-hero {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 34rpx;
}

.stats-hero .title-xl {
  margin-top: 4rpx;
}

/* 指标周期：本周还没打卡时会回退到最近 7 天，周期与区间必须在首屏可见，
   否则回退后用户会把 7 天数据读成"本周"，或者以为历史记录丢了 */
.metrics-period {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
}

.metrics-period-label {
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--text-secondary);
}

.metrics-period-range {
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
  color: var(--text-muted);
}

.metrics-period-note {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 3 列核心指标：大数字 + 短标签 + 一行变化；点击展开说明。
   层级只用字号/颜色/留白表达，不加底不加框 */
.metrics {
  display: flex;
  align-items: stretch;
  margin-top: 8rpx;
}

.metric {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 4rpx 16rpx;
  border-radius: var(--radius-md);
  transition: background 0.15s ease, opacity 0.15s ease, transform 0.15s ease;
}

.metric:active,
.metric--tap {
  opacity: 0.72;
  transform: scale(0.97);
}

/* 弱竖线隔离：上下两端淡出的微光竖线，不顶格，晶莹通透 */
.metric + .metric::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18%;
  height: 64%;
  width: 1rpx;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.02) 0%,
    rgba(180, 200, 255, 0.22) 50%,
    rgba(255, 255, 255, 0.02) 100%
  );
  pointer-events: none;
}

.metric.is-active {
  background: rgba(129, 140, 248, 0.1);
}

.metric-value {
  font-size: 44rpx;
  line-height: 1.1;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  color: rgba(225, 235, 255, 0.82);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.metric-key {
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 1rpx;
  color: var(--text-muted);
  white-space: nowrap;
}

.metric-sub {
  max-width: 100%;
  font-size: 18rpx;
  line-height: 1.2;
  color: rgba(175, 195, 240, 0.72);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 主指标（平均睡眠）：样式略强，字号更大、纯白高亮、层次鲜明 */
.metric--duration .metric-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 16rpx rgba(139, 135, 255, 0.3);
}

.metric--duration .metric-key {
  font-size: 21rpx;
  font-weight: 500;
  color: rgba(230, 240, 255, 0.92);
}

.metric--duration .metric-sub {
  font-size: 19rpx;
  color: var(--color-primary-soft);
}

.metrics-empty {
  padding: 24rpx 0 4rpx;
}

.metrics-empty-title {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
}

.metrics-empty-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 点指标后的事实说明：3 行以内，口径/对比/极值都在这里 */
.metric-detail {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--border-moon-subtle);
}

.md-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.md-title {
  font-size: 24rpx;
  color: var(--text-primary);
}

.md-value {
  font-size: 24rpx;
  color: var(--color-primary-soft);
  font-variant-numeric: tabular-nums;
}

.md-line {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

/* 操作引导：指标可点展开是隐藏交互，用一行居中弱字提示；展开后隐藏 */
.week-line {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
}

.week-hint {
  font-size: 20rpx;
  line-height: 1;
  /* 它是指标展开的唯一提示（隐藏交互入口），不能再用 opacity 压低对比度 */
  color: var(--text-secondary);
}

/* 日历周期切换 */
/* 周期选项：当前项加简洁无边框弱背景胶囊 */
.span-tabs {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.span-tab {
  position: relative;
  min-height: 52rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--text-muted);
  white-space: nowrap;
  border: none;
  background: transparent;
  transition: background 0.16s ease, color 0.16s ease, opacity 0.16s ease, transform 0.16s ease;
}

/* 52rpx 视觉高度 + 上下各 18rpx 外扩 = 88rpx 热区（三个标签间距足够） */
.span-tab::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -18rpx;
  bottom: -18rpx;
}

.span-tab:active,
.span-tab--tap {
  opacity: 0.65;
  transform: scale(0.95);
}

.span-tab.is-on {
  font-size: 23rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.12);
}
/* 分区：无框，层级只靠标题与间距 */
.section {
  margin-top: 56rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-family: var(--font-cn-serif);
  font-size: 30rpx;
  letter-spacing: 3rpx;
  color: var(--text-primary);
}

.section-tag {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 日历图例：4 段连成一条色阶（弱 → 强），下方对齐标区间。
   分开的 4 个小方块读不出"连续强度"，也容易被当成 4 个独立图例 */
.cal-legend {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 22rpx;
  padding: 0 44rpx;
}

.cal-legend-scale {
  display: flex;
  align-items: stretch;
  height: 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
}

.cal-swatch {
  flex: 1;
  height: 100%;
}

.cal-swatch.lv-1 { background: #5A57C8; }
.cal-swatch.lv-2 { background: #6C68E8; }
.cal-swatch.lv-3 { background: #8A90FF; }
.cal-swatch.lv-4 { background: #A5B4FC; }

.cal-legend-labels {
  display: flex;
}

.cal-legend-lab {
  flex: 1;
  text-align: center;
  font-size: 19rpx;
  color: var(--text-muted);
  opacity: 0.8;
}

/* 点格子后的固定详情卡 */
.day-detail {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--border-moon-subtle);
}

.dd-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.dd-title {
  font-size: 24rpx;
  color: var(--text-primary);
}

.dd-tag {
  flex: none;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-glow);
  font-size: 18rpx;
  color: var(--color-primary-soft);
}

.dd-main {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.dd-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

/* 已记录日的补记入口：多段模型下"这天再加一段"不该只藏在入睡页 */
.dd-add {
  margin-top: 8rpx;
  min-height: 56rpx;
  display: inline-flex;
  align-items: center;
  font-size: 21rpx;
  color: var(--color-primary);
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.dd-add:active,
.dd-add--tap {
  opacity: 0.52;
  transform: scale(0.97);
}

/* 分区底部行：左侧记录数、右侧海报入口 */
.section-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
}

.heat-note {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.section-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.poster-btn:active,
.poster-btn--tap,
.sync-btn:active,
.sync-btn--tap,
.cloud-del:active,
.cloud-del--tap,
.danger-entry:active,
.danger-entry--tap,
.sync-toggle-hit:active,
.settings-head:active,
.settings-head--tap {
  opacity: 0.65;
}

/* 淡紫玻璃胶囊：图标 + 文案，低对比度 action，不抢结论区 */
.poster-btn {
  position: relative;
  flex: none;
  height: 64rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(129, 140, 248, 0.16);
  background: rgba(129, 140, 248, 0.14);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
  color: #C7CDFB;
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.poster-btn:active,
.poster-btn--tap {
  opacity: 0.72;
  transform: scale(0.96);
}

/* 视觉 64rpx 的胶囊，可点区域补到 80rpx；与旁边的分享图标拉开间距防误触 */
.poster-btn::after {
  content: "";
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  top: -8rpx;
  bottom: -8rpx;
}

.poster-spark {
  font-size: 24rpx;
  line-height: 1;
  color: #C7CDFB;
}

/* 数据与备份：默认收起，只露一行状态 */
.settings {
  margin-top: 56rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--border-moon-subtle);
}

.settings-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
  transition: opacity 0.16s ease;
}

.settings-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.settings-title {
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  color: var(--text-primary);
}

.settings-sub {
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.settings-toggle {
  flex: none;
  padding: 12rpx 0 12rpx 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-primary);
}

.settings-body {
  padding-top: 4rpx;
}

/* 云同步：折叠区内只留胶囊按钮 */
.sync-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 12rpx;
}

.sync-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.sync-title {
  font-size: 22rpx;
  color: var(--text-primary);
}

.sync-sub {
  font-size: 18rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.sync-ops {
  flex: none;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 自绘开关：原生 switch 缩到 0.8 后在深色底上开关态几乎看不出，
   这里用轨道 + 滑块 + 开启态发光表达状态，热区仍保持 80rpx 高 */
.sync-toggle-hit {
  flex: none;
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.sync-toggle {
  position: relative;
  width: 88rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: rgba(148, 163, 184, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.sync-toggle.is-on {
  background: rgba(129, 140, 248, 0.85);
  border-color: rgba(158, 168, 255, 0.9);
  box-shadow: 0 0 12rpx rgba(129, 140, 248, 0.45);
}

.sync-toggle-knob {
  position: absolute;
  left: 4rpx;
  top: 5rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F8FAFC;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.35);
  transition: transform 0.2s ease;
}

.sync-toggle.is-on .sync-toggle-knob {
  transform: translateX(38rpx);
}

/* 轻量动作：去掉矩形边框与底色，只留「刷新图标 + 同步」。
   视觉高度与右侧开关轨道（52rpx）对齐；触控热区仍用 ::after 外扩。 */
.sync-btn {
  position: relative;
  height: 52rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 6rpx;
  font-size: 22rpx;
  line-height: 1;
  color: var(--color-primary);
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.sync-btn:active,
.sync-btn--tap {
  opacity: 0.55;
  transform: scale(0.96);
}

.sync-btn::after {
  content: "";
  position: absolute;
  left: -12rpx;
  right: -12rpx;
  top: -16rpx;
  bottom: -16rpx;
}

/* 刷新图标：CSS 画开口圆 + 箭头，避免 emoji/字体字形漂移 */
.sync-ico {
  position: relative;
  flex: none;
  width: 22rpx;
  height: 22rpx;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  border-right-color: transparent;
  transform: rotate(-40deg);
}

.sync-ico::after {
  content: "";
  position: absolute;
  right: -3rpx;
  top: -3rpx;
  width: 0;
  height: 0;
  border-left: 7rpx solid currentColor;
  border-top: 4rpx solid transparent;
  border-bottom: 4rpx solid transparent;
  transform: rotate(38deg);
}

@keyframes sync-spin {
  to {
    transform: rotate(320deg);
  }
}

.sync-btn.is-busy .sync-ico {
  animation: sync-spin 0.9s linear infinite;
}

.sync-btn.is-busy {
  opacity: 0.5;
}

/* 关闭云备份但仍保留云端副本时的独立删除入口 */
.cloud-del {
  margin-top: 6rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 20rpx;
  color: var(--text-secondary);
  text-decoration: underline;
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.cloud-del:active,
.cloud-del--tap {
  opacity: 0.52;
  transform: scale(0.98);
}

/* 清除数据入口：居中，红色链接标题 + 灰色说明行 */
.stats-page .danger-entry {
  margin-top: 26rpx;
  padding: 8rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.stats-page .danger-entry:active,
.stats-page .danger-entry--tap {
  opacity: 0.55;
  transform: scale(0.98);
}

.stats-page .danger-entry-title {
  font-size: 26rpx;
  color: var(--color-danger-soft, #F87171);
  text-decoration: underline;
}

.stats-page .danger-entry-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

.poster-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 600px;
  height: 960px;
}

.share-canvas {
  position: fixed;
  left: -2200px;
  top: 0;
  width: 600px;
  height: 480px;
}

/* 回顾 → 行动：按本周均值定今晚入睡点 */
.week-plan {
  position: relative;
  margin-top: 16rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(145, 175, 255, 0.12);
  border: 1rpx solid rgba(145, 175, 255, 0.26);
}

.week-plan-k {
  font-size: 24rpx;
  color: rgba(226, 235, 255, 0.92);
}

.week-plan-arrow {
  font-size: 26rpx;
  color: var(--color-primary-soft, #A7A4FF);
}

.week-plan--tap {
  background: rgba(145, 175, 255, 0.2);
}
