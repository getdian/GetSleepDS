.stats-page {
  padding-top: 8rpx;
}

.stats-hero {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 34rpx;
}

.stats-hero .title-xl {
  margin-top: 4rpx;
}

/* 数据带：无框三列，大数字在上、说明在下，列间一根极淡竖线 */
.metrics {
  display: flex;
  align-items: stretch;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0 6rpx;
}

.metric + .metric {
  border-left: 1rpx solid var(--border-moon-subtle);
}

/* 字阶：18 工具字 / 22 次要信息 / 28 正文 / 30 分区标题 / 48 数据 / 56 页标题 */
.metric-key {
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
}

.metric-value {
  font-family: var(--font-cn-serif);
  font-size: 48rpx;
  line-height: 1.1;
  color: var(--text-moon-pure);
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

.metric-value.is-small {
  font-size: 30rpx;
  padding-top: 12rpx;
}

.week-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 28rpx 0 0;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--color-accent-moon);
  opacity: 0.82;
}

.week-dot {
  opacity: 0.5;
}

/* 分区：无框，层级只靠标题与间距；焦点块例外（玻璃卡） */
.section {
  margin-top: 56rpx;
}

/* 焦点块：本页唯一玻璃质感容器（打卡热力图） */
.section-hero {
  padding: 26rpx 24rpx;
  border-radius: var(--radius-xl);
  background: var(--glass-card-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--border-moon-subtle);
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.26);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-family: var(--font-cn-serif);
  font-size: 30rpx;
  letter-spacing: 3rpx;
  color: var(--text-primary);
}

.section-tag {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 固定范围说明：只做标注，不再提供切换（高度刻意压低，不与标题抢层级） */
.range-tag {
  font-size: 18rpx;
  line-height: 1;
  letter-spacing: 1rpx;
  color: var(--text-muted);
}

/* 分区底部行：左侧记录数、右侧海报入口 */
.section-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
}

/* 左侧说明可压缩但绝不换行（空间不足时省略，不把按钮挤成两行） */
.heat-note {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.poster-btn:active,
.sync-btn:active,
.cloud-del:active,
.danger-entry:active,
.fact-retry:active {
  opacity: 0.68;
}

.section-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 淡紫玻璃胶囊：图标 + 文案，低对比度 action，不抢热力图的视觉重心 */
.poster-btn {
  flex: none;
  height: 64rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(129, 140, 248, 0.16);
  background: rgba(129, 140, 248, 0.14);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
  color: #C7CDFB;
}

.poster-spark {
  font-size: 24rpx;
  line-height: 1;
  color: #C7CDFB;
}

/* 事实回顾 */
.fact-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.9;
  letter-spacing: 0.5rpx;
  color: var(--text-primary);
}

.fact-muted {
  display: block;
  font-size: 24rpx;
  text-align: center;
  color: var(--text-secondary);
}

.fact-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.fact-retry {
  min-height: 80rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-glow);
  font-size: 22rpx;
  color: var(--color-primary);
}

.poster-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 600px;
  height: 960px;
}

.share-canvas {
  position: fixed;
  left: -2200px;
  top: 0;
  width: 600px;
  height: 480px;
}

/* 云同步：hairline 之下进入操作区，组件只留胶囊按钮 */
.sync-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 56rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--border-moon-subtle);
}

.sync-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sync-ops {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 自绘开关：原生 switch 缩到 0.8 后在深色底上开关态几乎看不出，
   这里用轨道 + 滑块 + 开启态发光表达状态，热区仍保持 80rpx 高 */
.sync-toggle-hit {
  flex: none;
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.sync-toggle {
  position: relative;
  width: 88rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: rgba(148, 163, 184, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.sync-toggle.is-on {
  background: rgba(129, 140, 248, 0.85);
  border-color: rgba(158, 168, 255, 0.9);
  box-shadow: 0 0 12rpx rgba(129, 140, 248, 0.45);
}

.sync-toggle-knob {
  position: absolute;
  left: 4rpx;
  top: 5rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F8FAFC;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.35);
  transition: transform 0.2s ease;
}

.sync-toggle.is-on .sync-toggle-knob {
  transform: translateX(38rpx);
}

.sync-title {
  font-size: 24rpx;
  color: var(--text-primary);
}

.sync-sub {
  font-size: 20rpx;
  color: var(--text-muted);
}

.sync-btn {
  min-height: 80rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 26rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-glow);
  font-size: 22rpx;
  color: var(--color-primary);
}

.sync-btn.is-busy {
  opacity: 0.5;
}

/* 关闭云备份但仍保留云端副本时的独立删除入口 */
.cloud-del {
  margin-top: 6rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 20rpx;
  color: var(--text-secondary);
  text-decoration: underline;
}

/* 清除数据入口：居中，红色链接标题 + 灰色说明行 */
.stats-page .danger-entry {
  margin-top: 36rpx;
  padding: 8rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-page .danger-entry-title {
  font-size: 26rpx;
  color: #F87171;
  text-decoration: underline;
}

.stats-page .danger-entry-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}
