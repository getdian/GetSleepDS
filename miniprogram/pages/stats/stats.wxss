.stats-page {
  padding-top: 8rpx;
}

.stats-hero {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 34rpx;
}

.stats-hero .title-xl {
  margin-top: 4rpx;
}

/* 数据带：无框三列，大数字在上、说明在下，列间一根极淡竖线 */
.metrics {
  display: flex;
  align-items: stretch;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0 6rpx;
}

.metric + .metric {
  border-left: 1rpx solid var(--border-moon-subtle);
}

/* 字阶：18 工具字 / 22 次要信息 / 28 正文 / 30 分区标题 / 48 数据 / 56 页标题 */
.metric-key {
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
}

.metric-value {
  font-family: var(--font-cn-serif);
  font-size: 48rpx;
  line-height: 1.1;
  color: var(--text-moon-pure);
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

.metric-value.is-small {
  font-size: 30rpx;
  padding-top: 12rpx;
}

.week-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 28rpx 0 0;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--color-accent-moon);
  opacity: 0.82;
}

.week-dot {
  opacity: 0.5;
}

/* 分区：无框，层级只靠标题与间距；焦点块例外（玻璃卡） */
.section {
  margin-top: 56rpx;
}

/* 焦点块：本页唯一玻璃质感容器（打卡热力图） */
.section-hero {
  padding: 26rpx 24rpx;
  border-radius: var(--radius-xl);
  background: var(--glass-card-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--border-moon-subtle);
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.26);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-family: var(--font-cn-serif);
  font-size: 30rpx;
  letter-spacing: 3rpx;
  color: var(--text-primary);
}

.section-tag {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 分段选择器：可交互组件，保留自身形状 */
.seg {
  display: flex;
  padding: 4rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  background: var(--glass-tint);
}

.seg-item {
  min-height: 80rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 22rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  color: var(--text-muted);
  transition: all 0.2s ease;
}

.seg-item.is-on {
  background: var(--glass-card-active);
  color: var(--text-primary);
}

/* 分区底部行：左侧记录数、右侧海报入口 */
.section-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.heat-note {
  font-size: 20rpx;
  color: var(--text-muted);
}

.seg-item:active,
.poster-btn:active,
.sync-btn:active,
.cloud-del:active,
.danger-entry:active,
.fact-retry:active {
  opacity: 0.68;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.poster-btn {
  min-height: 80rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-glow);
  font-size: 22rpx;
  color: var(--color-primary);
}

/* 事实回顾 */
.fact-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.9;
  letter-spacing: 0.5rpx;
  color: var(--text-primary);
}

.fact-muted {
  display: block;
  font-size: 24rpx;
  text-align: center;
  color: var(--text-secondary);
}

.fact-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.fact-retry {
  min-height: 80rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-glow);
  font-size: 22rpx;
  color: var(--color-primary);
}

.poster-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 600px;
  height: 960px;
}

.share-canvas {
  position: fixed;
  left: -2200px;
  top: 0;
  width: 600px;
  height: 480px;
}

/* 云同步：hairline 之下进入操作区，组件只留胶囊按钮 */
.sync-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 56rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--border-moon-subtle);
}

.sync-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sync-ops {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sync-switch {
  transform: scale(0.8);
  transform-origin: right center;
}

.sync-title {
  font-size: 24rpx;
  color: var(--text-primary);
}

.sync-sub {
  font-size: 20rpx;
  color: var(--text-muted);
}

.sync-btn {
  min-height: 80rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 26rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-glow);
  font-size: 22rpx;
  color: var(--color-primary);
}

.sync-btn.is-busy {
  opacity: 0.5;
}

/* 关闭云备份但仍保留云端副本时的独立删除入口 */
.cloud-del {
  margin-top: 6rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 20rpx;
  color: var(--text-secondary);
  text-decoration: underline;
}

/* 清除数据入口：居中，红色链接标题 + 灰色说明行 */
.stats-page .danger-entry {
  margin-top: 36rpx;
  padding: 8rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-page .danger-entry-title {
  font-size: 26rpx;
  color: #F87171;
  text-decoration: underline;
}

.stats-page .danger-entry-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}
