/* 补记面板样式与入睡页共用一份，见 styles/sheet.wxss */
@import "../../styles/sheet.wxss";

/* 跨页播放器宿主：压在页面内容之上，避免底部内容拦截音符点击 */
.np-host {
  position: relative;
  z-index: var(--z-player-host, 120);
}

.stats-page {
  padding-top: 8rpx;
}

/* 底部清场（档位经运营定为 180rpx）：音符/播放条从 176rpx 起、高 108rpx，
   浮动动画顶点约 292rpx。180rpx + 页脚广告位（待载约 100rpx / 实载更高）≈ 320rpx，
   「数据与备份」行在 resting 位置高出音符带——截图里的压住即修复。
   已知代价（几何决定，非缺陷）：① 页脚广告实载时会落在音符带内、下部被音符遮；
   ② 广告位关闭/加载失败（高度 0）时，行会落回音符带、重新被压住。
   要两者都避免需把清场加到 292rpx 以上（约 300rpx），或给 settings-head
   加右内边距让「展开」避开音符列——按运营取舍留 180。 */
.stats-page .safe-bottom {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.stats-hero {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 34rpx;
}

.stats-hero .title-xl {
  margin-top: 4rpx;
}

/* 3 列核心指标：大数字 + 短标签 + 一行变化；点击展开说明。
   层级只用字号/颜色/留白表达，不加底不加框 */
.metrics {
  display: flex;
  align-items: stretch;
  margin-top: 8rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 2rpx 16rpx;
  border-radius: var(--radius-md);
  transition: background 0.15s ease;
}

.metric + .metric {
  border-left: 1rpx solid var(--border-moon-subtle);
}

.metric.is-active {
  background: rgba(129, 140, 248, 0.1);
}

.metric-value {
  font-size: 48rpx;
  line-height: 1.1;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  color: var(--text-moon-pure);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.metric-key {
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 1rpx;
  color: var(--text-muted);
  white-space: nowrap;
}

.metric-sub {
  max-width: 100%;
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--color-primary-soft);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.metrics-empty {
  padding: 24rpx 0 4rpx;
}

.metrics-empty-title {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
}

.metrics-empty-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 点指标后的事实说明：3 行以内，口径/对比/极值都在这里 */
.metric-detail {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--border-moon-subtle);
}

.md-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.md-title {
  font-size: 24rpx;
  color: var(--text-primary);
}

.md-value {
  font-size: 24rpx;
  color: var(--color-primary-soft);
  font-variant-numeric: tabular-nums;
}

.md-line {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

/* 操作引导：指标可点展开是隐藏交互，用一行居中弱字提示；展开后隐藏 */
.week-line {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
}

.week-hint {
  font-size: 19rpx;
  line-height: 1;
  color: var(--text-muted);
  opacity: 0.75;
}

/* 日历周期切换 */
/* 周期选项：纯文字无边框；当前项更深、更大、更粗 */
.span-tabs {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.span-tab {
  min-height: 56rpx;
  display: inline-flex;
  align-items: center;
  padding: 6rpx 0;
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--text-muted);
  white-space: nowrap;
}

.span-tab.is-on {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}
/* 分区：无框，层级只靠标题与间距 */
.section {
  margin-top: 56rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-family: var(--font-cn-serif);
  font-size: 30rpx;
  letter-spacing: 3rpx;
  color: var(--text-primary);
}

.section-tag {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-moon-subtle);
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 日历图例：只留档位色块，整体压弱不抢格子本身 */
.cal-legend {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.cal-legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  /* 去掉外层 opacity（原 0.6 叠 --text-muted 后约 2.7:1），18→20rpx */
  font-size: 20rpx;
  color: var(--text-secondary);
}

.cal-swatch {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
}

.cal-swatch.lv-1 { background: #3F3C9E; }
.cal-swatch.lv-2 { background: #5B57D6; }
.cal-swatch.lv-3 { background: #B4BEFF; }
.cal-swatch.lv-4 { background: #E0E7FF; }

/* 点格子后的固定详情卡 */
.day-detail {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--border-moon-subtle);
}

.dd-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.dd-title {
  font-size: 24rpx;
  color: var(--text-primary);
}

.dd-tag {
  flex: none;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-glow);
  font-size: 18rpx;
  color: var(--color-primary-soft);
}

.dd-main {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.dd-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

/* 分区底部行：左侧记录数、右侧海报入口 */
.section-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
}

.heat-note {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.section-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.poster-btn:active,
.sync-btn:active,
.cloud-del:active,
.danger-entry:active,
.sync-toggle-hit:active,
.settings-head:active {
  opacity: 0.68;
}

/* 淡紫玻璃胶囊：图标 + 文案，低对比度 action，不抢结论区 */
.poster-btn {
  position: relative;
  flex: none;
  height: 64rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(129, 140, 248, 0.16);
  background: rgba(129, 140, 248, 0.14);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
  color: #C7CDFB;
}

/* 视觉 64rpx 的胶囊，可点区域补到 80rpx；与旁边的分享图标拉开间距防误触 */
.poster-btn::after {
  content: "";
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  top: -8rpx;
  bottom: -8rpx;
}

.poster-spark {
  font-size: 24rpx;
  line-height: 1;
  color: #C7CDFB;
}

/* 数据与备份：默认收起，只露一行状态 */
.settings {
  margin-top: 56rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--border-moon-subtle);
}

.settings-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
}

.settings-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.settings-title {
  font-size: 24rpx;
  color: var(--text-primary);
}

.settings-sub {
  font-size: 19rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.settings-toggle {
  flex: none;
  padding: 12rpx 0 12rpx 20rpx;
  font-size: 20rpx;
  color: var(--color-primary);
}

.settings-body {
  padding-top: 4rpx;
}

/* 云同步：折叠区内只留胶囊按钮 */
.sync-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 12rpx;
}

.sync-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.sync-title {
  font-size: 22rpx;
  color: var(--text-primary);
}

.sync-sub {
  font-size: 18rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.sync-ops {
  flex: none;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 自绘开关：原生 switch 缩到 0.8 后在深色底上开关态几乎看不出，
   这里用轨道 + 滑块 + 开启态发光表达状态，热区仍保持 80rpx 高 */
.sync-toggle-hit {
  flex: none;
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.sync-toggle {
  position: relative;
  width: 88rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: rgba(148, 163, 184, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.sync-toggle.is-on {
  background: rgba(129, 140, 248, 0.85);
  border-color: rgba(158, 168, 255, 0.9);
  box-shadow: 0 0 12rpx rgba(129, 140, 248, 0.45);
}

.sync-toggle-knob {
  position: absolute;
  left: 4rpx;
  top: 5rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F8FAFC;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.35);
  transition: transform 0.2s ease;
}

.sync-toggle.is-on .sync-toggle-knob {
  transform: translateX(38rpx);
}

.sync-btn {
  min-height: 80rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 26rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border-glow);
  font-size: 22rpx;
  color: var(--color-primary);
}

.sync-btn.is-busy {
  opacity: 0.5;
}

/* 关闭云备份但仍保留云端副本时的独立删除入口 */
.cloud-del {
  margin-top: 6rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 20rpx;
  color: var(--text-secondary);
  text-decoration: underline;
}

/* 清除数据入口：居中，红色链接标题 + 灰色说明行 */
.stats-page .danger-entry {
  margin-top: 26rpx;
  padding: 8rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-page .danger-entry-title {
  font-size: 26rpx;
  color: var(--color-danger-soft, #F87171);
  text-decoration: underline;
}

.stats-page .danger-entry-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

.poster-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 600px;
  height: 960px;
}

.share-canvas {
  position: fixed;
  left: -2200px;
  top: 0;
  width: 600px;
  height: 480px;
}
