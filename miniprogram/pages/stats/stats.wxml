<ambient />
<hero-backdrop />
<top-bar brand-only="{{true}}" style="display:block;width:100%;" />

<view class="page stats-page">
  <view class="stats-hero fade-up">
    <text class="eyebrow">REVIEW</text>
    <text class="title-xl">回顾</text>
    <text class="sub">只看数据，不做评价</text>
  </view>

  <block wx:if="{{!hasData}}">
    <empty-state
      title="还没有记录"
      desc="打一次卡，这里就会长出第一格。"
      actionText="去入睡"
      bind:action="goSleep"
    />
  </block>

  <block wx:else>
    <!-- 3 个核心指标：平均睡眠 / 平均入睡 / 平均起床 -->
    <view wx:if="{{metrics.length}}" class="metrics fade-up">
      <view
        wx:for="{{metrics}}"
        wx:key="key"
        class="metric {{metricKey === item.key ? 'is-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onMetricTap"
        aria-role="button"
        aria-label="{{item.label}} {{item.value}}"
      >
        <text class="metric-value">{{item.value}}</text>
        <text class="metric-key">{{item.label}}</text>
        <text wx:if="{{item.sub}}" class="metric-sub">{{item.sub}}</text>
      </view>
    </view>
    <view wx:else class="metrics-empty fade-up">
      <text class="metrics-empty-title">本周还没有完整记录</text>
      <text class="metrics-empty-sub">打一次卡，这里就会出现 3 个核心数字。</text>
    </view>

    <!-- 点指标展开的事实说明：3 行以内，口径与对比都在这里 -->
    <view wx:if="{{metricDetail}}" class="metric-detail fade-up">
      <view class="md-head">
        <text class="md-title">{{metricDetail.label}}</text>
        <text class="md-value">{{metricDetail.value}}</text>
      </view>
      <text wx:for="{{metricDetail.detail}}" wx:key="*this" class="md-line">{{item}}</text>
    </view>

    <view wx:if="{{metrics.length}}" class="week-line fade-up">
      <text>本周记录 {{weekCount}} 天</text>
      <text class="week-dot">·</text>
      <text>连续 {{streak}} 天</text>
    </view>

    <ad-slot wx:if="{{hasData}}" slot-name="stats" enabled="{{ads.stats.enabled}}" unit-id="{{ads.stats.unitId}}" type="{{ads.stats.type}}" />

    <!-- 打卡日历：当月可切月；3/6/12 个月改为横向滑动的紧凑月历 -->
    <view class="section fade-up">
      <view class="section-head">
        <text class="section-title">打卡日历</text>
        <!-- 周期选项：纯文字，无边框；当前项更深、更大、更粗 -->
        <view class="span-tabs">
          <text class="span-tab {{calendarSpan === 1 ? 'is-on' : ''}}" data-span="1" bindtap="onSpanTap">当月</text>
          <text class="span-tab {{calendarSpan === 3 ? 'is-on' : ''}}" data-span="3" bindtap="onSpanTap">3 个月</text>
          <text class="span-tab {{calendarSpan === 6 ? 'is-on' : ''}}" data-span="6" bindtap="onSpanTap">6 个月</text>
          <text class="span-tab {{calendarSpan === 12 ? 'is-on' : ''}}" data-span="12" bindtap="onSpanTap">1 年</text>
        </view>
      </view>

      <month-calendar
        wx:if="{{calendarSpan === 1}}"
        cells="{{calendarCells}}"
        title="{{calendarTitle}}"
        can-next="{{canNextMonth}}"
        selected-key="{{selectedKey}}"
        bind:daytap="onCalendarTap"
        bind:prev="onMonthPrev"
        bind:next="onMonthNext"
      />
      <calendar-strip
        wx:else
        months="{{calendarMonths}}"
        selected-key="{{selectedKey}}"
        bind:daytap="onStripTap"
      />

      <view class="cal-legend">
        <view class="cal-legend-item">
          <view class="cal-swatch lv-1"></view>
          <text>4h 内</text>
        </view>
        <view class="cal-legend-item">
          <view class="cal-swatch lv-2"></view>
          <text>4–6h</text>
        </view>
        <view class="cal-legend-item">
          <view class="cal-swatch lv-3"></view>
          <text>6–8h</text>
        </view>
        <view class="cal-legend-item">
          <view class="cal-swatch lv-4"></view>
          <text>8h 以上</text>
        </view>
        <view class="cal-legend-item">
          <view class="cal-swatch is-partial"></view>
          <text>仅入睡</text>
        </view>
      </view>

      <view wx:if="{{detail}}" class="day-detail">
        <view class="dd-head">
          <text class="dd-title">{{detail.title}}</text>
          <text class="dd-tag">{{detail.tag}}</text>
        </view>
        <text class="dd-main">{{detail.main}}</text>
        <text wx:if="{{detail.sub}}" class="dd-sub">{{detail.sub}}</text>
        <view
          wx:if="{{detail.canAdd}}"
          class="dd-action"
          data-day="{{detail.day}}"
          bindtap="onAddMissing"
          aria-role="button"
        >补记这一天的睡眠</view>
      </view>

      <view class="section-foot">
        <text class="heat-note">{{calendarNote}}</text>
        <view class="section-actions">
          <share-btn variant="icon" />
          <view class="poster-btn" bindtap="onMakePoster" aria-role="button" aria-label="生成近 30 天回顾海报">
            <text class="poster-spark">✦</text>
            <text>近 30 天回顾</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 低频操作下沉：默认只露一行状态，展开后才出现同步与删除 -->
  <view class="settings fade-up">
    <view class="settings-head" bindtap="onToggleSettings" aria-role="button" aria-label="数据与备份">
      <view class="settings-info">
        <text class="settings-title">数据与备份</text>
        <text class="settings-sub">{{syncText}}</text>
      </view>
      <text class="settings-toggle">{{settingsOpen ? '收起' : '展开'}}</text>
    </view>

    <view wx:if="{{settingsOpen}}" class="settings-body">
      <view class="sync-line">
        <view class="sync-info">
          <text class="sync-title">{{hasData ? '云备份（可选）' : '从云端恢复'}}</text>
          <text class="sync-sub">{{syncEnabled ? '仅上传睡眠时间，不含手机号与位置' : '默认只存本机；开启后可换机恢复'}}</text>
        </view>
        <view class="sync-ops">
          <view wx:if="{{syncEnabled}}" class="sync-btn {{syncBusy ? 'is-busy' : ''}}" bindtap="onSyncTap" aria-role="button">{{syncBusy ? '同步中…' : '同步'}}</view>
          <view
            class="sync-toggle-hit"
            bindtap="onSyncToggle"
            aria-role="switch"
            aria-checked="{{syncEnabled}}"
            aria-label="云备份"
          >
            <view class="sync-toggle {{syncEnabled ? 'is-on' : ''}}">
              <view class="sync-toggle-knob"></view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{hasCloudCopy && !syncEnabled}}" class="cloud-del" bindtap="eraseCloudOnly">删除云端副本（保留本机）</view>

      <view wx:if="{{hasData}}" class="danger-entry" bindtap="onClearData" aria-role="button">
        <text class="danger-entry-title">{{syncEnabled ? '清除数据（云端+本机）' : '清除本机睡眠数据'}}</text>
        <text class="danger-entry-hint">{{syncEnabled ? '云端和本机记录都会删除，且不可恢复' : '本机记录会删除，且不可恢复'}}</text>
      </view>
    </view>
  </view>

  <ad-slot slot-name="statsFooter" enabled="{{ads.statsFooter.enabled}}" unit-id="{{ads.statsFooter.unitId}}" type="{{ads.statsFooter.type}}" />

  <canvas canvas-id="poster" class="poster-canvas"></canvas>
  <canvas canvas-id="share-card" class="share-canvas"></canvas>

  <view class="safe-bottom"></view>
</view>

<view class="np-host"><now-playing /></view>

<custom-tab-bar />
