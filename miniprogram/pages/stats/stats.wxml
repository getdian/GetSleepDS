<ambient />
<top-bar title="统计" style="display:block;width:100%;" />

<view class="page stats-page">
  <view class="stats-hero fade-up">
    <text class="eyebrow">REVIEW</text>
    <text class="title-xl">回顾</text>
    <text class="sub">只看数据，不做评价</text>
  </view>

  <block wx:if="{{!hasData}}">
    <empty-state
      title="还没有记录"
      desc="打一次卡，这里就会长出第一格。"
      actionText="去入睡"
      bind:action="goHome"
    />
  </block>

  <block wx:else>
    <view class="metrics fade-up">
      <view class="metric">
        <text class="metric-value">{{avgBed}}</text>
        <text class="metric-key">本周平均入睡</text>
      </view>
      <view class="metric">
        <text class="metric-value">{{avgWake}}</text>
        <text class="metric-key">本周平均起床</text>
      </view>
      <view class="metric">
        <text class="metric-value is-small">{{avgDuration}}</text>
        <text class="metric-key">本周平均时长</text>
      </view>
    </view>

    <view class="week-line fade-up">
      <text>本周打卡 {{weekCount}} 天</text>
      <text class="week-dot">·</text>
      <text>连续 {{streak}} 天</text>
    </view>

    <view class="section fade-up">
      <view class="section-hero">
        <view class="section-head">
          <text class="section-title">打卡热力图</text>
          <text class="range-tag">近 140 天</text>
        </view>

        <heatmap
          cells="{{cells}}"
          colCount="{{colCount}}"
          months="{{months}}"
          bind:celltap="onHeatTap"
        />

        <view class="section-foot">
          <text class="heat-note">{{marked ? '共 ' + marked + ' 天完整记录' : '近 140 天还没有完整记录'}}</text>
          <view class="section-actions">
            <share-btn variant="icon" />
            <view class="poster-btn" bindtap="onMakePoster">
              <text class="poster-spark">✦</text>
              <text>生成月度海报</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{factState !== 'off' && factState !== 'idle'}}" class="section fade-up">
      <view class="section-head">
        <text class="section-title">本周事实回顾</text>
        <text class="section-tag">只陈述数据</text>
      </view>

      <block wx:if="{{factState === 'loading'}}">
        <text class="fact-muted">正在整理本周数据…</text>
      </block>

      <block wx:elif="{{factState === 'ok'}}">
        <text class="fact-text">{{fact}}</text>
      </block>

      <block wx:elif="{{factState === 'insufficient'}}">
        <text class="fact-muted">本周记录满 3 天后可查看回顾</text>
      </block>

      <block wx:elif="{{factState === 'unavailable'}}">
        <view class="fact-error">
          <text class="fact-muted">回顾暂时不可用</text>
          <text class="fact-retry" bindtap="onFactRetry">重试</text>
        </view>
      </block>

      <block wx:elif="{{factState === 'error'}}">
        <view class="fact-error">
          <text class="fact-muted">回顾暂时不可用</text>
          <text class="fact-retry" bindtap="onFactRetry">重试</text>
        </view>
      </block>
    </view>
  </block>

  <ad-slot wx:if="{{hasData}}" slot-name="stats" enabled="{{ads.stats.enabled}}" unit-id="{{ads.stats.unitId}}" type="{{ads.stats.type}}" />

  <view class="sync-line fade-up">
    <view class="sync-info">
      <text class="sync-title">{{hasData ? '云备份（可选）' : '从云端恢复'}}</text>
      <text class="sync-sub">{{syncText}}</text>
    </view>
    <view class="sync-ops">
      <view wx:if="{{syncEnabled}}" class="sync-btn {{syncBusy ? 'is-busy' : ''}}" bindtap="onSyncTap">{{syncBusy ? '同步中…' : '同步'}}</view>
      <switch class="sync-switch" checked="{{syncEnabled}}" color="#818CF8" bindchange="onSyncSwitch" />
    </view>
  </view>

  <view wx:if="{{hasCloudCopy && !syncEnabled}}" class="cloud-del" bindtap="eraseCloudOnly">删除云端副本（保留本机）</view>

  <view wx:if="{{hasData}}" class="danger-entry fade-up" bindtap="onClearData">
    <text class="danger-entry-title">{{syncEnabled ? '清除数据（云端+本机）' : '清除本机睡眠数据'}}</text>
    <text class="danger-entry-hint">默认只存本机；开启云备份后以匿名标识保存，换机可恢复</text>
  </view>

  <ad-slot slot-name="statsFooter" enabled="{{ads.statsFooter.enabled}}" unit-id="{{ads.statsFooter.unitId}}" type="{{ads.statsFooter.type}}" />

  <canvas canvas-id="poster" class="poster-canvas"></canvas>
  <canvas canvas-id="share-card" class="share-canvas"></canvas>

  <view class="safe-bottom"></view>
</view>

<now-playing />
