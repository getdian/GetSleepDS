.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: var(--z-tabbar, 90);
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  background: var(--color-tabbar-surface, #0A0E1A);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.28);
  transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0s;
}

.tabbar.is-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(28rpx);
  transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0.16s;
}

.tab-item {
  position: relative;
  flex: 1;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7C8699;
  transition: color 0.18s ease;
}

.tab-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
}

/* 中间入睡：与外层同色的扁平圆，只留极淡月晕，不做立体渐变 */
.tab-center-bg {
  position: absolute;
  left: 50%;
  top: -34rpx;
  width: 158rpx;
  height: 158rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  background: var(--color-tabbar-surface, #0A0E1A);
  box-shadow: 0 0 34rpx rgba(99, 102, 241, 0.14);
  z-index: 0;
}

.tab-content-center {
  transform: translateY(-10rpx);
}

.tab-label {
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.5rpx;
  color: inherit;
  white-space: nowrap;
  transition: color 0.18s ease, font-weight 0.18s ease;
}

/* 当前页：图标与文字提亮，文字略加粗；非当前页保持低对比 */
.tab-item.is-on {
  color: #AAB7FF;
}

.tab-item.is-on .tab-label {
  color: #E9EEFF;
  font-weight: 500;
}

.tab-item.is-center {
  color: #AAB5CC;
}

.tab-item.is-center.is-on {
  color: #F0F3FF;
}

.tab-item.is-center.is-on .tab-label {
  color: #F5F7FF;
}

/* 计算器：细线时钟 */
.tab-clock {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 2.5rpx solid currentColor;
  border-radius: 50%;
}

.tab-hand {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform-origin: 50% 100%;
}

.tab-hand-h {
  height: 8rpx;
  margin: -8rpx 0 0 -1rpx;
  transform: rotate(90deg);
}

.tab-hand-m {
  height: 11rpx;
  margin: -11rpx 0 0 -1rpx;
}

/* 入睡：实心月牙，用圆形缺口切出，比字体符号更可控 */
.tab-moon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: currentColor;
  overflow: hidden;
}

.tab-moon::after {
  content: "";
  position: absolute;
  left: -9rpx;
  top: -5rpx;
  width: 35rpx;
  height: 35rpx;
  border-radius: 50%;
  background: #0A0E1A;
}

/* 统计：四根细柱 */
.tab-stats {
  height: 34rpx;
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
}

.tab-bar {
  width: 5rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.b1 { height: 12rpx; }
.b2 { height: 20rpx; }
.b3 { height: 27rpx; }
.b4 { height: 34rpx; }
